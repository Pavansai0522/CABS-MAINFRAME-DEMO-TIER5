//CABC0100 JOB (CABS,CTC),'CARRIER TRAFFIC CONSOLIDATION',
//             CLASS=B,MSGCLASS=X,MSGLEVEL=(1,1),
//             NOTIFY=&SYSUID,REGION=0M,TIME=1440
//*****************************************************************
//* CABC0100 - CARRIER TRAFFIC CONSOLIDATION - CENTRE ATL         *
//*                                                               *
//* RUNS CABCTC01 OVER THE EDITED USAGE FILE AND THEN CABCTC02    *
//* OVER THE SUMMARY IT PRODUCED.  BOTH STEPS ARE SUBMITTED BY    *
//* THE REGIONAL SCHEDULER AFTER THE NIGHTLY EDIT COMPLETES.      *
//*                                                               *
//* THE LOAD LIBRARY IS THE CENTRE LIBRARY, NOT THE CENTRAL ONE.  *
//* EACH CENTRE PROMOTES ITS OWN COPY.                            *
//*****************************************************************
//STEP010  EXEC PGM=SORT,REGION=4M
//SORTIN   DD DSN=TELCABS.ATL.CABS.USAGE.EDIT(0),DISP=SHR
//SORTOUT  DD DSN=TELCABS.ATL.CABS.USAGE.SEQ(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(CYL,(40,20),RLSE),
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//SORTWK01 DD UNIT=SYSDA,SPACE=(CYL,(40,20))
//SORTWK02 DD UNIT=SYSDA,SPACE=(CYL,(40,20))
//SYSOUT   DD SYSOUT=*
//SYSIN    DD DSN=TELCABS.CABS.CTLCARDS(CABSRT21),DISP=SHR
//*
//STEP020  EXEC PGM=CABCTC01,REGION=8M,PARM='&CYCLE'
//STEPLIB  DD DSN=TELCABS.ATL.CABS.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.CABS.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//         DD DSN=SYS1.COB2LIB,DISP=SHR
//USGIN    DD DSN=TELCABS.ATL.CABS.USAGE.SEQ(0),DISP=SHR
//CARRMST  DD DSN=TELCABS.CABS.CARRIER,DISP=SHR
//SUMOUT   DD DSN=TELCABS.ATL.CABS.CTCSUMM(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(CYL,(20,10),RLSE),
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//SUSOUT   DD DSN=TELCABS.ATL.CABS.CTC.SUSP(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(30,30),RLSE),
//             DCB=(RECFM=FB,LRECL=300,BLKSIZE=0)
//CTLOUT   DD DSN=TELCABS.ATL.CABS.CONTROL(+1),
//             DISP=(MOD,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(5,5),RLSE),
//             DCB=(RECFM=FB,LRECL=180,BLKSIZE=0)
//RPTOUT   DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//SYSIN    DD *
RN%%RUNID  %%CYCLDT%%BILLPRATL CABC0100STEP020YY
/*
//*
//STEP030  EXEC PGM=CABCTC02,REGION=8M,PARM='&CYCLE'
//STEPLIB  DD DSN=TELCABS.ATL.CABS.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.CABS.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//         DD DSN=SYS1.COB2LIB,DISP=SHR
//SUMIN    DD DSN=TELCABS.ATL.CABS.CTCSUMM(0),DISP=SHR
//RATIN    DD DSN=TELCABS.CABS.RATSUMM(0),DISP=SHR
//RTBLIN   DD DSN=TELCABS.CABS.RATETBL(0),DISP=SHR
//RECOUT   DD DSN=TELCABS.ATL.CABS.CTCRECN(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(CYL,(10,5),RLSE),
//             DCB=(RECFM=FB,LRECL=250,BLKSIZE=0)
//SUSOUT   DD DSN=TELCABS.ATL.CABS.CTC.SUSP(+1),
//             DISP=(MOD,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(30,30),RLSE),
//             DCB=(RECFM=FB,LRECL=300,BLKSIZE=0)
//CTLOUT   DD DSN=TELCABS.ATL.CABS.CONTROL(+1),
//             DISP=(MOD,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(5,5),RLSE),
//             DCB=(RECFM=FB,LRECL=180,BLKSIZE=0)
//RPTOUT   DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//SYSIN    DD *
RN%%RUNID  %%CYCLDT%%BILLPRATL CABC0100STEP030YN
/*
//
