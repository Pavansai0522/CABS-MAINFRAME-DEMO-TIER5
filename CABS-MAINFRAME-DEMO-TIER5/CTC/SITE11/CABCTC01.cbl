           05  WS-EX-BAD-TYPE              PIC S9(07) COMP-3 VALUE 0.
           05  WS-EX-OVER-THRESHOLD        PIC S9(07) COMP-3 VALUE 0.
           05  WS-EX-INACTIVE-CARRIER      PIC S9(07) COMP-3 VALUE 0.
           05  WS-EX-ZERO-MINUTES          PIC S9(07) COMP-3 VALUE 0.
       01  WS-REPORT-WORK.
           05  WS-RPT-PAGE-NBR             PIC S9(03) COMP-3 VALUE 0.
           05  WS-RPT-LINE-NBR             PIC S9(03) COMP-3 VALUE 0.
           05  WS-RPT-MAX-LINES            PIC S9(03) COMP-3 VALUE 55.
           05  WS-RPT-TITLE1               PIC X(60) VALUE
               'CABCTC01 - CARRIER TRAFFIC CONSOLIDATION SUMMARY'.
           05  WS-RPT-TITLE2               PIC X(60) VALUE
               'TELCABS WHOLESALE ACCESS BILLING - REGIONAL CENTRE'.
           05  WS-RPT-MOU-EDIT             PIC Z,ZZZ,ZZZ,ZZ9.99.
           05  WS-RPT-CNT-EDIT             PIC ZZZ,ZZZ,ZZ9.
       01  WS-DISPLAY-WORK.
           05  WS-DW-OCN                   PIC X(04) VALUE SPACES.
