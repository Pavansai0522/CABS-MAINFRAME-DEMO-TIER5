           05  WS-EA-MOU-INTER             PIC S9(13)V9(05) COMP-3
                                                            VALUE 0.
           05  WS-EA-MOU-INTRA             PIC S9(13)V9(05) COMP-3
                                                            VALUE 0.
           05  WS-EA-MOU-LOCAL             PIC S9(13)V9(05) COMP-3
                                                            VALUE 0.
           05  WS-EA-MOU-TOTAL             PIC S9(13)V9(05) COMP-3
                                                            VALUE 0.
           05  WS-EA-HASH-SEQ              PIC S9(17) COMP-3 VALUE 0.
           05  WS-EA-HASH-OCN              PIC S9(15) COMP-3 VALUE 0.
       01  WS-BAN-ACCUM.
           05  WS-BA-DETAIL-CNT            PIC S9(09) COMP-3 VALUE 0.
