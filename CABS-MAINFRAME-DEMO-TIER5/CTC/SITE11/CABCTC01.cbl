           05  WS-DW-ELEM                  PIC X(06) VALUE SPACES.
       01  WS-ABEND-WORK.
           05  WS-AB-PGM                   PIC X(08).
           05  WS-AB-PARA                  PIC X(30).
           05  WS-AB-REASON                PIC X(60).
           05  WS-AB-USER-CODE             PIC 9(04) VALUE 9903.
       01  WS-EXT-CALL-RC.
           05  WS-RC-DTCNV                 PIC 9(04) VALUE 0.
           05  WS-RC-HASH                  PIC 9(04) VALUE 0.
           05  WS-RC-PARMR                 PIC 9(04) VALUE 0.
           05  WS-RC-ABEND                 PIC 9(04) VALUE 0.
       01  WS-CYCLE-VIEW.
           05  WS-CV-CYCLE-YYDDD           PIC 9(05) VALUE 0.
           05  WS-CV-CYCLE-CCYYDDD         PIC 9(07) VALUE 0.
       PROCEDURE DIVISION.
      * P0000-MAINLINE - MANDATORY CABS BATCH SHAPE.  ONE PASS OF
      * P2000-PROCESS CONSUMES EXACTLY ONE EDITED USAGE RECORD.
       P0000-MAINLINE.
           PERFORM P1000-INIT THRU P1000-EXIT.
           PERFORM P2000-PROCESS THRU P2000-EXIT UNTIL WS-EOF.
           PERFORM P8000-CONTROL THRU P8000-EXIT.
           PERFORM P9000-TERM THRU P9000-EXIT.
           STOP RUN.
      * S100-INITIALISATION SECTION
       S100-INITIALISATION SECTION.
       P1000-INIT.
           PERFORM P1100-OPEN-FILES THRU P1100-EXIT.
           PERFORM P1200-READ-PARM THRU P1200-EXIT.
           PERFORM P1300-LOAD-CARRIER-TABLE THRU P1300-EXIT.
           PERFORM P1400-PRIME-READ THRU P1400-EXIT.
       P1000-EXIT.
           EXIT.
       P1100-OPEN-FILES.
           OPEN INPUT USGIN.
           IF WS-FS-INPUT NOT = '00'
               MOVE 'P1100-OPEN-FILES' TO WS-AB-PARA
               MOVE 'USGIN OPEN FAILED - FILE STATUS BAD' TO
                   WS-AB-REASON
               PERFORM P9900-FATAL-OPEN THRU P9900-EXIT.
           OPEN INPUT CARRMST.
           IF WS-FS-TABLE NOT = '00'
               MOVE 'P1100-OPEN-FILES' TO WS-AB-PARA
               MOVE 'CARRMST OPEN FAILED - VSAM STATUS BAD' TO
                   WS-AB-REASON
               PERFORM P9900-FATAL-OPEN THRU P9900-EXIT.
           OPEN OUTPUT SUMOUT.
           IF WS-FS-OUTPUT NOT = '00'
               MOVE 'P1100-OPEN-FILES' TO WS-AB-PARA
               MOVE 'SUMOUT OPEN FAILED - FILE STATUS BAD' TO
                   WS-AB-REASON
               PERFORM P9900-FATAL-OPEN THRU P9900-EXIT.
           OPEN OUTPUT SUSOUT.
           IF WS-FS-SUSPENSE NOT = '00'
               MOVE 'P1100-OPEN-FILES' TO WS-AB-PARA
               MOVE 'SUSOUT OPEN FAILED - FILE STATUS BAD' TO
                   WS-AB-REASON
               PERFORM P9900-FATAL-OPEN THRU P9900-EXIT.
           OPEN OUTPUT CTLOUT.
           IF WS-FS-CONTROL NOT = '00'
               MOVE 'P1100-OPEN-FILES' TO WS-AB-PARA
               MOVE 'CTLOUT OPEN FAILED - FILE STATUS BAD' TO
                   WS-AB-REASON
               PERFORM P9900-FATAL-OPEN THRU P9900-EXIT.
           OPEN OUTPUT RPTOUT.
           IF WS-FS-OUTPUT NOT = '00'
               MOVE 'P1100-OPEN-FILES' TO WS-AB-PARA
               MOVE 'RPTOUT OPEN FAILED - FILE STATUS BAD' TO
                   WS-AB-REASON
               PERFORM P9900-FATAL-OPEN THRU P9900-EXIT.
       P1100-EXIT.
           EXIT.
      * P1200-READ-PARM - THE CYCLE DATE ARRIVES AS TWO DIGITS AND
      * IS PIVOTED ON DW-PIVOT-YY BEFORE CABDTCNV IS CALLED.
       P1200-READ-PARM.
           MOVE SPACES TO WS-PARM-CARD.
           ACCEPT WS-PARM-CARD FROM SYSIN.
           CALL 'CABPARMR' USING WS-PARM-CARD WS-RC-PARMR.
           MOVE PC1-CYCLE-YYDDD TO WS-CV-CYCLE-YYDDD.
           MOVE PC1-CYCLE-YYDDD TO DW-CUR-YY DW-CUR-DDD.
           COMPUTE WS-CV-CYCLE-CCYYDDD = 19000000 + PC1-CYCLE-YYDDD.
           IF DW-CUR-YY < DW-PIVOT-YY
               COMPUTE WS-CV-CYCLE-CCYYDDD =
                   20000000 + PC1-CYCLE-YYDDD.
           CALL 'CABDTCNV' USING WS-CV-CYCLE-CCYYDDD DW-GREG-DATE
               WS-RC-DTCNV.
           MOVE 0 TO WS-EX-UNKNOWN-OCN WS-EX-BAD-DATE.
           MOVE 0 TO WS-EX-BAD-TYPE WS-EX-OVER-THRESHOLD.
           MOVE 0 TO WS-EX-INACTIVE-CARRIER WS-EX-ZERO-MINUTES.
           MOVE 0 TO WS-BA-DETAIL-CNT WS-BA-MOU-TOTAL WS-BA-ELEM-CNT.
           MOVE 0 TO WS-OA-DETAIL-CNT WS-OA-MOU-TOTAL WS-OA-BAN-CNT.
           MOVE SPACES TO WS-PREV-KEY.
       P1200-EXIT.
           EXIT.
      * P1300-LOAD-CARRIER-TABLE - ONE BROWSE OF THE KSDS FROM THE
      * LOWEST KEY.  A CARRIER THAT DOES NOT FIT IS NOT REPORTED
      * HERE - THE DETAIL RECORDS THAT REFERENCE IT SUSPEND INSTEAD.
       P1300-LOAD-CARRIER-TABLE.
           MOVE LOW-VALUES TO CR-KEY.
           START CARRMST KEY NOT LESS THAN CR-KEY
               INVALID KEY MOVE 'Y' TO WS-CT-FULL-SW.
           IF NOT WS-CT-TABLE-FULL
               PERFORM P1320-READ-NEXT-CARRIER THRU P1320-EXIT
               PERFORM P1310-STORE-CARRIER-ROW THRU P1310-EXIT
                   UNTIL WS-CT-TABLE-FULL.
       P1300-EXIT.
           EXIT.
       P1310-STORE-CARRIER-ROW.
           IF WS-CT-ENTRY-CNT NOT < WS-MAX-CARRIERS
               MOVE 'Y' TO WS-CT-FULL-SW
           ELSE
               ADD 1 TO WS-CT-ENTRY-CNT
               SET WS-CX TO WS-CT-ENTRY-CNT
               MOVE CR-OCN TO WS-CT-OCN (WS-CX)
               MOVE CR-NAME TO WS-CT-NAME (WS-CX)
               MOVE CR-TYPE TO WS-CT-TYPE (WS-CX)
               MOVE CR-ACTIVE-SW TO WS-CT-ACTIVE-SW (WS-CX)
               MOVE CR-DEFAULT-PIU TO WS-CT-DEFAULT-PIU (WS-CX)
               MOVE CR-RECIP-COMP-ELIG TO WS-CT-RECIP-ELIG (WS-CX)
               MOVE CR-EFF-YYDDD TO WS-CT-EFF-YYDDD (WS-CX)
               MOVE CR-EXP-YYDDD TO WS-CT-EXP-YYDDD (WS-CX)
               PERFORM P1320-READ-NEXT-CARRIER THRU P1320-EXIT.
       P1310-EXIT.
           EXIT.
       P1320-READ-NEXT-CARRIER.
           READ CARRMST NEXT RECORD
               AT END MOVE 'Y' TO WS-CT-FULL-SW.
       P1320-EXIT.
           EXIT.
       P1400-PRIME-READ.
           PERFORM P2100-READ-USAGE THRU P2100-EXIT.
           IF NOT WS-EOF
               MOVE CD-OCN TO WS-PK-OCN
               MOVE CD-BAN TO WS-PK-BAN
               MOVE CD-RATE-ELEM TO WS-PK-ELEM.
       P1400-EXIT.
           EXIT.
       P9900-FATAL-OPEN.
           MOVE WS-PGM-NAME TO WS-AB-PGM.
           CALL 'CABABEND' USING WS-AB-PGM WS-AB-PARA WS-AB-REASON
               WS-AB-USER-CODE WS-RC-ABEND.
       P9900-EXIT.
           EXIT.
      * S200-CONSOLIDATION SECTION - ONE PASS PER DETAIL RECORD.
       S200-CONSOLIDATION SECTION.
       P2000-PROCESS.
           ADD 1 TO WS-READ-CNT.
           MOVE CD-OCN TO WS-CK-OCN.
           MOVE CD-BAN TO WS-CK-BAN.
           MOVE CD-RATE-ELEM TO WS-CK-ELEM.
           PERFORM P2500-CHECK-CONTROL-BREAK THRU P2500-EXIT.
           IF WS-BREAK-TAKEN
               PERFORM P3000-WRITE-SUMMARY THRU P3000-EXIT.
           PERFORM P2200-VALIDATE-USAGE THRU P2200-EXIT.
           IF WS-VAL-OK
               PERFORM P2300-LOOKUP-CARRIER THRU P2300-EXIT.
           IF WS-VAL-OK AND WS-CARRIER-FOUND
               PERFORM P2600-ACCUMULATE THRU P2600-EXIT
           ELSE
               PERFORM P2800-WRITE-SUSPENSE THRU P2800-EXIT.
           PERFORM P2100-READ-USAGE THRU P2100-EXIT.
       P2000-EXIT.
           EXIT.
       P2100-READ-USAGE.
           IF NOT WS-EOF
               READ USGIN
                   AT END MOVE 'Y' TO WS-EOF-SW.
       P2100-EXIT.
           EXIT.
      * P2200-VALIDATE-USAGE - EDIT THE DETAIL BEFORE IT IS ALLOWED
      * INTO A BUCKET.  A FAILURE HERE SUSPENDS THE RECORD, IT DOES
      * NOT STOP THE STEP.
       P2200-VALIDATE-USAGE.
           MOVE 'Y' TO WS-VAL-SW.
           MOVE SPACES TO WS-VAL-REASON.
           PERFORM P2210-VALIDATE-KEY-FIELDS THRU P2210-EXIT.
           IF WS-VAL-OK
               PERFORM P2220-VALIDATE-DATE-FIELDS THRU P2220-EXIT.
           IF WS-VAL-OK
               PERFORM P2230-VALIDATE-MINUTES THRU P2230-EXIT.
       P2200-EXIT.
           EXIT.
       P2210-VALIDATE-KEY-FIELDS.
           IF CD-OCN = SPACES
               MOVE 'N' TO WS-VAL-SW
               MOVE EC-OCN-UNKNOWN TO WS-VAL-REASON
               ADD 1 TO WS-EX-UNKNOWN-OCN.
           IF WS-VAL-OK AND CD-BAN = SPACES
               MOVE 'N' TO WS-VAL-SW
               MOVE EC-BAN-UNKNOWN TO WS-VAL-REASON.
           IF WS-VAL-OK AND NOT CD-VALID-TYPE
               MOVE 'N' TO WS-VAL-SW
               MOVE EC-DUP-SEQ TO WS-VAL-REASON
               ADD 1 TO WS-EX-BAD-TYPE.
       P2210-EXIT.
           EXIT.
      * P2220-VALIDATE-DATE-FIELDS - THE CONNECT DATE MUST FALL ON
      * OR AFTER THE TARIFF EFFECTIVE DATE HELD IN THE SITE
      * CONSTANTS AND MUST NOT BE LATER THAN THE CYCLE DATE.
       P2220-VALIDATE-DATE-FIELDS.
           IF CD-CONN-YYDDD < WS-TARIFF-EFF-YYDDD
               MOVE 'N' TO WS-VAL-SW
               MOVE EC-DATE-INVALID TO WS-VAL-REASON
               ADD 1 TO WS-EX-BAD-DATE.
           IF WS-VAL-OK AND CD-CONN-YYDDD > WS-CV-CYCLE-YYDDD
               MOVE 'N' TO WS-VAL-SW
               MOVE EC-DATE-INVALID TO WS-VAL-REASON
               ADD 1 TO WS-EX-BAD-DATE.
           IF WS-VAL-OK AND CD-DISC-YYDDD < CD-CONN-YYDDD
               MOVE 'N' TO WS-VAL-SW
               MOVE EC-DATE-INVALID TO WS-VAL-REASON
               ADD 1 TO WS-EX-BAD-DATE.
       P2220-EXIT.
           EXIT.
      * P2230-VALIDATE-MINUTES - A SINGLE DETAIL RECORD CARRYING
      * MORE THAN THE SITE THRESHOLD IS ALWAYS A MEDIATION FAULT.
       P2230-VALIDATE-MINUTES.
           IF CD-VOICE-MOU
               IF CD-VC-CHG-MIN > WS-MOU-THRESHOLD
                   MOVE 'N' TO WS-VAL-SW
                   MOVE EC-MIN-NEGATIVE TO WS-VAL-REASON
                   ADD 1 TO WS-EX-OVER-THRESHOLD.
           IF WS-VAL-OK AND CD-VOICE-MOU
               IF CD-VC-CHG-MIN NOT > 0
                   ADD 1 TO WS-EX-ZERO-MINUTES.
       P2230-EXIT.
           EXIT.
      * P2300-LOOKUP-CARRIER - SUBSCRIPTED WALK OF THE IN-CORE
      * CARRIER TABLE.  AN INACTIVE CARRIER IS STILL A HIT, BUT IT
      * IS COUNTED SEPARATELY FOR THE AUDIT REPORT.
       P2300-LOOKUP-CARRIER.
           MOVE 'N' TO WS-CARRIER-FOUND-SW.
           MOVE SPACES TO WS-FOUND-TYPE WS-FOUND-ACTIVE.
           IF WS-CT-ENTRY-CNT > 0
               PERFORM P2310-COMPARE-CARRIER THRU P2310-EXIT
                   VARYING WS-CARRIER-SUB FROM 1 BY 1
                   UNTIL WS-CARRIER-SUB > WS-CT-ENTRY-CNT
                   OR WS-CARRIER-FOUND.
           IF WS-CARRIER-NOT-FOUND
               MOVE EC-OCN-UNKNOWN TO WS-VAL-REASON
               ADD 1 TO WS-EX-UNKNOWN-OCN.
           IF WS-CARRIER-FOUND AND WS-FOUND-ACTIVE NOT = 'Y'
               ADD 1 TO WS-EX-INACTIVE-CARRIER.
       P2300-EXIT.
           EXIT.
       P2310-COMPARE-CARRIER.
           SET WS-CX TO WS-CARRIER-SUB.
           IF WS-CT-OCN (WS-CX) = CD-OCN
               MOVE 'Y' TO WS-CARRIER-FOUND-SW
               MOVE WS-CT-TYPE (WS-CX) TO WS-FOUND-TYPE
               MOVE WS-CT-ACTIVE-SW (WS-CX) TO WS-FOUND-ACTIVE
               MOVE WS-CT-DEFAULT-PIU (WS-CX) TO WS-FOUND-PIU.
       P2310-EXIT.
           EXIT.
      * P2500-CHECK-CONTROL-BREAK - THREE LEVELS.  THE HIGHEST
      * LEVEL THAT CHANGED SETS WS-BREAK-LEVEL.
       P2500-CHECK-CONTROL-BREAK.
           MOVE 'N' TO WS-BREAK-SW.
           MOVE 0 TO WS-BREAK-LEVEL.
           IF WS-CK-OCN NOT = WS-PK-OCN
               MOVE 'Y' TO WS-BREAK-SW
               MOVE 3 TO WS-BREAK-LEVEL
           ELSE
               IF WS-CK-BAN NOT = WS-PK-BAN
                   MOVE 'Y' TO WS-BREAK-SW
                   MOVE 2 TO WS-BREAK-LEVEL
               ELSE
                   IF WS-CK-ELEM NOT = WS-PK-ELEM
                       MOVE 'Y' TO WS-BREAK-SW
                       MOVE 1 TO WS-BREAK-LEVEL.
           IF WS-FIRST-TIME
               MOVE 'N' TO WS-FIRST-TIME-SW
               MOVE 'N' TO WS-BREAK-SW
               MOVE 0 TO WS-BREAK-LEVEL.
       P2500-EXIT.
           EXIT.
      * P2600-ACCUMULATE - THE MINUTES GO INTO THE JURISDICTION
      * BUCKET INDICATED BY CD-JURIS-CD.  AN INDETERMINATE RECORD
      * IS CARRIED IN THE INTRASTATE BUCKET AGAINST THE SITE
      * DEFAULT STATE, WHICH IS WHAT THE 1995 SPLIT AGREED.
       P2600-ACCUMULATE.
           ADD 1 TO WS-EA-DETAIL-CNT.
           ADD 1 TO WS-BA-DETAIL-CNT.
           ADD 1 TO WS-OA-DETAIL-CNT.
           IF CD-INTERSTATE
               PERFORM P2610-ACCUM-INTERSTATE THRU P2610-EXIT
           ELSE
               IF CD-INTRASTATE
                   PERFORM P2620-ACCUM-INTRASTATE THRU P2620-EXIT
               ELSE
                   IF CD-LOCAL
                       PERFORM P2630-ACCUM-LOCAL THRU P2630-EXIT
                   ELSE
                       PERFORM P2640-ACCUM-INDETERMINATE THRU
                           P2640-EXIT.
           ADD CD-SEQ-NBR TO WS-EA-HASH-SEQ.
           CALL 'CABHASH' USING CD-OCN WS-EA-HASH-OCN.
           ADD 1 TO WS-SUMM-CNT.
       P2600-EXIT.
           EXIT.
       P2610-ACCUM-INTERSTATE.
           IF CD-VOICE-MOU
               ADD CD-VC-CHG-MIN TO WS-EA-MOU-INTER
               ADD CD-VC-CHG-MIN TO WS-EA-MOU-TOTAL
               ADD CD-VC-CHG-MIN TO WS-BA-MOU-TOTAL
               ADD CD-VC-CHG-MIN TO WS-OA-MOU-TOTAL.
       P2610-EXIT.
           EXIT.
       P2620-ACCUM-INTRASTATE.
           IF CD-VOICE-MOU
               ADD CD-VC-CHG-MIN TO WS-EA-MOU-INTRA
               ADD CD-VC-CHG-MIN TO WS-EA-MOU-TOTAL
               ADD CD-VC-CHG-MIN TO WS-BA-MOU-TOTAL
               ADD CD-VC-CHG-MIN TO WS-OA-MOU-TOTAL.
       P2620-EXIT.
           EXIT.
       P2630-ACCUM-LOCAL.
           IF CD-VOICE-MOU
               ADD CD-VC-CHG-MIN TO WS-EA-MOU-LOCAL
               ADD CD-VC-CHG-MIN TO WS-EA-MOU-TOTAL
               ADD CD-VC-CHG-MIN TO WS-BA-MOU-TOTAL
               ADD CD-VC-CHG-MIN TO WS-OA-MOU-TOTAL.
       P2630-EXIT.
           EXIT.
      * P2640-ACCUM-INDETERMINATE - COUNTED AS SUSPECT SO THE
      * FACTOR STUDY CAN SEE HOW MUCH TRAFFIC NEVER GOT A
      * JURISDICTION, THEN SPLIT ON THE CARRIER PERCENT INTERSTATE
      * USE.  THE SPLIT LEAVES FRACTIONS OF A MINUTE IN BOTH
      * BUCKETS - THAT IS EXPECTED AND MUST NOT BE CLEARED HERE.
       P2640-ACCUM-INDETERMINATE.
           ADD 1 TO WS-EA-SUSPECT-CNT.
           IF CD-VOICE-MOU
               PERFORM P2645-SPLIT-ON-PIU THRU P2645-EXIT.
       P2640-EXIT.
           EXIT.
       P2645-SPLIT-ON-PIU.
           COMPUTE WS-RW-CONV-MINUTES =
               CD-VC-CHG-MIN * WS-FOUND-PIU / 100.
           ADD WS-RW-CONV-MINUTES TO WS-EA-MOU-INTER.
           COMPUTE WS-RW-CONV-MINUTES =
               CD-VC-CHG-MIN - WS-RW-CONV-MINUTES.
           ADD WS-RW-CONV-MINUTES TO WS-EA-MOU-INTRA.
           ADD CD-VC-CHG-MIN TO WS-EA-MOU-TOTAL.
           ADD CD-VC-CHG-MIN TO WS-BA-MOU-TOTAL.
           ADD CD-VC-CHG-MIN TO WS-OA-MOU-TOTAL.
       P2645-EXIT.
           EXIT.
      * P2800-WRITE-SUSPENSE - THE WHOLE 200-BYTE DETAIL IS CARRIED
      * ON THE SUSPENSE RECORD SO THE RECYCLE JOB CAN REPRESENT IT
      * WITHOUT GOING BACK TO THE MEDIATION FILE.
       P2800-WRITE-SUSPENSE.
           MOVE SPACES TO CABS-SUSPENSE-RECORD.
           MOVE WS-VAL-REASON TO SU-ERR-CODE.
           MOVE 'E' TO SU-ERR-SEVERITY.
           MOVE WS-PGM-NAME TO SU-DETECT-PGM.
           MOVE 'P2800-WRITE-SUSPENSE' TO SU-DETECT-PARA.
           MOVE PC1-RUN-ID TO SU-RUN-ID.
           MOVE CABS-CDR-RECORD TO SU-ORIG-RECORD.
           MOVE CABS-SUSPENSE-RECORD TO CABS-SUSOUT-RECORD.
           WRITE CABS-SUSOUT-RECORD.
           ADD 1 TO WS-REJECT-CNT.
       P2800-EXIT.
           EXIT.
      * S300-SUMMARY-OUTPUT SECTION - CALLED ON EVERY BREAK AND
      * ONCE MORE AT END OF FILE.
       S300-SUMMARY-OUTPUT SECTION.
       P3000-WRITE-SUMMARY.
           IF WS-EA-DETAIL-CNT > 0
               PERFORM P3100-APPLY-ROUNDING THRU P3100-EXIT
               PERFORM P3200-BUILD-SUMMARY-REC THRU P3200-EXIT
               WRITE CABS-CTCS-RECORD
               ADD 1 TO WS-WRITE-CNT
               PERFORM P3400-PRINT-SUMMARY-LINE THRU P3400-EXIT
               ADD 1 TO WS-BA-ELEM-CNT.
           IF WS-BREAK-LEVEL > 1
               MOVE 0 TO WS-BA-DETAIL-CNT
               MOVE 0 TO WS-BA-MOU-TOTAL
               MOVE 0 TO WS-BA-ELEM-CNT
               ADD 1 TO WS-OA-BAN-CNT.
           IF WS-BREAK-LEVEL > 2
               MOVE 0 TO WS-OA-DETAIL-CNT
               MOVE 0 TO WS-OA-MOU-TOTAL
               MOVE 0 TO WS-OA-BAN-CNT.
           PERFORM P3300-RESET-ACCUMULATORS THRU P3300-EXIT.
           MOVE WS-CK-OCN TO WS-PK-OCN.
           MOVE WS-CK-BAN TO WS-PK-BAN.
           MOVE WS-CK-ELEM TO WS-PK-ELEM.
       P3000-EXIT.
           EXIT.
      * P3100-APPLY-ROUNDING - THE ELEMENT TOTAL IS CARRIED AT FIVE
      * DECIMALS WHILE IT ACCUMULATES BECAUSE THE INDETERMINATE
      * SPLIT LEAVES FRACTIONS OF A MINUTE IN THE BUCKETS.  THIS
      * CENTRE PRESENTS THE WHOLE PENNY OF MINUTES ONLY - THE
      * REMAINDER IS CARRIED IN WS-RW-CARRY AND NOT PRESENTED.
       P3100-APPLY-ROUNDING.
           MOVE WS-EA-MOU-TOTAL TO WS-RW-RAW-MINUTES.
           MOVE WS-RW-RAW-MINUTES TO WS-RW-OUT-MINUTES.
           COMPUTE WS-RW-CARRY = WS-RW-RAW-MINUTES -
               WS-RW-OUT-MINUTES.
       P3100-EXIT.
           EXIT.
       P3200-BUILD-SUMMARY-REC.
           MOVE SPACES TO CABS-CTCS-RECORD.
           MOVE WS-PK-OCN TO CS-OCN.
           MOVE WS-PK-BAN TO CS-BAN.
           MOVE WS-PK-ELEM TO CS-RATE-ELEM.
           MOVE WS-CV-CYCLE-YYDDD TO CS-CYCLE-YYDDD.
           MOVE PC1-SITE-CD TO CS-SITE-CD.
           MOVE WS-FOUND-TYPE TO CS-CARRIER-TYPE.
           MOVE WS-SUMM-STATE-DFLT TO CS-STATE-CD.
           MOVE WS-EA-DETAIL-CNT TO CS-DETAIL-CNT.
           MOVE WS-EA-SUSPECT-CNT TO CS-SUSPECT-CNT.
           MOVE WS-EA-MOU-INTER TO CS-MOU-INTERSTATE.
           MOVE WS-EA-MOU-INTRA TO CS-MOU-INTRASTATE.
           MOVE WS-EA-MOU-LOCAL TO CS-MOU-LOCAL.
           MOVE WS-RW-OUT-MINUTES TO CS-MOU-TOTAL.
           MOVE WS-EA-HASH-SEQ TO CS-HASH-SEQ.
           MOVE WS-EA-HASH-OCN TO CS-HASH-OCN.
           MOVE SPACES TO CS-FILLER.
           ADD WS-EA-MOU-TOTAL TO WS-ACC-MINUTES.
           ADD WS-EA-HASH-SEQ TO WS-ACC-SEQ-HASH.
           ADD WS-EA-HASH-OCN TO WS-ACC-OCN-HASH.
       P3200-EXIT.
           EXIT.
       P3300-RESET-ACCUMULATORS.
           MOVE 0 TO WS-EA-DETAIL-CNT.
           MOVE 0 TO WS-EA-SUSPECT-CNT.
           MOVE 0 TO WS-EA-MOU-INTER.
           MOVE 0 TO WS-EA-MOU-INTRA.
           MOVE 0 TO WS-EA-MOU-LOCAL.
           MOVE 0 TO WS-EA-MOU-TOTAL.
           MOVE 0 TO WS-EA-HASH-SEQ.
           MOVE 0 TO WS-EA-HASH-OCN.
           MOVE 0 TO WS-RW-RAW-MINUTES.
           MOVE 0 TO WS-RW-OUT-MINUTES.
       P3300-EXIT.
           EXIT.
       P3400-PRINT-SUMMARY-LINE.
           IF WS-RPT-LINE-NBR > WS-RPT-MAX-LINES
               PERFORM P3410-PRINT-PAGE-HEAD THRU P3410-EXIT.
           MOVE SPACES TO CABS-PRINT-LINE.
           MOVE ' ' TO PC-CC.
           MOVE WS-PK-OCN TO WS-DW-OCN.
           MOVE WS-PK-BAN TO WS-DW-BAN.
           MOVE WS-PK-ELEM TO WS-DW-ELEM.
           MOVE WS-DW-OCN TO PC-COL-001-020.
           MOVE WS-DW-BAN TO PC-COL-021-060.
           MOVE WS-DW-ELEM TO PC-COL-061-090.
           MOVE WS-RW-OUT-MINUTES TO WS-RPT-MOU-EDIT.
           MOVE WS-RPT-MOU-EDIT TO PC-COL-091-132.
           WRITE CABS-PRINT-LINE.
           ADD 1 TO WS-RPT-LINE-NBR.
       P3400-EXIT.
           EXIT.
       P3410-PRINT-PAGE-HEAD.
           ADD 1 TO WS-RPT-PAGE-NBR.
           MOVE 0 TO WS-RPT-LINE-NBR.
           MOVE SPACES TO CABS-PRINT-LINE.
           MOVE '1' TO PC-CC.
           MOVE WS-RPT-TITLE1 TO PC-TEXT.
           WRITE CABS-PRINT-LINE.
           MOVE SPACES TO CABS-PRINT-LINE.
           MOVE ' ' TO PC-CC.
           MOVE WS-RPT-TITLE2 TO PC-TEXT.
           WRITE CABS-PRINT-LINE.
           MOVE SPACES TO CABS-PRINT-LINE.
           MOVE ' ' TO PC-CC.
           MOVE 'OCN' TO PC-COL-001-020.
           MOVE 'BILLING ACCOUNT NUMBER' TO PC-COL-021-060.
           MOVE 'RATE ELEM' TO PC-COL-061-090.
           MOVE 'CHARGEABLE MINUTES' TO PC-COL-091-132.
           WRITE CABS-PRINT-LINE.
           MOVE SPACES TO CABS-PRINT-LINE.
           WRITE CABS-PRINT-LINE.
       P3410-EXIT.
           EXIT.
      * S800-CONTROL SECTION - THE MANDATORY CABS CONTROL BOUNDARY.
       S800-CONTROL SECTION.
       P8000-CONTROL.
           PERFORM P3000-WRITE-SUMMARY THRU P3000-EXIT.
           PERFORM P8010-PRINT-AUDIT-REPORT THRU P8010-EXIT.
           PERFORM P8100-BUILD-CONTROL-REC THRU P8100-EXIT.
           PERFORM P8200-CHECK-BALANCE THRU P8200-EXIT.
           PERFORM P8300-WRITE-CONTROL-REC THRU P8300-EXIT.
       P8000-EXIT.
           EXIT.
       P8010-PRINT-AUDIT-REPORT.
           ADD 1 TO WS-RPT-PAGE-NBR.
           MOVE SPACES TO CABS-PRINT-LINE.
           MOVE '1' TO PC-CC.
           MOVE WS-RPT-TITLE1 TO PC-TEXT.
           WRITE CABS-PRINT-LINE.
           MOVE SPACES TO CABS-PRINT-LINE.
           MOVE ' ' TO PC-CC.
           MOVE 'RUN CONTROL TOTALS' TO PC-TEXT.
           WRITE CABS-PRINT-LINE.
           MOVE SPACES TO CABS-PRINT-LINE.
           WRITE CABS-PRINT-LINE.
           MOVE SPACES TO CABS-PRINT-LINE.
           MOVE ' ' TO PC-CC.
           MOVE 'DETAIL READ' TO PC-COL-001-020.
           MOVE WS-READ-CNT TO WS-RPT-CNT-EDIT.
           MOVE WS-RPT-CNT-EDIT TO PC-COL-021-060.
           WRITE CABS-PRINT-LINE.
           MOVE SPACES TO CABS-PRINT-LINE.
           MOVE ' ' TO PC-CC.
           MOVE 'SUMMARY WRITTEN' TO PC-COL-001-020.
           MOVE WS-WRITE-CNT TO WS-RPT-CNT-EDIT.
           MOVE WS-RPT-CNT-EDIT TO PC-COL-021-060.
           WRITE CABS-PRINT-LINE.
           MOVE SPACES TO CABS-PRINT-LINE.
           MOVE ' ' TO PC-CC.
           MOVE 'DETAIL SUSPENDED' TO PC-COL-001-020.
           MOVE WS-REJECT-CNT TO WS-RPT-CNT-EDIT.
           MOVE WS-RPT-CNT-EDIT TO PC-COL-021-060.
           WRITE CABS-PRINT-LINE.
           MOVE SPACES TO CABS-PRINT-LINE.
           MOVE ' ' TO PC-CC.
           MOVE 'DETAIL SUMMARISED' TO PC-COL-001-020.
           MOVE WS-SUMM-CNT TO WS-RPT-CNT-EDIT.
           MOVE WS-RPT-CNT-EDIT TO PC-COL-021-060.
           WRITE CABS-PRINT-LINE.
           MOVE SPACES TO CABS-PRINT-LINE.
           MOVE ' ' TO PC-CC.
           MOVE 'UNKNOWN OCN' TO PC-COL-001-020.
           MOVE WS-EX-UNKNOWN-OCN TO WS-RPT-CNT-EDIT.
           MOVE WS-RPT-CNT-EDIT TO PC-COL-021-060.
           WRITE CABS-PRINT-LINE.
           MOVE SPACES TO CABS-PRINT-LINE.
           MOVE ' ' TO PC-CC.
           MOVE 'INVALID DATE' TO PC-COL-001-020.
           MOVE WS-EX-BAD-DATE TO WS-RPT-CNT-EDIT.
           MOVE WS-RPT-CNT-EDIT TO PC-COL-021-060.
           WRITE CABS-PRINT-LINE.
           MOVE SPACES TO CABS-PRINT-LINE.
           MOVE ' ' TO PC-CC.
           MOVE 'OVER MOU THRESHOLD' TO PC-COL-001-020.
           MOVE WS-EX-OVER-THRESHOLD TO WS-RPT-CNT-EDIT.
           MOVE WS-RPT-CNT-EDIT TO PC-COL-021-060.
           WRITE CABS-PRINT-LINE.
           MOVE SPACES TO CABS-PRINT-LINE.
           MOVE ' ' TO PC-CC.
           MOVE 'INACTIVE CARRIER' TO PC-COL-001-020.
           MOVE WS-EX-INACTIVE-CARRIER TO WS-RPT-CNT-EDIT.
           MOVE WS-RPT-CNT-EDIT TO PC-COL-021-060.
           WRITE CABS-PRINT-LINE.
           MOVE SPACES TO CABS-PRINT-LINE.
           MOVE ' ' TO PC-CC.
           MOVE 'ZERO MINUTE DETAIL' TO PC-COL-001-020.
           MOVE WS-EX-ZERO-MINUTES TO WS-RPT-CNT-EDIT.
           MOVE WS-RPT-CNT-EDIT TO PC-COL-021-060.
           WRITE CABS-PRINT-LINE.
           MOVE SPACES TO CABS-PRINT-LINE.
           MOVE ' ' TO PC-CC.
           IF WS-CT-TABLE-FULL
               MOVE 'CARRIER TABLE FILLED - SOME OCN NOT LOADED' TO
                   PC-TEXT
           ELSE
               MOVE 'CARRIER TABLE LOADED IN FULL' TO PC-TEXT.
           WRITE CABS-PRINT-LINE.
       P8010-EXIT.
           EXIT.
       P8100-BUILD-CONTROL-REC.
           MOVE PC1-RUN-ID TO CT-RUN-ID.
           MOVE WS-PGM-NAME TO CT-PROCESS-ID.
           MOVE 1 TO CT-STEP-SEQ.
           MOVE WS-CV-CYCLE-YYDDD TO CT-CYCLE-YYDDD.
           MOVE PC1-BILL-PERIOD TO CT-BILL-PERIOD.
           MOVE 0 TO CT-RERUN-NBR.
           MOVE PC1-JOBNAME TO CT-JOBNAME.
           MOVE PC1-STEPNAME TO CT-STEPNAME.
           MOVE WS-READ-CNT TO CT-READ.
           MOVE WS-WRITE-CNT TO CT-WRITTEN.
           MOVE WS-REJECT-CNT TO CT-REJECTED.
           MOVE WS-SUMM-CNT TO CT-SUMMARISED.
           MOVE WS-CFWD-CNT TO CT-CARRIED-FWD.
           MOVE WS-ACC-MINUTES TO CT-HASH-MINUTES.
           MOVE 0 TO CT-HASH-AMOUNT.
           MOVE WS-ACC-SEQ-HASH TO CT-HASH-SEQ.
           MOVE WS-ACC-OCN-HASH TO CT-HASH-OCN.
           MOVE SPACES TO CT-RESTART-KEY.
           MOVE SPACES TO CT-FILLER.
           MOVE 0 TO CT-RC.
           MOVE SPACES TO CT-ABEND-CD.
       P8100-EXIT.
           EXIT.
      * P8200-CHECK-BALANCE - EVERY DETAIL RECORD READ IS EITHER
      * SUMMARISED, SUSPENDED OR CARRIED FORWARD.  A SUMMARY
      * RECORD WRITTEN IS NOT A DETAIL RECORD CONSUMED, SO THE
      * WRITTEN COUNT IS ZEROED BEFORE THE EQUATION IS TESTED.
       P8200-CHECK-BALANCE.
           MOVE 0 TO CT-WRITTEN.
           IF CT-READ = CT-WRITTEN + CT-REJECTED + CT-SUMMARISED +
                   CT-CARRIED-FWD
               MOVE 'B' TO CT-BAL-IND
           ELSE
               MOVE 'O' TO CT-BAL-IND.
       P8200-EXIT.
           EXIT.
       P8300-WRITE-CONTROL-REC.
           MOVE CABS-CONTROL-RECORD TO CABS-CTLOUT-RECORD.
           WRITE CABS-CTLOUT-RECORD.
       P8300-EXIT.
           EXIT.
      * S900-TERMINATION SECTION.
       S900-TERMINATION SECTION.
       P9000-TERM.
           CLOSE USGIN.
           CLOSE CARRMST.
           CLOSE SUMOUT.
           CLOSE SUSOUT.
           CLOSE CTLOUT.
           CLOSE RPTOUT.
           DISPLAY 'CABCTC01 - RUN COMPLETE'.
           DISPLAY '  DETAIL READ  = ' WS-READ-CNT.
           DISPLAY '  SUMMARY OUT  = ' WS-WRITE-CNT.
           DISPLAY '  SUSPENDED    = ' WS-REJECT-CNT.
           DISPLAY '  SUMMARISED   = ' WS-SUMM-CNT.
           DISPLAY '  UNKNOWN OCN  = ' WS-EX-UNKNOWN-OCN.
           DISPLAY '  BAD DATE     = ' WS-EX-BAD-DATE.
           DISPLAY '  OVER THRESH  = ' WS-EX-OVER-THRESHOLD.
           DISPLAY '  CARRIERS     = ' WS-CT-ENTRY-CNT.
       P9000-EXIT.
           EXIT.
