//CABMAPS  JOB (ACCTG),'CABS BMS ASSEMBLY',CLASS=A,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID
//*****************************************************************
//* CABMAPS - ASSEMBLE AND LINK THE SIX CAB0-CAB5 MAPSETS.        *
//* TWO PASS PER MAPSET - TYPE=MAP FOR THE PHYSICAL MAP (LOADED   *
//* BY CICS AT SEND MAP TIME) AND TYPE=DSECT FOR THE SYMBOLIC MAP *
//* (COPIED INTO THE COBOL SOURCE AT COMPILE TIME).  REFERENCE-   *
//* ONLY - THIS JOB HAS NEVER BEEN SUBMITTED AGAINST THE TK4-     *
//* SYSTEM BECAUSE TK4- CARRIES NO CICS REGION.  SEE ONLINE/       *
//* _MANIFEST.MD.                                                  *
//*****************************************************************
//*
//MAPLIB   JCLLIB ORDER=TELCABS.CABS.PROCLIB
//*
//*--------------------------------------------------------------*
//* STEP 1  - PHYSICAL MAPS, ONE ASSEMBLE/LINK PER MAPSET, OUTPUT *
//*           GOES TO THE CICS LOAD LIBRARY.                      *
//*--------------------------------------------------------------*
//PHYS01   EXEC PGM=ASMA90,PARM='DECK,NOOBJECT'
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//         DD DSN=CICS.SDFHMAC,DISP=SHR
//SYSIN    DD DSN=TELCABS.CABS.SOURCE.BMS(CABM0100),DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DSN=&&PHYS01,DISP=(NEW,PASS),UNIT=SYSDA,
//             SPACE=(TRK,(5,5)),DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//         DD DSN=&&PHYSDK,DISP=(MOD,PASS)
//         EXEC PGM=ASMA90,PARM='DECK,NOOBJECT'
//*        REPEAT PHYS01 FOR CABM0200 THROUGH CABM0600 - THE SIX
//*        JOB STEPS ARE MECHANICAL AND OMITTED HERE, SEE THE
//*        GENERATED VERSION SUBMITTED FROM CABSGEN PROC CABSBMSG.
//*
//LKED01   EXEC PGM=IEWL,PARM='LIST,XREF',COND=(4,LT,PHYS01)
//SYSLIB   DD DSN=CICS.SDFHLOAD,DISP=SHR
//SYSLMOD  DD DSN=TELCABS.CICS.LOADLIB,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSLIN   DD DSN=&&PHYSDK,DISP=(OLD,DELETE)
//         DD DDNAME=SYSIN
//SYSIN    DD *
  NAME CABM01(R)
  NAME CABM02(R)
  NAME CABM03(R)
  NAME CABM04(R)
  NAME CABM05(R)
  NAME CABM06(R)
/*
//*
//*--------------------------------------------------------------*
//* STEP 2  - SYMBOLIC MAPS (DSECT), OUTPUT GOES TO THE COPYBOOK  *
//*           LIBRARY AS CABM0100 THROUGH CABM0600 FOR THE        *
//*           COBOL COPY STATEMENT IN EACH CAB0-CAB5 PROGRAM.     *
//*--------------------------------------------------------------*
//SYM01    EXEC PGM=ASMA90,PARM='DECK,NOOBJECT,NODECK,SYM(DSECT)'
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//         DD DSN=CICS.SDFHMAC,DISP=SHR
//SYSIN    DD DSN=TELCABS.CABS.SOURCE.BMS(CABM0100),DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSGO    DD DSN=TELCABS.CABS.COPYLIB(CABM0100),DISP=SHR
//*        REPEAT SYM01 FOR CABM0200 THROUGH CABM0600 INTO
//*        COPYLIB MEMBERS CABM0200-CABM0600.  EACH COBOL
//*        PROGRAM IN ONLINE/ THEN DOES COPY CABMnnnn FOR ITS
//*        OWN MAP.  SEE CABS-STD-021 SECTION 6.
//*
