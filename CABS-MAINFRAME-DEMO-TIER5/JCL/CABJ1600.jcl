//CABJ1600 JOB (CABS,BILL),'QUARTERLY RESTATEMENT',
//             CLASS=B,MSGCLASS=X,MSGLEVEL=(1,1),
//             NOTIFY=&SYSUID,REGION=0M,TIME=1440
//*****************************************************************
//* CABJ1600 - RETROACTIVE FACTOR RESTATEMENT                     *
//*                                                               *
//* THE LARGEST AND MOST DANGEROUS JOB IN THE ESTATE.  IT         *
//* REPRICES A WHOLE QUARTER OF USAGE THAT HAS ALREADY BEEN       *
//* BILLED AND RAISES ADJUSTMENTS FOR THE DIFFERENCE.             *
//*                                                               *
//* %%RSTFRM IS THE FIRST DAY OF THE WINDOW AND %%RSTWIN IS ITS   *
//* LENGTH IN DAYS.  BOTH ARE SUBSTITUTED BY THE SCHEDULER FROM   *
//* THE QUARTERLY CALENDAR.  NEITHER HAS A DEFAULT AND NEITHER    *
//* APPEARS ANYWHERE IN THE JCL.  RUNNING THIS JOB WITH THE       *
//* WRONG WINDOW RESTATES THE WRONG QUARTER.                      *
//* VALUES ARE SUPPLIED BY THE SCHEDULER PER CABS-STD-022.        *
//*                                                               *
//* USGHIST READS GENERATION MINUS ONE OF THE PLU FILE AND        *
//* BILLHIST READS GENERATION MINUS THREE OF THE BILLED DETAIL    *
//* HISTORY.  WHICH PHYSICAL DATASETS THOSE ARE DEPENDS ON HOW    *
//* MANY TIMES EACH CYCLE HAS RUN SINCE THE QUARTER CLOSED.       *
//* GDG RELATIVE NUMBERING PER CABS-STD-026.                      *
//*****************************************************************
//STEP010  EXEC CABPREST,
//             CYCLE=%%CYCLDT,
//             BILLPER=%%BILLPR,
//             RUNID=%%RUNID,
//             RSTFROM=%%RSTFRM,
//             RSTWIN=%%RSTWIN,
//             REASON=%%REASON,
//             MATRLTY=%%MATRLT,
//             USGGDG='-1',
//             BILGDG='-3',
//             SIMSW=N
//*
//* THE RATE MASTER USED IS THE ARCHIVED COPY AS AT THE END OF
//* THE QUARTER BEING RESTATED, NOT TODAYS RATE MASTER.
//* OVERRIDE CONVENTIONS PER CABS-STD-024.
//*
//RESTATE.RATEMAST DD DSN=TELCABS.CABS.RATE.ARCH,DISP=SHR
//RESTATE.USGHIST  DD DSN=TELCABS.CABS.CDR.PLU(-1),DISP=SHR
//RESTATE.BILLHIST DD DSN=TELCABS.CABS.BILLDTL.HIST(-3),DISP=SHR
//*
//STEP020  EXEC PGM=SORT,COND=(4,LT,STEP010)
//SORTIN   DD DSN=TELCABS.CABS.RESTATE.ADJ(0),DISP=SHR
//SORTOUT  DD DSN=TELCABS.CABS.RESTATE.ADJ.SORT(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(CYL,(50,25),RLSE)
//SYSOUT   DD SYSOUT=*
//SYSIN    DD *
  SORT FIELDS=(1,13,CH,A,14,6,CH,A)
/*
//
