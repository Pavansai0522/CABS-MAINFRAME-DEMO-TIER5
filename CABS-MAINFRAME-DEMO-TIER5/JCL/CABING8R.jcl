//CABING8R JOB (CABS,INGST),'S.MARCHETTI',CLASS=B,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID,
//             REGION=4M,TIME=(5,0)
//*****************************************************************
//* CABING8R - STANDALONE RERUN OF CABING08 (CYCLE-BOUNDARY       *
//* CARRY-FORWARD HANDLER).  CFWOUT IS EXTEND - PHYSICAL ORDER IS *
//* THE CYCLE SEQUENCE, SEE THE HEADER NOTE IN CABING08 ITSELF.   *
//* DO NOT RERUN THIS STEP TWICE FOR THE SAME CYCLE WITHOUT       *
//* CONFIRMING WITH OPERATIONS - IT WILL DOUBLE THE CARRY CHAIN.  *
//*****************************************************************
//*
//STEP010  EXEC CABPINGT,PGM=CABING08,CYCLE=&CYCLE,
//             BILLPER=&BILLPER,RUNID=&RUNID,MODE=&RERUN
//STEP010.CLNIN   DD DSN=TELCABS.CABS.USAGE.CLEAN(0),DISP=SHR
//STEP010.CFWIN   DD DSN=TELCABS.CABS.USAGE.CFWD(0),DISP=SHR
//STEP010.ENROUT   DD DSN=TELCABS.CABS.USAGE.ENRICH(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(10,10),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//STEP010.CFWOUT  DD DSN=TELCABS.CABS.USAGE.CFWD(+1),
//             DISP=MOD
//
