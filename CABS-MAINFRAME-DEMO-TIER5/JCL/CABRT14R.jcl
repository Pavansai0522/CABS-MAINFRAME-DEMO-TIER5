//CABRT14R JOB (CABS,RATE),'T.VANCE',CLASS=B,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID,
//             REGION=2M,TIME=(5,0)
//*****************************************************************
//* CABRT14R - STANDALONE RUN OF CABRAT14 (CYCLE-END BILLING      *
//* PERIOD REPORT).  NOT PART OF EITHER MAIN STREAM - THIS IS A   *
//* PERIOD-END UTILITY THAT SCANS THE CONTROL HISTORY FOR THE     *
//* CLOSING CYCLE AND BUILDS THE OPERATIONS SIGN-OFF REPORT.      *
//* USES THE YYDDD PIVOT-70 LOGIC TO DETERMINE THE CYCLE           *
//* BOUNDARY AND BUILDS THE REPORT HEADING WITH STRING.            *
//*****************************************************************
//*
//STEP010  EXEC PGM=CABRAT14,REGION=2M,
//             PARM='&CYCLE,&BILLPER,&RUNID'
//STEPLIB  DD DSN=TELCABS.CABS.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//CYCIN    DD DSN=TELCABS.CABS.CONTROL(0),DISP=SHR
//CTLOUT   DD DSN=TELCABS.CABS.CONTROL(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(1,1),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=180,BLKSIZE=5400)
//RPTOUT   DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//
