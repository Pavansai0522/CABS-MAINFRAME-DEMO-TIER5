//CABJ1100 JOB (CABS,BILL),'FACTOR VALIDATION RERUN',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//             NOTIFY=&SYSUID,REGION=0M,TIME=1440
//*****************************************************************
//* CABJ1100 - FACTOR VALIDATION ONLY                             *
//*                                                               *
//* THE SAME PROC AS CABJ1000 WITH A DIFFERENT SET OF SYMBOLIC    *
//* VALUES AND THE LOAD STEP OVERRIDDEN TO DUMMY.  RUN BY HAND    *
//* WHEN THE ACCESS MANAGEMENT GROUP HAS CORRECTED A DISPUTED     *
//* FACTOR AND WANTS THE VALIDATION REGISTER REPRODUCED WITHOUT   *
//* RELOADING THE MASTER.                                         *
//* THE PROC LIBRARY IS CATALOGUED PER CABS-STD-024.              *
//* DD OVERRIDES ARE AGREED WITH OPERATIONS SUPPORT.              *
//*****************************************************************
//JOBLIB   DD DSN=TELCABS.CABS.LOADLIB.EMERG,DISP=SHR
//         DD DSN=TELCABS.CABS.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//         DD DSN=SYS1.COB2LIB,DISP=SHR
//*
//STEP010  EXEC CABPFCTL,
//             CYCLE=%%CYCLDT,
//             BILLPER=%%BILLPR,
//             RUNID=%%RUNID,
//             RERUN=%%RERUN,
//             LOADLIB=TELCABS.CABS.LOADLIB.EMERG
//*
//* THE LOAD STEP IS SUPPRESSED.  ONLY THE VALIDATION STEP RUNS.
//*
//FCTLOAD.FCTRIN   DD DUMMY,DCB=(RECFM=FB,LRECL=76,BLKSIZE=760)
//FCTLOAD.FCTRMAST DD DSN=TELCABS.CABS.FACTOR,DISP=SHR
//FCTVAL.FCTRVAL   DD DSN=TELCABS.CABS.FACTOR.VAL.RERUN(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(CYL,(5,5),RLSE),
//             DCB=(RECFM=FB,LRECL=76,BLKSIZE=0)
//FCTVAL.SYSIN     DD *
RN%%RUNID  %%CYCLDT%%BILLPR00CABJ1100FCTVAL   NN090
/*
//
