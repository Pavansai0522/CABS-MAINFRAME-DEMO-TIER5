//CABS3200 JOB (CABS,BILL),'SETTLEMENT POSTING',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//             NOTIFY=&SYSUID,REGION=0M,TIME=1440
//*****************************************************************
//* CABS3200 - SETTLEMENT POSTING TO DB2 AND THE VSAM MASTER      *
//*                                                               *
//* THE LAST JOB IN THE MONTHLY SETTLEMENT STREAM.  CABSET13      *
//* INSERTS INTO SETLTRAN AND WRITES THE SETTLEMENT MASTER.  THE  *
//* TWO ARE NOT COORDINATED.  WHEN THE COUNTS DIVERGE THE RESYNC  *
//* UTILITY HAS TO BE RUN BY HAND - IT WAS WRITTEN IN 2012 AND    *
//* HAS NEVER BEEN SCHEDULED.                                     *
//* THE POSTING ORDER IS FIXED BY CABS-STD-071.                   *
//* SEARCH ORDER PER CABS-STD-024 - DO NOT REORDER.               *
//*****************************************************************
//STEP010  EXEC CABPDB2P,
//             PGMNAME=CABSET13,
//             CYCLE=%%CYCLDT,
//             BILLPER=%%BILLPR,
//             RUNID=%%RUNID,
//             SUBSYS=%%DB2SUB,
//             PLAN=%%DB2PLN,
//             COMMIT=%%COMFRQ,
//             LOADLIB=TELCABS.SETL.LOADLIB
//*
//DB2STEP.STEPLIB  DD DSN=TELCABS.SETL.LOADLIB.EMERG,DISP=SHR
//         DD DSN=TELCABS.SETL.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.CABS.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//         DD DSN=DSN810.SDSNLOAD,DISP=SHR
//         DD DSN=SYS1.COB2LIB,DISP=SHR
//DB2STEP.ADJIN    DD DUMMY,DCB=(RECFM=VB,LRECL=1651,BLKSIZE=12040)
//DB2STEP.BALMAST  DD DUMMY
//DB2STEP.SETLADD  DD DSN=TELCABS.SETL.SETTLE.ADD(0),DISP=SHR
//DB2STEP.SETLMAST DD DSN=TELCABS.SETL.SETTLE.MASTER,DISP=SHR
//DB2STEP.CTLOUT   DD DSN=TELCABS.SETL.RUNCTL(+1),DISP=(MOD,KEEP)
//DB2STEP.SUSPOUT  DD DSN=TELCABS.SETL.SUSPENSE(+1),DISP=(MOD,KEEP)
//DB2STEP.SYSIN    DD *
RN%%RUNID  %%CYCLDT%%BILLPR00CABS3200DB2STEP NN%%COMFRQN
/*
//
