//CABRAT3R JOB (CABS,RATE),'R.WHEELER',CLASS=B,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID,
//             REGION=4M,TIME=(15,0)
//*****************************************************************
//* CABRAT3R - STANDALONE RERUN OF CABRAT03 (SWITCHED ACCESS      *
//* FIVE ELEMENT RATER).  READS THE VOICE USAGE SPLIT DIRECTLY -  *
//* SEE THE MAIN STREAM'S STEP040 COMMENT FOR WHY.  CARRIES ITS   *
//* OWN INTERNAL COBOL SORT (SORTWK1) FOR THE BAN LEVEL-BREAK     *
//* BILL DETAIL BUILD, NOT A JCL SORT STEP.                       *
//*****************************************************************
//*
//STEP010  EXEC CABPRATE,PGM=CABRAT03,CYCLE=&CYCLE,
//             BILLPER=&BILLPER,RUNID=&RUNID,TARIFF=&TARIFF,
//             MODE=&RERUN
//STEP010.RATIN   DD DSN=TELCABS.CABS.USAGE.VOICE(0),DISP=SHR
//STEP010.RATEMST DD DSN=TELCABS.CABS.RATE,DISP=SHR
//STEP010.CARRMST DD DSN=TELCABS.CABS.CARRIER,DISP=SHR
//STEP010.RATOUT   DD DSN=TELCABS.CABS.RATED(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(15,15),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//STEP010.BDTLOUT  DD DSN=TELCABS.CABS.BILLDTL(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(10,10),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=VB,LRECL=1651,BLKSIZE=6240)
//STEP010.SORTWK1 DD UNIT=SYSDA,SPACE=(CYL,(10,10))
//
