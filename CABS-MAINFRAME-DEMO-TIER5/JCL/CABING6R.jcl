//CABING6R JOB (CABS,INGST),'R.WHEELER',CLASS=B,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID,
//             REGION=4M,TIME=(5,0)
//*****************************************************************
//* CABING6R - STANDALONE RERUN OF CABING06 (CIRCUIT AND TRUNK   *
//* GROUP RESOLUTION).  READS THE CURRENT CLEAN GENERATION.      *
//*****************************************************************
//*
//* TYPICAL TRIGGER: A CIRCUIT INVENTORY LOAD LANDED LATE AND
//* THE MAIN STREAM'S STEP090 SUSPENDED CIRCUITS THAT WERE
//* STILL PROVISIONING AT THE TIME.  RERUN AFTER CONFIRMING
//* THE CIRCUIT MASTER LOAD COMPLETED - CABING06'S CLLI
//* SEGMENT PARSE (SEE V1.05 1994) IS SENSITIVE TO PARTIAL
//* CIRCUIT RECORDS AND WILL SUSPEND RATHER THAN GUESS.
//*
//*
//STEP010  EXEC CABPINGT,PGM=CABING06,CYCLE=&CYCLE,
//             BILLPER=&BILLPER,RUNID=&RUNID,MODE=&RERUN
//STEP010.CLNIN   DD DSN=TELCABS.CABS.USAGE.CLEAN(0),DISP=SHR
//STEP010.CIRCMST DD DSN=TELCABS.CABS.CIRCUIT,DISP=SHR
//STEP010.ENROUT   DD DSN=TELCABS.CABS.USAGE.ENRICH(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(10,10),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//
