//CABRAT2R JOB (CABS,RATE),'A.BUKOWSKI',CLASS=B,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID,
//             REGION=4M,TIME=(10,0)
//*****************************************************************
//* CABRAT2R - STANDALONE RERUN OF CABRAT02 (DISPATCHER).  THE    *
//* MOST COMMON REASON FOR A STANDALONE RERUN HERE IS A DYNAMIC   *
//* CALL FAILURE TO ONE OF THE ORIGINATING/TERMINATING ACCESS,    *
//* LOCAL TRANSPORT, TANDEM OR CARRIER COMMON LINE MODULES - THE  *
//* TARGET LOAD MODULE MUST BE VISIBLE SOMEWHERE IN STEPLIB.      *
//* EMERGENCY LIBRARY IS FIRST HERE - THIS RERUN PICKS UP A       *
//* SUFFIX-TABLE FIX APPLIED TO CABRATCC IN 2016 THAT WAS NEVER   *
//* PROMOTED OUT OF THE EMERGENCY LIBRARY.                        *
//*****************************************************************
//*
//STEP010  EXEC CABPRATE,PGM=CABRAT02,CYCLE=&CYCLE,
//             BILLPER=&BILLPER,RUNID=&RUNID,TARIFF=&TARIFF,
//             MODE=&RERUN
//STEP010.STEPLIB  DD DSN=TELCABS.CABS.LOADLIB.EMER,DISP=SHR
//         DD DSN=TELCABS.CABS.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//STEP010.RATIN   DD DSN=TELCABS.CABS.RATED(0),DISP=SHR
//STEP010.RATEMST DD DSN=TELCABS.CABS.RATE,DISP=SHR
//STEP010.CARRMST DD DSN=TELCABS.CABS.CARRIER,DISP=SHR
//STEP010.RATOUT   DD DSN=TELCABS.CABS.RATED(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(15,15),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//
