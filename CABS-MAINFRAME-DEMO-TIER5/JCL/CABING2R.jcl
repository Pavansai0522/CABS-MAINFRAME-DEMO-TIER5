//CABING2R JOB (CABS,INGST),'D.OKONKWO',CLASS=B,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID,
//             REGION=4M,TIME=(5,0)
//*****************************************************************
//* CABING2R - STANDALONE RERUN OF CABING02 (OCN/BAN VALIDATION) *
//* USE WHEN STEP040 OF CABING01 FAILS AFTER THE CARRIER MASTER  *
//* WAS CORRECTED.  READS THE CURRENT EDITED GENERATION.         *
//*****************************************************************
//*
//* TYPICAL TRIGGER: THE CARRIER MASTER RECEIVED AN EMERGENCY
//* OCN ADD/CHANGE AFTER THE MAIN STREAM ALREADY RAN STEP040
//* AND SUSPENDED A BATCH OF RECORDS FOR AN UNKNOWN OCN.
//* OPERATIONS CONFIRMS THE CARRMST UPDATE WITH THE CARRIER
//* RELATIONS DESK, THEN RESUBMITS THIS MEMBER.  EXPECTED
//* RUNTIME UNDER FIVE MINUTES FOR A NORMAL DAY'S VOLUME.
//* PAGE THE CABS BATCH ON-CALL IF SUSOUT GROWS ON THE RERUN
//* INSTEAD OF SHRINKING - THAT MEANS THE CARRMST FIX DID NOT
//* TAKE, NOT THAT MORE RECORDS FAILED.
//*
//*
//STEP010  EXEC CABPINGT,PGM=CABING02,CYCLE=&CYCLE,
//             BILLPER=&BILLPER,RUNID=&RUNID,MODE=&RERUN
//STEP010.EDTIN   DD DSN=TELCABS.CABS.USAGE.EDITED(0),DISP=SHR
//STEP010.CARRMST DD DSN=TELCABS.CABS.CARRIER,DISP=SHR
//STEP010.VLDOUT   DD DSN=TELCABS.CABS.USAGE.VALID(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(10,10),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//
