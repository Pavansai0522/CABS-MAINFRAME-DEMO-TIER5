//CABPRATE PROC CYCLE=000000,RUNID=00,BILLPER=000000,
//             TARIFF=STD,PGM=,MODE=LIVE
//*****************************************************************
//* CABPRATE - GENERIC RATING STEP PROC                          *
//* SYMBOLICS: CYCLE RUNID BILLPER TARIFF PGM MODE                *
//* THE CALLING JOB SUPPLIES RATIN/RATOUT AND ANY MASTER FILE    *
//* DDS (RATEMST, CARRMST, CIRCMST, OVRIN) AS ADDITIONS AFTER    *
//* THE EXEC CABPRATE CALL.                                      *
//*                                                               *
//* THE EMERGENCY LIBRARY IS FIRST IN THE STEPLIB BELOW.  IT WAS *
//* PUT THERE "TEMPORARILY" FOR THE CABRAT06 BAND-SELECT FIX IN  *
//* 2011 AND NO ONE HAS MOVED IT BACK SINCE - EVERY RATING STEP  *
//* THAT USES THIS PROC PICKS UP EMER-LIBRARY COPIES FIRST, NOT  *
//* JUST CABRAT06.                                                *
//*****************************************************************
//STEP1    EXEC PGM=&PGM,REGION=4M,
//             PARM='&CYCLE,&BILLPER,&RUNID,&TARIFF,&MODE'
//STEPLIB  DD DSN=TELCABS.CABS.LOADLIB.EMER,DISP=SHR
//         DD DSN=TELCABS.CABS.LOADLIB.TEST,DISP=SHR
//         DD DSN=TELCABS.CABS.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//SUSOUT   DD DSN=TELCABS.CABS.USAGE.SUSPENSE(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(5,5),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=300,BLKSIZE=9000)
//CTLOUT   DD DSN=TELCABS.CABS.CONTROL(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(1,1),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=180,BLKSIZE=5400)
//RPTOUT   DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
