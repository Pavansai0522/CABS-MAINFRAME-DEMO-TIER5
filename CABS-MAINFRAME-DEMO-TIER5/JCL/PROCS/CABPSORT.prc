//CABPSORT PROC SRTCARD=,SORTIN=,SORTOUT=
//*****************************************************************
//* CABPSORT - GENERIC SORT STEP PROC                            *
//* SYMBOLICS: SRTCARD SELECTS THE CONTROL CARD MEMBER FROM THE  *
//* CTLCARDS PDS.  SORTIN/SORTOUT ARE SUPPLIED BY THE CALLER     *
//* AS DD OVERRIDES - THE PROC POINTS THEM AT DUMMY BY DEFAULT   *
//* SO A MISSING OVERRIDE FAILS LOUDLY RATHER THAN SILENTLY.     *
//*****************************************************************
//STEP1    EXEC PGM=SORT,REGION=4M
//SORTIN   DD DUMMY
//SORTOUT  DD DUMMY
//SORTWK01 DD UNIT=SYSDA,SPACE=(CYL,(10,10))
//SORTWK02 DD UNIT=SYSDA,SPACE=(CYL,(10,10))
//SORTWK03 DD UNIT=SYSDA,SPACE=(CYL,(10,10))
//SYSOUT   DD SYSOUT=*
//SYSIN    DD DSN=TELCABS.CABS.JCL.CTLCARDS(&SRTCARD),
//             DISP=SHR
