//CABPSUSP PROC CYCLE=000000,RUNID=00,MODE=LIVE
//*****************************************************************
//* CABPSUSP - SUSPENSE CONSOLIDATION PROC.  WRAPS CABING07 FOR  *
//* THE MAIN STREAM AND FOR STANDALONE SUSPENSE REPROCESSING.    *
//*****************************************************************
//STEP1    EXEC PGM=CABING07,REGION=4M,
//             PARM='&CYCLE,&RUNID,&MODE'
//STEPLIB  DD DSN=TELCABS.CABS.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//SUSOUT   DD DSN=TELCABS.CABS.USAGE.SUSPENSE(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(5,5),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=300,BLKSIZE=9000)
//AUDLOG   DD DSN=TELCABS.CABS.AUDIT.LOG,
//             DISP=MOD
//CTLOUT   DD DSN=TELCABS.CABS.CONTROL(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(1,1),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=180,BLKSIZE=5400)
//RPTOUT   DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
