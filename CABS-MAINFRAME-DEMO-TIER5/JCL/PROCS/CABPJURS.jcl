//CABPJURS PROC PGMNAME=,CYCLE=,BILLPER=,RUNID=,
//             INGDG='0',OUTDD=,STEPSEQ=,
//             LOADLIB=TELCABS.CABS.LOADLIB,
//             EMERG=TELCABS.CABS.LOADLIB.EMERG
//*****************************************************************
//* CABPJURS - GENERIC JURISDICTION STEP FRAGMENT                 *
//*                                                               *
//* INCLUDED BY CABJ1200 (DETERMINATION), CABJ1300 (PIU) AND      *
//* CABJ1400 (PLU).  THE PROGRAM THAT RUNS IS PASSED IN AS A      *
//* SYMBOLIC, SO THE SAME FRAGMENT DRIVES THREE DIFFERENT         *
//* PROGRAMS AND THREE DIFFERENT SETS OF FILES.                   *
//* THE PROC LIBRARY IS CATALOGUED PER CABS-STD-024.              *
//*                                                               *
//* THE STEPLIB CONCATENATION PUTS THE EMERGENCY FIX LIBRARY      *
//* AHEAD OF THE PRODUCTION LOAD LIBRARY.  CABDATCV EXISTS IN     *
//* BOTH.  WHICHEVER COPY IS FOUND FIRST IS THE ONE THAT RUNS     *
//* AND THE JOB LOG DOES NOT SAY WHICH.                           *
//* SEARCH ORDER PER CABS-STD-024 - DO NOT REORDER.               *
//*****************************************************************
//JURSTEP  EXEC PGM=&PGMNAME,REGION=6M,
//             PARM='&CYCLE.&STEPSEQ'
//STEPLIB  DD DSN=&EMERG,DISP=SHR
//         DD DSN=&LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//         DD DSN=SYS1.COB2LIB,DISP=SHR
//CDRIN    DD DSN=TELCABS.CABS.CDR.RATED(&INGDG),DISP=SHR
//FCTRVAL  DD DSN=TELCABS.CABS.FACTOR.VAL(0),DISP=SHR
//CDROUT   DD DSN=TELCABS.CABS.&OUTDD(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(CYL,(200,100),RLSE),
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//CTLOUT   DD DSN=TELCABS.CABS.RUNCTL(+1),DISP=(MOD,KEEP)
//SUSPOUT  DD DSN=TELCABS.CABS.SUSPENSE(+1),DISP=(MOD,KEEP)
//SYSOUT   DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//SYSIN    DD DUMMY
//         PEND
