//CABPCMDS PROC PGMNAME=,CYCLE=,BILLPER=,RUNID=,
//             EXCHDT=,CUTOFF=005,REGION1=A,EXPRAO='   ',
//             FILESEQ='000000',INGDG='0',
//             LOADLIB=TELCABS.SETL.LOADLIB
//*****************************************************************
//* CABPCMDS - CMDS RAO EXCHANGE FRAGMENT                         *
//*                                                               *
//* INCLUDED BY CABS2600 (OUTBOUND) AND CABS2700 (INBOUND).  THE  *
//* OUTBOUND JOB PASSES A REGION AND A CUT OFF DAY; THE INBOUND   *
//* JOB PASSES AN EXPECTED RAO AND A FILE SEQUENCE AND OVERRIDES  *
//* THE INPUT AND OUTPUT DD STATEMENTS COMPLETELY.                *
//* SHARED MEMBERS ARE CHANGED THROUGH OPERATIONS SUPPORT ONLY.   *
//* DD OVERRIDES ARE AGREED WITH OPERATIONS SUPPORT.              *
//*                                                               *
//* EXCHDT HAS NO DEFAULT.  IT IS THE DATE STAMPED INTO THE       *
//* EXCHANGE FILE HEADER AND THE RECEIVING RBOC REJECTS THE FILE  *
//* IF IT IS NOT TODAY IN THEIR TIME ZONE.                        *
//*****************************************************************
//CMDSSTEP EXEC PGM=&PGMNAME,REGION=8M,
//             PARM='&CYCLE.&EXCHDT'
//STEPLIB  DD DSN=&LOADLIB,DISP=SHR
//         DD DSN=TELCABS.SETL.LOADLIB.EMERG,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//         DD DSN=SYS1.COB2LIB,DISP=SHR
//SETLIN   DD DSN=TELCABS.SETL.SETTLE.DAILY(&INGDG),DISP=SHR
//CARRMAST DD DSN=TELCABS.SETL.CARRIER,DISP=SHR
//CMDSOUT  DD DSN=TELCABS.SETL.CMDS.OUT(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(CYL,(10,5),RLSE),
//             DCB=(RECFM=FB,LRECL=180,BLKSIZE=0)
//CTLOUT   DD DSN=TELCABS.SETL.RUNCTL(+1),DISP=(MOD,KEEP)
//SUSPOUT  DD DSN=TELCABS.SETL.SUSPENSE(+1),DISP=(MOD,KEEP)
//REPORT   DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//SYSIN    DD *
RN&RUNID.&CYCLE.&BILLPER.00CMDSEXCH CMDSSTEP&REGION1.N&EXCHDT.&CUTOFF
/*
//         PEND
