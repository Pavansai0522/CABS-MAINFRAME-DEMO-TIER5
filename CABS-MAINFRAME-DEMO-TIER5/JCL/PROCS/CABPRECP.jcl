//CABPRECP PROC PGMNAME=,CYCLE=,BILLPER=,RUNID=,SETPER=,
//             DEFRATE='0.00070',CAPOVR='000000000',
//             STATE='  ',SIMSW=N,INGDG='0',
//             LOADLIB=TELCABS.SETL.LOADLIB
//*****************************************************************
//* CABPRECP - RECIPROCAL COMPENSATION FRAGMENT                   *
//*                                                               *
//* INCLUDED BY CABS2400 (AGGREGATION) AND CABS2500 (CALCULATION) *
//* WITH DIFFERENT PROGRAM NAMES AND DIFFERENT SYMBOLICS.         *
//* SHARED MEMBERS ARE CHANGED THROUGH OPERATIONS SUPPORT ONLY.   *
//*                                                               *
//* CAPOVR OVERRIDES THE ISP BOUND CAP FROM THE INTERCONNECTION   *
//* AGREEMENT.  IT IS SUPPLIED BY THE SCHEDULER AND A VALUE OF    *
//* ZERO MEANS USE THE AGREEMENT CAP - NOT A CAP OF ZERO.         *
//* VALUES ARE SUPPLIED BY THE SCHEDULER PER CABS-STD-022.        *
//*****************************************************************
//RECPSTEP EXEC PGM=&PGMNAME,REGION=12M,
//             PARM='&CYCLE.&SETPER'
//STEPLIB  DD DSN=&LOADLIB,DISP=SHR
//         DD DSN=TELCABS.CABS.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//         DD DSN=SYS1.COB2LIB,DISP=SHR
//RECIPIN  DD DSN=TELCABS.SETL.RECIP.USAGE(&INGDG),DISP=SHR
//RECIPCDR DD DSN=TELCABS.CABS.CDR.RECIP(0),DISP=SHR
//CARRMAST DD DSN=TELCABS.SETL.CARRIER,DISP=SHR
//RECAGG   DD DSN=TELCABS.SETL.RECIP.AGG(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(CYL,(10,5),RLSE),
//             DCB=(RECFM=FB,LRECL=180,BLKSIZE=0)
//CTLOUT   DD DSN=TELCABS.SETL.RUNCTL(+1),DISP=(MOD,KEEP)
//SUSPOUT  DD DSN=TELCABS.SETL.SUSPENSE(+1),DISP=(MOD,KEEP)
//REPORT   DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//SYSIN    DD *
RN&RUNID.&CYCLE.&BILLPER.00RECIP    RECPSTEP&SIMSW.N&SETPER.&DEFRATE
/*
//         PEND
