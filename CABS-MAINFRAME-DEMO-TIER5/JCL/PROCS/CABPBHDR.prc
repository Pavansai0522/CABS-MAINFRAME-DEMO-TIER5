//CABPBHDR PROC PGMNAME=,CYCLE=,BILLPER=,RUNID=,RERUN=00,
//             JOBNM=,STEPNM=HDRSTEP,OPT1=Y,OPT2=Y,
//             VARPCT='000.00',MINLIN='00001',HOLDLIM='000000000.00',
//             TOLER='000.00',PREFIX='CA',SEQSTR='000000',
//             INGDG='0',OUTGDG='+1',PRIGDG='-1',
//             LOADLIB=TELCABS.CABS.LOADLIB
//*****************************************************************
//* CABPBHDR - AUDIT, BALANCE AND NUMBERING FRAGMENT              *
//*                                                               *
//* USED BY CABS4500 (PRE BILL AUDIT), CABS4550 (BILL BALANCING)  *
//* AND CABS4600 (INVOICE NUMBERING).  ALL THREE OVERRIDE THE     *
//* OUTPUT DD AND THE FIRST TWO OVERRIDE THE INPUT DD AS WELL.    *
//* THE PROC LIBRARY IS CATALOGUED PER CABS-STD-024.              *
//*                                                               *
//* PRIORIN READS THE FINAL HEADER FILE AT GENERATION MINUS ONE - *
//* LAST CYCLE INVOICES - FOR THE BILL TO BILL VARIANCE TEST.     *
//* GENERATION HANDLING PER CABS-STD-026.                         *
//*****************************************************************
//HDRSTEP  EXEC PGM=&PGMNAME,REGION=8M,
//             PARM='&CYCLE.&BILLPER'
//STEPLIB  DD DSN=TELCABS.CABS.EMERG.LOADLIB,DISP=SHR
//         DD DSN=&LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//         DD DSN=SYS1.COB2LIB,DISP=SHR
//BHDRIN   DD DSN=TELCABS.CABS.BILLHDR.MMX(&INGDG),DISP=SHR
//PRIORIN  DD DSN=TELCABS.CABS.BILLHDR.FIN(&PRIGDG),DISP=SHR
//HOLDMST  DD DSN=TELCABS.CABS.HOLDRSN,DISP=SHR
//INVCTL   DD DSN=TELCABS.CABS.INVCTL,DISP=SHR
//BHDROUT  DD DSN=TELCABS.CABS.BILLHDR.AUD(&OUTGDG),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(CYL,(10,5),RLSE),
//             DCB=(RECFM=FB,LRECL=400,BLKSIZE=0)
//HOLDOUT  DD DSN=TELCABS.CABS.BILLHOLD(&OUTGDG),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(15,15),RLSE),
//             DCB=(RECFM=FB,LRECL=400,BLKSIZE=0)
//CTLOUT   DD DSN=TELCABS.CABS.CONTROL(&OUTGDG),
//             DISP=(MOD,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(5,5),RLSE),
//             DCB=(RECFM=FB,LRECL=180,BLKSIZE=0)
//SUSPOUT  DD DSN=TELCABS.CABS.BILL.SUSP(&OUTGDG),
//             DISP=(MOD,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(15,15),RLSE),
//             DCB=(RECFM=FB,LRECL=300,BLKSIZE=0)
//REPORT   DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//SYSIN    DD *
RN&RUNID&CYCLE&BILLPER&RERUN&JOBNM&STEPNM&OPT1&OPT2&VARPCT&MINLIN&HOLDLIM
/*
//         PEND
