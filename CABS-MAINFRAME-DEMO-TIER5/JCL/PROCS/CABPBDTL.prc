//CABPBDTL PROC PGMNAME=,CYCLE=,BILLPER=,RUNID=,RERUN=00,
//             JOBNM=,STEPNM=DTLSTEP,MAXELM=40,SUPZER=N,
//             CONTSW=Y,SECTFR='U1',SECTTH='Z1',
//             INGDG='0',OUTGDG='+1',
//             LOADLIB=TELCABS.CABS.LOADLIB
//*****************************************************************
//* CABPBDTL - BILL DETAIL ASSEMBLY AND SEQUENCING FRAGMENT       *
//*                                                               *
//* USED BY CABS4100 (ASSEMBLY) AND CABS4150 (SEQUENCING).  THE   *
//* TWO JOBS PASS DIFFERENT PROGRAM NAMES AND DIFFERENT VALUES    *
//* FOR MAXELM AND SUPZER AND OVERRIDE THE INPUT AND OUTPUT DDS.  *
//* PROC LIBRARY MEMBERS ARE OWNED BY OPERATIONS SUPPORT.         *
//*                                                               *
//* MAXELM IS SUBSTITUTED BY THE SCHEDULER.  IT IS NOT DEFAULTED  *
//* ANYWHERE IN THE PROGRAM - A VALUE ABOVE FORTY ABENDS THE STEP.*
//* VALUES ARE SUPPLIED BY THE SCHEDULER PER CABS-STD-022.        *
//*****************************************************************
//DTLSTEP  EXEC PGM=&PGMNAME,REGION=0M,
//             PARM='&CYCLE.&BILLPER'
//STEPLIB  DD DSN=TELCABS.CABS.EMERG.LOADLIB,DISP=SHR
//         DD DSN=&LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//         DD DSN=SYS1.COB2LIB,DISP=SHR
//RATIN    DD DSN=TELCABS.CABS.RATED.JUR(&INGDG),DISP=SHR
//TRIGIN   DD DSN=TELCABS.CABS.BILLTRIG(&INGDG),DISP=SHR
//BDTLOUT  DD DSN=TELCABS.CABS.BILLDTL(&OUTGDG),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(CYL,(80,40),RLSE),
//             DCB=(RECFM=VB,LRECL=1651,BLKSIZE=0)
//SORTWK1  DD UNIT=SYSDA,SPACE=(CYL,(60,30))
//SORTWK2  DD UNIT=SYSDA,SPACE=(CYL,(60,30))
//SORTWK3  DD UNIT=SYSDA,SPACE=(CYL,(60,30))
//CTLOUT   DD DSN=TELCABS.CABS.CONTROL(&OUTGDG),
//             DISP=(MOD,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(5,5),RLSE),
//             DCB=(RECFM=FB,LRECL=180,BLKSIZE=0)
//SUSPOUT  DD DSN=TELCABS.CABS.BILL.SUSP(&OUTGDG),
//             DISP=(MOD,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(15,15),RLSE),
//             DCB=(RECFM=FB,LRECL=300,BLKSIZE=0)
//REPORT   DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//SYSIN    DD *
RN&RUNID&CYCLE&BILLPER&RERUN&JOBNM&STEPNM&SUPZER&CONTSW&MAXELM&SECTFR&SECTTH
/*
//         PEND
