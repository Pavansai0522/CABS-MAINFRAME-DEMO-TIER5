//CABPNETT PROC PGMNAME=,CYCLE=,BILLPER=,RUNID=,NETPER=,
//             INCDISP=N,INTRATE='000.00000',SUPZERO=Y,
//             STMTDT=,INGDG='0',
//             LOADLIB=TELCABS.SETL.LOADLIB
//*****************************************************************
//* CABPNETT - NETTING AND STATEMENT FRAGMENT                     *
//*                                                               *
//* INCLUDED BY CABS2800 (NETTING) AND CABS3000 (STATEMENT).      *
//* THE NETTING JOB PASSES INCDISP AND INTRATE; THE STATEMENT     *
//* JOB PASSES SUPZERO AND STMTDT AND OVERRIDES NETIN TO READ     *
//* THE GENERATION THE NETTING JOB JUST CREATED.                  *
//* THE PROC LIBRARY IS CATALOGUED PER CABS-STD-024.              *
//*                                                               *
//* CARRMAST POINTS AT TELCABS.CABS.CARRIER - A DATASET OWNED BY  *
//* THE BILLING APPLICATION.  THE SETTLEMENT APPLICATION READS    *
//* IT DIRECTLY FOR THE CARRIER NAME AND PAYMENT TERMS.           *
//* READ ACCESS GRANTED UNDER THE 1991 INTERFACE AGREEMENT.       *
//*****************************************************************
//NETTSTEP EXEC PGM=&PGMNAME,REGION=8M,
//             PARM='&CYCLE.&NETPER'
//STEPLIB  DD DSN=&LOADLIB,DISP=SHR
//         DD DSN=TELCABS.CABS.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//         DD DSN=SYS1.COB2LIB,DISP=SHR
//SETLIN   DD DSN=TELCABS.SETL.SETTLE.ALL(&INGDG),DISP=SHR
//CARRMAST DD DSN=TELCABS.CABS.CARRIER,DISP=SHR
//NETOUT   DD DSN=TELCABS.SETL.NET(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(CYL,(5,5),RLSE),
//             DCB=(RECFM=FB,LRECL=180,BLKSIZE=0)
//CTLOUT   DD DSN=TELCABS.SETL.RUNCTL(+1),DISP=(MOD,KEEP)
//SUSPOUT  DD DSN=TELCABS.SETL.SUSPENSE(+1),DISP=(MOD,KEEP)
//REPORT   DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//SYSIN    DD *
RN&RUNID.&CYCLE.&BILLPER.00NETTING  NETTSTEP&INCDISP.&SUPZERO.&NETPER
/*
//         PEND
