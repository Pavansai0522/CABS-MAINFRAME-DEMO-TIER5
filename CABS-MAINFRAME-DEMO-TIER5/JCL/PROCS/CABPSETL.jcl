//CABPSETL PROC PGMNAME=,CYCLE=,BILLPER=,RUNID=,SETPER=,
//             TARIFF=MPB1,MINAMT='00000.00',REGION1=A,
//             SIMSW=N,INGDG='0',
//             LOADLIB=TELCABS.SETL.LOADLIB,
//             EMERG=TELCABS.SETL.LOADLIB.EMERG
//*****************************************************************
//* CABPSETL - GENERIC SETTLEMENT CALCULATION FRAGMENT            *
//*                                                               *
//* INCLUDED BY CABS2200 (MEET POINT), CABS2500 (RECIPROCAL       *
//* COMPENSATION) AND CABS3200 (POSTING).  EACH PASSES A          *
//* DIFFERENT PROGRAM NAME AND A DIFFERENT SET OF SYMBOLICS AND   *
//* EACH OVERRIDES DIFFERENT DD STATEMENTS.                       *
//* PROC LIBRARY MEMBERS ARE OWNED BY OPERATIONS SUPPORT.         *
//*                                                               *
//* THE STEPLIB PUTS THE SETTLEMENT EMERGENCY LIBRARY FIRST, THE  *
//* SETTLEMENT PRODUCTION LIBRARY SECOND AND THE BILLING          *
//* APPLICATION LIBRARY THIRD.  CABDATCV AND CABABEND EXIST IN    *
//* MORE THAN ONE OF THEM.                                        *
//*****************************************************************
//SETLSTEP EXEC PGM=&PGMNAME,REGION=16M,
//             PARM='&CYCLE.&SETPER'
//STEPLIB  DD DSN=&EMERG,DISP=SHR
//         DD DSN=&LOADLIB,DISP=SHR
//         DD DSN=TELCABS.CABS.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//         DD DSN=SYS1.COB2LIB,DISP=SHR
//MPBVAL   DD DSN=TELCABS.SETL.MPB.VALID(&INGDG),DISP=SHR
//BILLDTL  DD DSN=TELCABS.CABS.BILLDTL(0),DISP=SHR
//RATEMAST DD DSN=TELCABS.SETL.RATE,DISP=SHR
//CARRMAST DD DSN=TELCABS.SETL.CARRIER,DISP=SHR
//SETLOUT  DD DSN=TELCABS.SETL.SETTLE.MPB(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(CYL,(30,15),RLSE),
//             DCB=(RECFM=FB,LRECL=180,BLKSIZE=0)
//VAROUT   DD DSN=TELCABS.SETL.MPB.VARIANCE(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(30,15),RLSE),
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//CTLOUT   DD DSN=TELCABS.SETL.RUNCTL(+1),DISP=(MOD,KEEP)
//SUSPOUT  DD DSN=TELCABS.SETL.SUSPENSE(+1),DISP=(MOD,KEEP)
//REPORT   DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//SYSIN    DD *
RN&RUNID.&CYCLE.&BILLPER.00SETTLE   SETLSTEP&SIMSW.N&SETPER.&TARIFF
/*
//         PEND
