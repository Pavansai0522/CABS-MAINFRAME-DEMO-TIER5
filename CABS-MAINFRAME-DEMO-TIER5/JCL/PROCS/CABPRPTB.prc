//CABPRPTB PROC PGMNAME=,CYCLE=,BILLPER=,RUNID=,RERUN=00,
//             JOBNM=,STEPNM=RPTSTEP,HALT=Y,CHAIN=Y,HASH=Y,
//             DETAIL=N,EXPPRC='000',LEVEL=,MINREV='000000000.00',
//             AGEBAS=,OLDDAY='000',QUARTR=,VARLIM='000.00',
//             INGDG='0',OUTGDG='+1',
//             LOADLIB=TELCABS.CABS.LOADLIB
//*****************************************************************
//* CABPRPTB - REPORTING FRAGMENT                                 *
//*                                                               *
//* USED BY CABS6000, CABS6100, CABS6200 AND CABS6300.  EACH JOB  *
//* OVERRIDES THE INPUT DD IT ACTUALLY READS AND ROUTES ITS OWN   *
//* REPORT DD.                                                    *
//*                                                               *
//* EXPPRC IS THE NUMBER OF PROCESSES THE CYCLE DEFINITION SAYS   *
//* SHOULD HAVE REPORTED.  IT DIFFERS BETWEEN A NORMAL CYCLE, A   *
//* RESTATEMENT CYCLE AND A MONTH END CYCLE AND HAS NO DEFAULT.   *
//* THE SUBMISSION STANDARD IS CABS-STD-022 - NOTHING DEFAULTS.   *
//*****************************************************************
//RPTSTEP  EXEC PGM=&PGMNAME,REGION=8M,
//             PARM='&CYCLE.&BILLPER'
//STEPLIB  DD DSN=TELCABS.CABS.EMERG.LOADLIB,DISP=SHR
//         DD DSN=&LOADLIB,DISP=SHR
//         DD DSN=TELCABS.SETL.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//         DD DSN=SYS1.COB2LIB,DISP=SHR
//CTLIN    DD DSN=TELCABS.CABS.CONTROL(&INGDG),DISP=SHR
//PROOFIN  DD DSN=TELCABS.CABS.BILLPROOF(&INGDG),DISP=SHR
//BDTLIN   DD DSN=TELCABS.CABS.BILLDTL.SEQ(&INGDG),DISP=SHR
//CARRMST  DD DSN=TELCABS.CABS.CARRIER,DISP=SHR
//SORTWK1  DD UNIT=SYSDA,SPACE=(CYL,(20,10))
//SORTWK2  DD UNIT=SYSDA,SPACE=(CYL,(20,10))
//BALOUT   DD SYSOUT=*
//CTLOUT   DD DSN=TELCABS.CABS.CONTROL(&OUTGDG),
//             DISP=(MOD,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(5,5),RLSE),
//             DCB=(RECFM=FB,LRECL=180,BLKSIZE=0)
//SUSPOUT  DD DSN=TELCABS.CABS.BILL.SUSP(&OUTGDG),
//             DISP=(MOD,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(15,15),RLSE),
//             DCB=(RECFM=FB,LRECL=300,BLKSIZE=0)
//REPORT   DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//SYSIN    DD *
RN&RUNID&CYCLE&BILLPER&RERUN&JOBNM&STEPNM&HALT&CHAIN&HASH&DETAIL&EXPPRC
/*
//         PEND
