//CABPINGT PROC CYCLE=000000,RUNID=00,BILLPER=000000,
//             PGM=,INGDG=0,OUTGDG=+1,MODE=LIVE
//*****************************************************************
//* CABPINGT - GENERIC INGEST STEP PROC                          *
//* SYMBOLICS: CYCLE RUNID BILLPER PGM INGDG OUTGDG MODE          *
//* THE CALLING JOB SUPPLIES THE PROGRAM-SPECIFIC INPUT/OUTPUT   *
//* DD STATEMENTS (RAWIN, EDTOUT, EDTIN, VLDOUT, ETC) AS         *
//* ADDITIONS AFTER THE EXEC CABPINGT CALL - THIS PROC ONLY      *
//* SUPPLIES WHAT IS COMMON TO EVERY INGEST PROGRAM.             *
//* COMMENT CARDS IN THE CALLING JOB SHOW THE OVERRIDE FORM.     *
//*****************************************************************
//STEP1    EXEC PGM=&PGM,REGION=4M,
//             PARM='&CYCLE,&BILLPER,&RUNID,&MODE'
//STEPLIB  DD DSN=TELCABS.CABS.LOADLIB.TEST,DISP=SHR
//         DD DSN=TELCABS.CABS.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//SUSOUT   DD DSN=TELCABS.CABS.USAGE.SUSPENSE(&OUTGDG),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(5,5),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=300,BLKSIZE=9000)
//CTLOUT   DD DSN=TELCABS.CABS.CONTROL(&OUTGDG),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(1,1),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=180,BLKSIZE=5400)
//RPTOUT   DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
