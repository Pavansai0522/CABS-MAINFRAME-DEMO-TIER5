//CABPREST PROC CYCLE=,BILLPER=,RUNID=,RSTFROM=,RSTWIN=,
//             REASON=,MATRLTY=,USGGDG='-1',BILGDG='-3',
//             SIMSW=N,OCNSEL='    ',
//             LOADLIB=TELCABS.CABS.LOADLIB
//*****************************************************************
//* CABPREST - RETROACTIVE FACTOR RESTATEMENT FRAGMENT            *
//*                                                               *
//* USED BY CABJ1600 (QUARTERLY RESTATEMENT) AND BY CABJ1650      *
//* (SIMULATION RUN).  THE SIMULATION JOB PASSES SIMSW=Y AND      *
//* OVERRIDES ADJOUT TO DUMMY.  SAME PROC, DIFFERENT BEHAVIOUR.   *
//* SHARED MEMBERS ARE CHANGED THROUGH OPERATIONS SUPPORT ONLY.   *
//*                                                               *
//* RSTFROM AND RSTWIN HAVE NO DEFAULT.  THEY DECIDE WHICH        *
//* QUARTER IS REPRICED.  THE SCHEDULER SUBSTITUTES THEM FROM     *
//* THE QUARTERLY CALENDAR AT SUBMISSION TIME AND NOTHING IN      *
//* THE JCL SAYS WHAT THEY WILL BE.                               *
//* THE SUBMISSION STANDARD IS CABS-STD-022 - NOTHING DEFAULTS.   *
//*                                                               *
//* USGHIST READS GENERATION MINUS ONE AND BILLHIST READS         *
//* GENERATION MINUS THREE.  WHICH ACTUAL DATASETS THOSE ARE      *
//* DEPENDS ENTIRELY ON HOW MANY TIMES THE CYCLE HAS RUN SINCE    *
//* THE QUARTER CLOSED.                                           *
//*****************************************************************
//RESTATE  EXEC PGM=CABJUR07,REGION=32M,
//             PARM='&CYCLE.&RSTFROM'
//STEPLIB  DD DSN=&LOADLIB,DISP=SHR
//         DD DSN=TELCABS.CABS.LOADLIB.EMERG,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//         DD DSN=SYS1.COB2LIB,DISP=SHR
//USGHIST  DD DSN=TELCABS.CABS.CDR.PLU(&USGGDG),DISP=SHR
//BILLHIST DD DSN=TELCABS.CABS.BILLDTL.HIST(&BILGDG),DISP=SHR
//FCTRVAL  DD DSN=TELCABS.CABS.FACTOR.VAL(0),DISP=SHR
//RATEMAST DD DSN=TELCABS.CABS.RATE,DISP=SHR
//ADJOUT   DD DSN=TELCABS.CABS.RESTATE.ADJ(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(CYL,(50,25),RLSE),
//             DCB=(RECFM=VB,LRECL=1651,BLKSIZE=0)
//AUDTOUT  DD DSN=TELCABS.CABS.RESTATE.AUDIT(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(CYL,(300,150),RLSE),
//             DCB=(RECFM=FB,LRECL=250,BLKSIZE=0)
//CTLOUT   DD DSN=TELCABS.CABS.RUNCTL(+1),DISP=(MOD,KEEP)
//SUSPOUT  DD DSN=TELCABS.CABS.SUSPENSE(+1),DISP=(MOD,KEEP)
//REPORT   DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//SYSIN    DD *
RN&RUNID.&CYCLE.&BILLPER.00CABJ1600RESTATE  N&RSTWIN.&REASON
/*
//         PEND
