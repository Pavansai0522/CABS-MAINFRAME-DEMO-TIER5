//CABPMPBX PROC PGMNAME=,CYCLE=,BILLPER=,RUNID=,SETPER=,
//             INDD=,OUTDD=,INGDG='0',TOLER='000.00001',
//             LOADLIB=TELCABS.SETL.LOADLIB
//*****************************************************************
//* CABPMPBX - MEET POINT EXTRACT AND VALIDATION FRAGMENT         *
//*                                                               *
//* INCLUDED BY CABS2100 (EXTRACT) AND CABS2300 (PERCENTAGE       *
//* VALIDATION).  THE TWO JOBS PASS A DIFFERENT PROGRAM NAME,     *
//* A DIFFERENT INPUT DD AND A DIFFERENT TOLERANCE.               *
//* THE PROC LIBRARY IS CATALOGUED PER CABS-STD-024.              *
//*                                                               *
//* THE CDRIN DD POINTS AT A DATASET OWNED BY THE BILLING         *
//* APPLICATION - TELCABS.CABS.CDR.PLU.  THE SETTLEMENT           *
//* APPLICATION READS IT DIRECTLY.  NEITHER APPLICATION CAN BE    *
//* MIGRATED WITHOUT THE OTHER.                                   *
//* DATASET SHARING APPROVED BY THE DATA ADMINISTRATION GROUP.    *
//*****************************************************************
//MPBSTEP  EXEC PGM=&PGMNAME,REGION=8M,
//             PARM='&CYCLE.&SETPER'
//STEPLIB  DD DSN=&LOADLIB,DISP=SHR
//         DD DSN=TELCABS.CABS.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//         DD DSN=SYS1.COB2LIB,DISP=SHR
//CIRCMAST DD DSN=TELCABS.SETL.CIRCUIT,DISP=SHR
//CDRIN    DD DSN=TELCABS.CABS.CDR.PLU(&INGDG),DISP=SHR
//MPBEXT   DD DSN=TELCABS.SETL.&OUTDD(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(CYL,(20,10),RLSE),
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//CTLOUT   DD DSN=TELCABS.SETL.RUNCTL(+1),DISP=(MOD,KEEP)
//SUSPOUT  DD DSN=TELCABS.SETL.SUSPENSE(+1),DISP=(MOD,KEEP)
//REPORT   DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//SYSIN    DD *
RN&RUNID.&CYCLE.&BILLPER.00MPBEXTR MPBSTEP  NN&SETPER.N
/*
//         PEND
