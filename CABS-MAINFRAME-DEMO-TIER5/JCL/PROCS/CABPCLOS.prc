//CABPCLOS PROC PGMNAME=,CYCLE=,BILLPER=,RUNID=,RERUN=00,
//             JOBNM=,STEPNM=CLSSTEP,CLSPER=,CLSDT=,
//             LEDGCO=,SIGNOF=,
//             INGDG='0',OUTGDG='+1',
//             LOADLIB=TELCABS.CABS.LOADLIB
//*****************************************************************
//* CABPCLOS - MONTH END CLOSE FRAGMENT                           *
//*                                                               *
//* USED BY CABS6400 AND BY THE CLOSE STREAM CABS7000.            *
//* SHARED MEMBERS ARE CHANGED THROUGH OPERATIONS SUPPORT ONLY.   *
//*                                                               *
//* SIGNOF IS THE INITIALS OF THE PERSON AUTHORISING THE CLOSE.   *
//* THE SCHEDULER PROMPTS FOR IT AT SUBMISSION.  THE STEP WILL    *
//* NOT RUN WITHOUT A NAMED PERSON AGAINST THE CLOSE.             *
//* VALUES ARE SUPPLIED BY THE SCHEDULER PER CABS-STD-022.        *
//*                                                               *
//* CLOSEMS POINTS AT TELCABS.CABS.CLOSEMST, WHICH IS DEFINED BY  *
//* CABVDEF6 AND IS READ BY THE GENERAL LEDGER INTERFACE.  THAT   *
//* INTERFACE IS NOT PART OF THIS ESTATE.                         *
//*****************************************************************
//CLSSTEP  EXEC PGM=&PGMNAME,REGION=8M,
//             PARM='&CYCLE.&CLSPER'
//STEPLIB  DD DSN=TELCABS.CABS.EMERG.LOADLIB,DISP=SHR
//         DD DSN=&LOADLIB,DISP=SHR
//         DD DSN=TELCABS.SETL.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//         DD DSN=SYS1.COB2LIB,DISP=SHR
//BHDRIN   DD DSN=TELCABS.CABS.BILLHDR.FIN(&INGDG),DISP=SHR
//CTLIN    DD DSN=TELCABS.CABS.CONTROL(&INGDG),DISP=SHR
//CLOSEMS  DD DSN=TELCABS.CABS.CLOSEMST,DISP=SHR
//CLSOUT   DD SYSOUT=*
//CTLOUT   DD DSN=TELCABS.CABS.CONTROL(&OUTGDG),
//             DISP=(MOD,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(5,5),RLSE),
//             DCB=(RECFM=FB,LRECL=180,BLKSIZE=0)
//SUSPOUT  DD DSN=TELCABS.CABS.BILL.SUSP(&OUTGDG),
//             DISP=(MOD,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(15,15),RLSE),
//             DCB=(RECFM=FB,LRECL=300,BLKSIZE=0)
//REPORT   DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//SYSIN    DD *
RN&RUNID.&CYCLE.&BILLPER.&RERUN.&JOBNM.&STEPNM.NN&CLSPER.&CLSDT.&LEDGCO.&SIGNOF
/*
//         PEND
