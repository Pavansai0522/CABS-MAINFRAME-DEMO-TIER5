//CABPDB2P PROC PGMNAME=,CYCLE=,BILLPER=,RUNID=,
//             SUBSYS=DSN1,PLAN=,COMMIT='00500',
//             INGDG='0',DB2ONLY=N,
//             LOADLIB=TELCABS.CABS.LOADLIB
//*****************************************************************
//* CABPDB2P - DB2 POSTING FRAGMENT                               *
//*                                                               *
//* INCLUDED BY CABJ1900 (RESTATEMENT POSTING), CABS3100 (PERIOD  *
//* CLOSE) AND CABS3200 (SETTLEMENT POSTING).  THE PLAN NAME AND  *
//* THE SUBSYSTEM ARE SYMBOLICS - THE SAME PROGRAM CAN BE BOUND   *
//* AGAINST A DIFFERENT PLAN IN A DIFFERENT ENVIRONMENT AND THE   *
//* JCL WILL NOT SHOW WHICH ONE RAN.                              *
//* THE PROC LIBRARY IS CATALOGUED PER CABS-STD-024.              *
//* PARAMETER HANDLING PER CABS-STD-022.                          *
//*                                                               *
//* THESE PROGRAMS UPDATE A DB2 TABLE AND A VSAM FILE IN THE SAME *
//* LOGICAL UNIT OF WORK.  THE COMMIT COVERS DB2 ONLY.  AN ABEND  *
//* BETWEEN THE TWO LEAVES THEM OUT OF STEP.                      *
//*****************************************************************
//DB2STEP  EXEC PGM=IKJEFT01,DYNAMNBR=20,REGION=8M
//STEPLIB  DD DSN=&LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//         DD DSN=DSN810.SDSNLOAD,DISP=SHR
//         DD DSN=SYS1.COB2LIB,DISP=SHR
//ADJIN    DD DSN=TELCABS.CABS.RESTATE.ADJ(&INGDG),DISP=SHR
//BALMAST  DD DSN=TELCABS.CABS.BALANCE,DISP=SHR
//CTLOUT   DD DSN=TELCABS.CABS.RUNCTL(+1),DISP=(MOD,KEEP)
//SUSPOUT  DD DSN=TELCABS.CABS.SUSPENSE(+1),DISP=(MOD,KEEP)
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//SYSTSIN  DD *
  DSN SYSTEM(&SUBSYS)
  RUN PROGRAM(&PGMNAME) PLAN(&PLAN) -
      LIB('&LOADLIB')
  END
/*
//SYSIN    DD *
RN&RUNID.&CYCLE.&BILLPER.00DB2POST  DB2STEP &DB2ONLY.N&COMMIT
/*
//         PEND
