//CABPBADJ PROC PGMNAME=,CYCLE=,BILLPER=,RUNID=,RERUN=00,
//             JOBNM=,STEPNM=ADJSTEP,RSTSW=Y,DSPSW=Y,
//             MAXADJ='000000000.00',NETSW=Y,RESIDSW=N,
//             SETPER=,MINNET='0000000.00',
//             INGDG='0',OUTGDG='+1',
//             LOADLIB=TELCABS.CABS.LOADLIB
//*****************************************************************
//* CABPBADJ - ADJUSTMENT AND SETTLEMENT NETTING FRAGMENT         *
//*                                                               *
//* USED BY CABS4250 (ADJUSTMENTS) AND CABS4300 (SETTLEMENT       *
//* NETTING).  THE TWO JOBS USE DIFFERENT HALVES OF THE SYMBOLIC  *
//* LIST AND EACH OVERRIDES THE DD IT ACTUALLY READS.             *
//* SHARED MEMBERS ARE CHANGED THROUGH OPERATIONS SUPPORT ONLY.   *
//*                                                               *
//* SETLIN POINTS AT TELCABS.SETL.NET, A DATASET OWNED BY THE     *
//* SETTLEMENT APPLICATION.                                       *
//*****************************************************************
//ADJSTEP  EXEC PGM=&PGMNAME,REGION=8M,
//             PARM='&CYCLE.&BILLPER'
//STEPLIB  DD DSN=TELCABS.CABS.EMERG.LOADLIB,DISP=SHR
//         DD DSN=&LOADLIB,DISP=SHR
//         DD DSN=TELCABS.SETL.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//         DD DSN=SYS1.COB2LIB,DISP=SHR
//BHDRIN   DD DSN=TELCABS.CABS.BILLHDR(&INGDG),DISP=SHR
//ADJIN    DD DSN=TELCABS.CABS.ADJUST(&INGDG),DISP=SHR
//SETLIN   DD DSN=TELCABS.SETL.NET(&INGDG),DISP=SHR
//BHDROUT  DD DSN=TELCABS.CABS.BILLHDR.ADJ(&OUTGDG),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(CYL,(10,5),RLSE),
//             DCB=(RECFM=FB,LRECL=400,BLKSIZE=0)
//CTLOUT   DD DSN=TELCABS.CABS.CONTROL(&OUTGDG),
//             DISP=(MOD,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(5,5),RLSE),
//             DCB=(RECFM=FB,LRECL=180,BLKSIZE=0)
//SUSPOUT  DD DSN=TELCABS.CABS.BILL.SUSP(&OUTGDG),
//             DISP=(MOD,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(15,15),RLSE),
//             DCB=(RECFM=FB,LRECL=300,BLKSIZE=0)
//REPORT   DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//SYSIN    DD *
RN&RUNID&CYCLE&BILLPER&RERUN&JOBNM&STEPNM&RSTSW&DSPSW&MAXADJ&SETPER&MINNET
/*
//         PEND
