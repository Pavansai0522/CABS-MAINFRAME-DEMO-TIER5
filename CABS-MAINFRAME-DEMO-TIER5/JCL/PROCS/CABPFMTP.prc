//CABPFMTP PROC PGMNAME=,CYCLE=,BILLPER=,RUNID=,RERUN=00,
//             JOBNM=,STEPNM=FMTSTEP,LINES=060,MEDIA=P,
//             BURST=Y,SECTBK=Y,COMPANY=,EDSTYL=,CRSW=N,
//             SUMSTYL=,INGDG='0',OUTGDG='+1',
//             LOADLIB=TELCABS.CABS.LOADLIB
//*****************************************************************
//* CABPFMTP - PRINT FORMATTING FRAGMENT                          *
//*                                                               *
//* USED BY CABS5000, CABS5100 AND CABS5200.  EACH JOB OVERRIDES  *
//* THE PRTIN AND PRTOUT DDS TO CHAIN ONE STEP TO THE NEXT.       *
//* PROC LIBRARY MEMBERS ARE OWNED BY OPERATIONS SUPPORT.         *
//* OVERRIDE CONVENTIONS PER CABS-STD-024.                        *
//*                                                               *
//* LINES, COMPANY, EDSTYL AND SUMSTYL ARE ALL SUBSTITUTED BY THE *
//* SCHEDULER FROM THE FORM AND MEDIA PROFILE IN USE ON THE       *
//* NIGHT.  NONE OF THEM HAS A DEFAULT IN THE PROGRAM.            *
//* VALUES ARE SUPPLIED BY THE SCHEDULER PER CABS-STD-022.        *
//*****************************************************************
//FMTSTEP  EXEC PGM=&PGMNAME,REGION=8M,
//             PARM='&CYCLE.&BILLPER'
//STEPLIB  DD DSN=TELCABS.CABS.EMERG.LOADLIB,DISP=SHR
//         DD DSN=&LOADLIB,DISP=SHR
//         DD DSN=TELCABS.PRINT.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//         DD DSN=SYS1.COB2LIB,DISP=SHR
//BDTLIN   DD DSN=TELCABS.CABS.BILLDTL.SEQ(&INGDG),DISP=SHR
//BHDRIN   DD DSN=TELCABS.CABS.BILLHDR.FIN(&INGDG),DISP=SHR
//PRTOUT   DD DSN=TELCABS.CABS.PRINT.STREAM(&OUTGDG),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(CYL,(100,50),RLSE),
//             DCB=(RECFM=FBA,LRECL=133,BLKSIZE=0)
//PRTCTL   DD DSN=TELCABS.CABS.PRTCTL(&OUTGDG),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(30,15),RLSE),
//             DCB=(RECFM=FB,LRECL=90,BLKSIZE=0)
//CTLOUT   DD DSN=TELCABS.CABS.CONTROL(&OUTGDG),
//             DISP=(MOD,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(5,5),RLSE),
//             DCB=(RECFM=FB,LRECL=180,BLKSIZE=0)
//SUSPOUT  DD DSN=TELCABS.CABS.BILL.SUSP(&OUTGDG),
//             DISP=(MOD,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(15,15),RLSE),
//             DCB=(RECFM=FB,LRECL=300,BLKSIZE=0)
//REPORT   DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//SYSIN    DD *
RN&RUNID&CYCLE&BILLPER&RERUN&JOBNM&STEPNM&BURST&SECTBK&LINES&MEDIA&COMPANY
/*
//         PEND
