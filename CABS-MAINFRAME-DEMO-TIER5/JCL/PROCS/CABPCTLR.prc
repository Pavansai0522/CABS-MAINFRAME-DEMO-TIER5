//CABPCTLR PROC CYCLE=000000,RUNID=00
//*****************************************************************
//* CABPCTLR - CONTROL RECORD RECONCILIATION / REPORT PROC.      *
//* READS THE DAY'S CTLOUT GENERATIONS ACROSS THE WHOLE STREAM   *
//* AND PRINTS THE BALANCING EQUATION RESULT PER PROGRAM.        *
//*****************************************************************
//STEP1    EXEC PGM=CABCTLRP,REGION=4M,
//             PARM='&CYCLE,&RUNID'
//STEPLIB  DD DSN=TELCABS.CABS.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//CTLIN    DD DSN=TELCABS.CABS.CONTROL(0),DISP=SHR
//RPTOUT   DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
