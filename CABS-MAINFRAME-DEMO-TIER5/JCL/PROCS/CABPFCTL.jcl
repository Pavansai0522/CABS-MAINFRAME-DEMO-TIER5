//CABPFCTL PROC CYCLE=,BILLPER=,RUNID=,RERUN=00,
//             GDGIN='0',LOADLIB=TELCABS.CABS.LOADLIB
//*****************************************************************
//* CABPFCTL - PIU/PLU FACTOR LOAD AND VALIDATION FRAGMENT        *
//*                                                               *
//* USED BY CABJ1000 (QUARTERLY FACTOR LOAD) AND BY CABJ1100      *
//* (FACTOR VALIDATION ONLY).  THE TWO JOBS PASS DIFFERENT        *
//* SYMBOLIC VALUES AND OVERRIDE DIFFERENT DD STATEMENTS, SO THE  *
//* SAME PROC BEHAVES DIFFERENTLY DEPENDING ON WHERE IT IS        *
//* INCLUDED.                                                     *
//*                                                               *
//* CYCLE, BILLPER AND RUNID HAVE NO DEFAULT.  THE SCHEDULER      *
//* SUBSTITUTES THEM AT SUBMISSION TIME.  A JOB THAT DOES NOT     *
//* SUPPLY THEM FAILS JCL CONVERSION - IT DOES NOT DEFAULT.       *
//* SCHEDULER SUBSTITUTION RULES ARE IN CABS-STD-022.             *
//*****************************************************************
//FCTLOAD  EXEC PGM=CABJUR01,REGION=4M,
//             PARM='&CYCLE'
//STEPLIB  DD DSN=&LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//         DD DSN=SYS1.COB2LIB,DISP=SHR
//FCTRIN   DD DSN=TELCABS.CABS.FACTOR.IN(&GDGIN),DISP=SHR
//FCTRMAST DD DSN=TELCABS.CABS.FACTOR,DISP=SHR
//CARRMAST DD DSN=TELCABS.CABS.CARRIER,DISP=SHR
//CTLOUT   DD DSN=TELCABS.CABS.RUNCTL(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(5,5),RLSE),
//             DCB=(RECFM=FB,LRECL=180,BLKSIZE=0)
//SUSPOUT  DD DSN=TELCABS.CABS.SUSPENSE(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(15,15),RLSE),
//             DCB=(RECFM=FB,LRECL=300,BLKSIZE=0)
//SYSOUT   DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//SYSIN    DD DSN=TELCABS.CABS.CTLCARDS(FCTL&RERUN),DISP=SHR
//*
//FCTVAL   EXEC PGM=CABJUR02,REGION=4M,COND=(4,LT,FCTLOAD)
//STEPLIB  DD DSN=&LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//         DD DSN=SYS1.COB2LIB,DISP=SHR
//FCTRMAST DD DSN=TELCABS.CABS.FACTOR,DISP=SHR
//FCTRVAL  DD DSN=TELCABS.CABS.FACTOR.VAL(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(CYL,(5,5),RLSE),
//             DCB=(RECFM=FB,LRECL=76,BLKSIZE=0)
//FCTRQUAR DD DSN=TELCABS.CABS.FACTOR.QUAR(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(5,5),RLSE),
//             DCB=(RECFM=FB,LRECL=76,BLKSIZE=0)
//CTLOUT   DD DSN=TELCABS.CABS.RUNCTL(+1),DISP=(MOD,KEEP)
//SUSPOUT  DD DSN=TELCABS.CABS.SUSPENSE(+1),DISP=(MOD,KEEP)
//REPORT   DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//SYSIN    DD DUMMY
//         PEND
