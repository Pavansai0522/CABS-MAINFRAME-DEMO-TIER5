//CABJ2000 JOB (CABS,BILL),'JURISDICTION EXCEPTION REPORT',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//             NOTIFY=&SYSUID,REGION=0M,TIME=1440
//*****************************************************************
//* CABJ2000 - JURISDICTION EXCEPTION AND AUDIT REPORT            *
//*                                                               *
//* READS EVERY SUSPENSE RECORD AND EVERY CONTROL RECORD WRITTEN  *
//* BY THE JURISDICTION JOBS AND PRODUCES THE REGISTER THE        *
//* NIGHT SHIFT SIGNS OFF.  AN OUT OF BALANCE PROCESS STOPS THE   *
//* CYCLE.                                                        *
//*****************************************************************
//JOBLIB   DD DSN=TELCABS.CABS.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//         DD DSN=SYS1.COB2LIB,DISP=SHR
//*
//STEP010  EXEC PGM=CABJUR11,REGION=4M
//STEPLIB  DD DSN=TELCABS.CABS.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//         DD DSN=SYS1.COB2LIB,DISP=SHR
//SUSPIN   DD DSN=TELCABS.CABS.SUSPENSE(0),DISP=SHR
//CTLIN    DD DSN=TELCABS.CABS.RUNCTL(0),DISP=SHR
//EXCOUT   DD DSN=TELCABS.CABS.JURIS.EXC(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(30,15),RLSE),
//             DCB=(RECFM=FB,LRECL=300,BLKSIZE=0)
//CTLOUT   DD DSN=TELCABS.CABS.RUNCTL(+1),DISP=(MOD,KEEP)
//SUSPOUT  DD DSN=TELCABS.CABS.SUSPENSE(+1),DISP=(MOD,KEEP)
//REPORT   DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//SYSIN    DD *
RN%%RUNID  %%CYCLDT%%BILLPR00CABJ2000STEP010  NNW00058
/*
//
