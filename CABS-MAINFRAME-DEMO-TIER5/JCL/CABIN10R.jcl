//CABIN10R JOB (CABS,INGST),'L.FERREIRA',CLASS=B,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID,
//             REGION=4M,TIME=(5,0)
//*****************************************************************
//* CABIN10R - STANDALONE RERUN OF CABING10 (JURISDICTIONAL      *
//* PRE-EDIT / INDETERMINATE RESOLUTION).  USE AFTER A LATE       *
//* QUARTERLY PIU/PLU FACTOR LOAD TO REPRICE INDETERMINATE        *
//* JURISDICTION RECORDS FROM THE PRIOR CYCLE - READS (-1) SO IT  *
//* WORKS AGAINST THE ENRICHMENT THE FACTOR LOAD WAS MEANT FOR,   *
//* NOT WHATEVER TODAY'S MAIN STREAM HAS ALREADY PRODUCED.        *
//*****************************************************************
//*
//STEP010  EXEC CABPINGT,PGM=CABING10,CYCLE=&CYCLE,
//             BILLPER=&BILLPER,RUNID=&RUNID,MODE=&RERUN
//STEP010.ENRIN   DD DSN=TELCABS.CABS.USAGE.ENRICH(-1),DISP=SHR
//STEP010.FCTRIN  DD DSN=TELCABS.CABS.FACTOR,DISP=SHR
//STEP010.CARRMST DD DSN=TELCABS.CABS.CARRIER,DISP=SHR
//STEP010.JUROUT   DD DSN=TELCABS.CABS.USAGE.JURIS(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(10,10),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//
