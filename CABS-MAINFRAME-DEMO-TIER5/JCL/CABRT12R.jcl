//CABRT12R JOB (CABS,RATE),'K.ADEYEMI',CLASS=B,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID,
//             REGION=4M,TIME=(10,0),
//             RESTART=STEP010
//*****************************************************************
//* CABRT12R - STANDALONE RERUN OF CABRAT12 (RETRY).  AUDLOG      *
//* EXTEND - RETRY ATTEMPTS ARE READ BACK BY POSITION, NOT KEY,   *
//* SO RESUBMITTING THIS MEMBER AFTER A PARTIAL RUN APPENDS TO    *
//* THE SAME POSITIONAL SEQUENCE RATHER THAN RESTARTING IT -      *
//* RESTART=STEP010 IS DOCUMENTATION ONLY SINCE THIS IS A         *
//* SINGLE-STEP JOB, PER THE CAB-OPS-014 CONVENTION.               *
//*****************************************************************
//*
//STEP010  EXEC CABPRATE,PGM=CABRAT12,CYCLE=&CYCLE,
//             BILLPER=&BILLPER,RUNID=&RUNID,TARIFF=&TARIFF,
//             MODE=&RERUN
//STEP010.RATIN   DD DSN=TELCABS.CABS.RATED(0),DISP=SHR
//STEP010.RATOUT   DD DSN=TELCABS.CABS.RATED(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(15,15),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//STEP010.AUDLOG  DD DSN=TELCABS.CABS.AUDIT.LOG,DISP=MOD
//
