//CABCTLRP JOB (CABS,OPS),'A.BUKOWSKI',CLASS=B,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID,REGION=2M,
//             TIME=(5,0)
//*****************************************************************
//* CABCTLRP - CONTROL RECORD RECONCILIATION REPORT.  RUN AFTER  *
//* BOTH CABING01 AND CABRAT01 HAVE COMPLETED.  SELECTS ONLY THE *
//* CTLOUT RECORDS WHERE CT-BAL-IND IS NOT 'B' AND PRINTS THEM   *
//* FOR THE MORNING OPERATIONS REVIEW - A CLEAN NIGHT PRODUCES   *
//* AN EMPTY REPORT.                                             *
//*****************************************************************
//*
//* STEP010 - SELECT OUT-OF-BALANCE CONTROL RECORDS.  SEE
//* CABSRT08 FOR THE INCLUDE RULE AND ITS KNOWN 2014 CAVEAT.
//*
//STEP010  EXEC PGM=SORT,REGION=4M
//SORTIN   DD DSN=TELCABS.CABS.CONTROL(0),DISP=SHR
//SORTOUT  DD DSN=TELCABS.CABS.WORK.CTLEXC,
//             DISP=(NEW,PASS,DELETE),
//             SPACE=(CYL,(2,2),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=180,BLKSIZE=5400)
//SORTWK01 DD UNIT=SYSDA,SPACE=(CYL,(5,5))
//SYSIN    DD DSN=TELCABS.CABS.JCL.CTLCARDS(CABSRT08),DISP=SHR
//SYSOUT   DD SYSOUT=*
//*
//* STEP020 - PRINT THE EXCEPTION REPORT.  COND=(0,NE,STEP010)
//* MEANS THIS STEP IS BYPASSED ONLY IF THE SORT ITSELF FAILED,
//* NOT IF IT FOUND ZERO OUT-OF-BALANCE RECORDS (SORT RETURNS 0
//* EVEN WHEN SORTOUT IS EMPTY).
//*
//STEP020  EXEC CABPCTLR,CYCLE=&CYCLE,RUNID=&RUNID,
//             COND=(0,NE,STEP010)
//STEP020.CTLIN  DD DSN=TELCABS.CABS.WORK.CTLEXC,DISP=(OLD,DELETE)
//
