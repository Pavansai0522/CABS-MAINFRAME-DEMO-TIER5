//CABRAT5R JOB (CABS,RATE),'K.ADEYEMI',CLASS=B,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID,
//             REGION=4M,TIME=(10,0)
//*****************************************************************
//* CABRAT5R - STANDALONE RERUN OF CABRAT05 (UNBUNDLED NETWORK    *
//* ELEMENT RATING).  THE AUTO-REPRICE LOOP (P6100) BEHAVES THE   *
//* SAME WAY HERE AS IT DOES IN THE MAIN STREAM - THE ENABLING    *
//* SWITCH IS TAKEN FROM THE RATE MASTER IN BOTH CASES.           *
//*****************************************************************
//*
//STEP010  EXEC CABPRATE,PGM=CABRAT05,CYCLE=&CYCLE,
//             BILLPER=&BILLPER,RUNID=&RUNID,TARIFF=&TARIFF,
//             MODE=&RERUN
//STEP010.RATIN   DD DSN=TELCABS.CABS.RATED(0),DISP=SHR
//STEP010.RATEMST DD DSN=TELCABS.CABS.RATE,DISP=SHR
//STEP010.CIRCMST DD DSN=TELCABS.CABS.CIRCUIT,DISP=SHR
//STEP010.RATOUT   DD DSN=TELCABS.CABS.RATED(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(15,15),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//
