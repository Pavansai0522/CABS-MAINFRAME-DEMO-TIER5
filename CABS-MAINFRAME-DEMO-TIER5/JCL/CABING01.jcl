//CABING01 JOB (CABS,INGST),'D.OKONKWO',CLASS=A,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID,REGION=6M,
//             TIME=(15,0)
//*****************************************************************
//* CABING01 - DAILY INGEST STREAM                               *
//*                                                               *
//* RUNS EACH NIGHT AGAINST THE DAY'S RAW EMI-DERIVED ACCESS      *
//* USAGE FEED.  EDITS, VALIDATES, DEDUPLICATES, SPLITS BY USAGE  *
//* TYPE, RESOLVES CIRCUITS AND JURISDICTION, HANDLES CYCLE       *
//* CARRY-FORWARD, CONSOLIDATES AND CONSOLIDATES SUSPENSE.        *
//*                                                               *
//* &CYCLE, &BILLPER, &RUNID, &MODE AND &RERUN ARE PLAIN-TEXT     *
//* TOKENS IN THIS SOURCE MEMBER.  THE SCHEDULER PACKAGE REPLACES *
//* THEM WITH LITERAL VALUES BEFORE THE JOB IS HANDED TO THE      *
//* INTERNAL READER - THIS TEAM USES A SINGLE AMPERSAND, THE      *
//* SETL TEAM'S JCL USES A DOUBLE PERCENT (%%) FOR THE SAME       *
//* PURPOSE.  DO NOT SUBMIT THIS MEMBER UNEDITED.                 *
//*                                                               *
//* A FAILURE IN THE EDIT STEP (STEP020) BYPASSES EVERY STEP      *
//* DOWNSTREAM EXCEPT THE SUSPENSE CONSOLIDATION (STEP130) AND    *
//* THE CONTROL REPORT (STEP140), WHICH ALWAYS RUN.               *
//*****************************************************************
//*
//* STEP010 - SCRATCH YESTERDAY'S WORK DATASETS BEFORE THE GDG
//* GENERATIONS FOR TODAY ARE ALLOCATED BY EACH STEP'S OWN DD.
//*
//STEP010  EXEC PGM=IEFBR14
//SCRATCH1 DD DSN=TELCABS.CABS.WORK.SCRATCH,
//             DISP=(MOD,DELETE,DELETE),
//             SPACE=(CYL,(1,1)),UNIT=SYSDA
//*
//* STEP020 - CABING01 EDIT/FORMAT.  RAWIN IS THE CURRENT
//* GENERATION OF THE RAW FEED.  PARMIN CARRIES THE CYCLE DATE
//* AND MODE SO THE PROGRAM CAN APPLY THE 95-DAY BACK-DATE
//* WINDOW CORRECTLY EVEN ON A LATE-ARRIVING FEED.
//*
//STEP020  EXEC PGM=CABING01,REGION=4M
//STEPLIB  DD DSN=TELCABS.CABS.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//RAWIN    DD DSN=TELCABS.CABS.USAGE.RAW(0),DISP=SHR
//PARMIN   DD *
CYCLE=&CYCLE,BILLPER=&BILLPER,MODE=&MODE
/*
//EDTOUT   DD DSN=TELCABS.CABS.USAGE.EDITED(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(10,10),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//SUSOUT   DD DSN=TELCABS.CABS.USAGE.SUSPENSE(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(5,5),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=300,BLKSIZE=9000)
//CTLOUT   DD DSN=TELCABS.CABS.CONTROL(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(1,1),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=180,BLKSIZE=5400)
//RPTOUT   DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//*
//* STEP030 - SORT THE EDITED OUTPUT INTO OCN/BAN/SEQ ORDER AND
//* DROP FATAL EDIT-STATUS RECORDS AHEAD OF OCN/BAN VALIDATION.
//* USES CABSRT02 - SEE THE CARD ITSELF FOR THE OMIT RULE.
//*
//STEP030  EXEC PGM=SORT,REGION=4M,
//             COND=(4,LT,STEP020)
//SORTIN   DD DSN=TELCABS.CABS.USAGE.EDITED(0),DISP=SHR
//SORTOUT  DD DSN=TELCABS.CABS.USAGE.EDITED(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(10,10),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//SORTWK01 DD UNIT=SYSDA,SPACE=(CYL,(10,10))
//SORTWK02 DD UNIT=SYSDA,SPACE=(CYL,(10,10))
//SYSIN    DD DSN=TELCABS.CABS.JCL.CTLCARDS(CABSRT02),DISP=SHR
//SYSOUT   DD SYSOUT=*
//*
//* STEP040 - CABING02 OCN/BAN VALIDATION AGAINST THE CARRIER
//* MASTER.  THE SORT IN STEP030 GROUPS RECORDS BY OCN SO THE
//* PROGRAM'S IN-STORAGE OCN CACHE (ADDED V1.30, 1998) HELPS.
//*
//STEP040  EXEC PGM=CABING02,REGION=4M,
//             COND=(4,LT,STEP020)
//STEPLIB  DD DSN=TELCABS.CABS.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//EDTIN    DD DSN=TELCABS.CABS.USAGE.EDITED(0),DISP=SHR
//CARRMST  DD DSN=TELCABS.CABS.CARRIER,DISP=SHR
//VLDOUT   DD DSN=TELCABS.CABS.USAGE.VALID(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(10,10),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//SUSOUT   DD DSN=TELCABS.CABS.USAGE.SUSPENSE(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(5,5),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=300,BLKSIZE=9000)
//CTLOUT   DD DSN=TELCABS.CABS.CONTROL(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(1,1),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=180,BLKSIZE=5400)
//SYSOUT   DD SYSOUT=*
//*
//* STEP050 - CABING03 DUPLICATE / OUT-OF-SEQUENCE DETECTION.
//*
//STEP050  EXEC PGM=CABING03,REGION=4M,
//             COND=(4,LT,STEP020)
//STEPLIB  DD DSN=TELCABS.CABS.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//VLDIN    DD DSN=TELCABS.CABS.USAGE.VALID(0),DISP=SHR
//DUPOUT   DD DSN=TELCABS.CABS.USAGE.DEDUP(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(10,10),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//SUSOUT   DD DSN=TELCABS.CABS.USAGE.SUSPENSE(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(5,5),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=300,BLKSIZE=9000)
//CTLOUT   DD DSN=TELCABS.CABS.CONTROL(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(1,1),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=180,BLKSIZE=5400)
//SYSOUT   DD SYSOUT=*
//*
//* STEP060 - CABING04 YYDDD DATE VALIDATION (CONNECT/DISCONNECT).
//*
//STEP060  EXEC PGM=CABING04,REGION=4M,
//             COND=(4,LT,STEP020)
//STEPLIB  DD DSN=TELCABS.CABS.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//DUPIN    DD DSN=TELCABS.CABS.USAGE.DEDUP(0),DISP=SHR
//DTVOUT   DD DSN=TELCABS.CABS.USAGE.DATEVAL(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(10,10),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//SUSOUT   DD DSN=TELCABS.CABS.USAGE.SUSPENSE(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(5,5),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=300,BLKSIZE=9000)
//CTLOUT   DD DSN=TELCABS.CABS.CONTROL(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(1,1),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=180,BLKSIZE=5400)
//SYSOUT   DD SYSOUT=*
//*
//* STEP070 - SECOND SORT.  SUMS CONVERSATION MINUTES ACROSS
//* DUPLICATE OCN/BAN/CIRCUIT/USOC/CYCLE KEYS BEFORE THE USAGE
//* TYPE SPLIT - THE ESTATE'S ONLY DEDUP-BY-SUMMING RULE, AND IT
//* LIVES ONLY IN CABSRT03.  NO CABING PROGRAM KNOWS ABOUT IT.
//*
//STEP070  EXEC PGM=SORT,REGION=4M,
//             COND=(4,LT,STEP020)
//SORTIN   DD DSN=TELCABS.CABS.USAGE.DATEVAL(0),DISP=SHR
//SORTOUT  DD DSN=TELCABS.CABS.USAGE.DATEVAL(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(10,10),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//SORTWK01 DD UNIT=SYSDA,SPACE=(CYL,(10,10))
//SORTWK02 DD UNIT=SYSDA,SPACE=(CYL,(10,10))
//SYSIN    DD DSN=TELCABS.CABS.JCL.CTLCARDS(CABSRT03),DISP=SHR
//SYSOUT   DD SYSOUT=*
//*
//* STEP080 - CABING05 USAGE TYPE SPLIT (VOICE/DATA/SPECIAL) AND
//* THE CONSOLIDATED CLEAN STREAM USED BY RATING.
//*
//STEP080  EXEC PGM=CABING05,REGION=4M,
//             COND=(4,LT,STEP020)
//STEPLIB  DD DSN=TELCABS.CABS.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//DTVIN    DD DSN=TELCABS.CABS.USAGE.DATEVAL(0),DISP=SHR
//VOCOUT   DD DSN=TELCABS.CABS.USAGE.VOICE(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(10,10),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//DATOUT   DD DSN=TELCABS.CABS.USAGE.DATA(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(5,5),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=VB,LRECL=204,BLKSIZE=6236)
//SPCOUT   DD DSN=TELCABS.CABS.USAGE.SPCL(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(5,5),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//CLNOUT   DD DSN=TELCABS.CABS.USAGE.CLEAN(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(10,10),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//SUSOUT   DD DSN=TELCABS.CABS.USAGE.SUSPENSE(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(5,5),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=300,BLKSIZE=9000)
//CTLOUT   DD DSN=TELCABS.CABS.CONTROL(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(1,1),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=180,BLKSIZE=5400)
//SYSOUT   DD SYSOUT=*
//*
//* STEP090 - CABING06 CIRCUIT AND TRUNK GROUP RESOLUTION.
//*
//STEP090  EXEC PGM=CABING06,REGION=4M,
//             COND=(4,LT,STEP020)
//STEPLIB  DD DSN=TELCABS.CABS.LOADLIB.TEST,DISP=SHR
//         DD DSN=TELCABS.CABS.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//* TEST LIBRARY IS FIRST HERE WHILE THE MPB SPLIT FIX FROM
//* CHANGE CAB-2019-0447 IS BEING SOAKED - REMOVE AFTER SIGNOFF.
//CLNIN    DD DSN=TELCABS.CABS.USAGE.CLEAN(0),DISP=SHR
//CIRCMST  DD DSN=TELCABS.CABS.CIRCUIT,DISP=SHR
//ENROUT   DD DSN=TELCABS.CABS.USAGE.ENRICH(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(10,10),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//SUSOUT   DD DSN=TELCABS.CABS.USAGE.SUSPENSE(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(5,5),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=300,BLKSIZE=9000)
//CTLOUT   DD DSN=TELCABS.CABS.CONTROL(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(1,1),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=180,BLKSIZE=5400)
//SYSOUT   DD SYSOUT=*
//*
//* STEP100 - CABING10 JURISDICTIONAL PRE-EDIT / INDETERMINATE
//* RESOLUTION.  READS THE PIU/PLU FACTOR TABLE FOR RECORDS
//* WITHOUT A CLEAN NPA-BASED JURISDICTION DETERMINATION.
//*
//STEP100  EXEC PGM=CABING10,REGION=4M,
//             COND=(4,LT,STEP020)
//STEPLIB  DD DSN=TELCABS.CABS.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//ENRIN    DD DSN=TELCABS.CABS.USAGE.ENRICH(0),DISP=SHR
//FCTRIN   DD DSN=TELCABS.CABS.FACTOR,DISP=SHR
//CARRMST  DD DSN=TELCABS.CABS.CARRIER,DISP=SHR
//JUROUT   DD DSN=TELCABS.CABS.USAGE.JURIS(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(10,10),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//SUSOUT   DD DSN=TELCABS.CABS.USAGE.SUSPENSE(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(5,5),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=300,BLKSIZE=9000)
//CTLOUT   DD DSN=TELCABS.CABS.CONTROL(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(1,1),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=180,BLKSIZE=5400)
//SYSOUT   DD SYSOUT=*
//*
//* STEP110 - CABING08 CYCLE-BOUNDARY CARRY-FORWARD HANDLER.
//* CFWOUT IS OPENED EXTEND - PHYSICAL ORDER IS THE CYCLE
//* SEQUENCE AND THE RELEASE LOGIC ON THE NEXT RUN DEPENDS ON
//* READING CFWIN BACK IN THAT SAME ORDER.  DO NOT REORGANISE.
//*
//STEP110  EXEC PGM=CABING08,REGION=4M,
//             COND=(4,LT,STEP020)
//STEPLIB  DD DSN=TELCABS.CABS.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//CLNIN    DD DSN=TELCABS.CABS.USAGE.CLEAN(0),DISP=SHR
//CFWIN    DD DSN=TELCABS.CABS.USAGE.CFWD(0),DISP=SHR
//ENROUT   DD DSN=TELCABS.CABS.USAGE.ENRICH(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(10,10),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//CFWOUT   DD DSN=TELCABS.CABS.USAGE.CFWD(+1),DISP=MOD
//SUSOUT   DD DSN=TELCABS.CABS.USAGE.SUSPENSE(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(5,5),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=300,BLKSIZE=9000)
//CTLOUT   DD DSN=TELCABS.CABS.CONTROL(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(1,1),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=180,BLKSIZE=5400)
//SYSOUT   DD SYSOUT=*
//*
//* STEP120 - CABING09 DAILY CONSOLIDATION.  MERGES THE VOICE/
//* DATA/SPECIAL STREAMS FROM STEP080 STRAIGHT - IT DOES NOT SEE
//* THE CIRCUIT/JURISDICTION ENRICHMENT FROM STEP090/STEP100.
//*
//STEP120  EXEC PGM=CABING09,REGION=4M,
//             COND=(4,LT,STEP020)
//STEPLIB  DD DSN=TELCABS.CABS.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//VOCIN    DD DSN=TELCABS.CABS.USAGE.VOICE(0),DISP=SHR
//DATIN    DD DSN=TELCABS.CABS.USAGE.DATA(0),DISP=SHR
//SPCIN    DD DSN=TELCABS.CABS.USAGE.SPCL(0),DISP=SHR
//CONOUT   DD DSN=TELCABS.CABS.USAGE.CONSOL(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(10,10),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//CTLOUT   DD DSN=TELCABS.CABS.CONTROL(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(1,1),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=180,BLKSIZE=5400)
//RPTOUT   DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//*
//* STEP130 - CABING07 SUSPENSE CONSOLIDATION AND AUDIT LOGGING.
//* NO COND ON THIS STEP - IT RUNS EVEN WHEN STEP020 FAILED, SO
//* WHATEVER REACHED SUSPENSE BEFORE THE FAILURE STILL GETS
//* CONSOLIDATED AND REPORTED.  AUDLOG IS EXTEND - THE ORDER OF
//* THE THREE RECORDS WRITTEN PER RUN IS THE AUDIT TRAIL ITSELF,
//* READ BACK POSITIONALLY DOWNSTREAM.
//*
//STEP130  EXEC PGM=CABING07,REGION=4M
//STEPLIB  DD DSN=TELCABS.CABS.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//SUSIN    DD DSN=TELCABS.CABS.USAGE.SUSPENSE(0),DISP=SHR
//SUSOUT   DD DSN=TELCABS.CABS.USAGE.SUSPENSE(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(5,5),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=300,BLKSIZE=9000)
//AUDLOG   DD DSN=TELCABS.CABS.AUDIT.LOG,DISP=MOD
//CTLOUT   DD DSN=TELCABS.CABS.CONTROL(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(1,1),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=180,BLKSIZE=5400)
//RPTOUT   DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//*
//* STEP140 - CONTROL REPORT.  ALWAYS RUNS.  SUMMARISES THE
//* BALANCING EQUATION FOR EVERY CTLOUT RECORD WRITTEN THIS RUN.
//*
//STEP140  EXEC CABPCTLR,CYCLE=&CYCLE,RUNID=&RUNID
//
