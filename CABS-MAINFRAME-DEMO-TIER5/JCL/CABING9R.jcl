//CABING9R JOB (CABS,INGST),'L.FERREIRA',CLASS=B,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID,
//             REGION=4M,TIME=(5,0)
//*****************************************************************
//* CABING9R - STANDALONE RERUN OF CABING09 (DAILY               *
//* CONSOLIDATION).  FULL RERUN OF THE 3-WAY MERGE.               *
//*****************************************************************
//*
//* TYPICAL TRIGGER: STEP080 OF THE MAIN STREAM PRODUCED A
//* SHORT DATA-USAGE GENERATION BECAUSE THE BROADBAND FEED WAS
//* STILL LANDING WHEN THE STREAM RAN.  RERUN CABING09 ONCE
//* THE DATA GDG BASE HAS THE COMPLETE GENERATION - CABING09
//* DOES A STRAIGHT 3-WAY MERGE SO A SHORT INPUT PRODUCES A
//* SHORT (NOT WRONG) CONOUT, WHICH IS WHY IT OFTEN SLIPS BY
//* UNNOTICED UNTIL THE VOLUME REPORT IS REVIEWED.
//*
//*
//STEP010  EXEC CABPINGT,PGM=CABING09,CYCLE=&CYCLE,
//             BILLPER=&BILLPER,RUNID=&RUNID,MODE=&RERUN
//STEP010.VOCIN   DD DSN=TELCABS.CABS.USAGE.VOICE(0),DISP=SHR
//STEP010.DATIN   DD DSN=TELCABS.CABS.USAGE.DATA(0),DISP=SHR
//STEP010.SPCIN   DD DSN=TELCABS.CABS.USAGE.SPCL(0),DISP=SHR
//STEP010.CONOUT   DD DSN=TELCABS.CABS.USAGE.CONSOL(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(10,10),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//
