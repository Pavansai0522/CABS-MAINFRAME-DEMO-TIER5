//CABRT11R JOB (CABS,RATE),'A.BUKOWSKI',CLASS=B,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID,
//             REGION=4M,TIME=(10,0)
//*****************************************************************
//* CABRT11R - STANDALONE RERUN OF CABRAT11 (RECIPROCAL           *
//* COMPENSATION).  STEP010 RE-MERGES THE CURRENT RATED CHAIN     *
//* USING THE SAME MERGE/INCLUDE LOGIC AS CABSRT06 IN THE MAIN    *
//* STREAM - THE CYCLE LITERAL IN THAT CARD IS HAND MAINTAINED,   *
//* CONFIRM IT MATCHES &BILLPER BEFORE SUBMITTING OR THE INCLUDE  *
//* WILL SILENTLY DROP EVERY RECORD.                              *
//*****************************************************************
//*
//STEP010  EXEC PGM=SORT,REGION=4M
//SORTIN   DD DSN=TELCABS.CABS.RATED(0),DISP=SHR
//SORTOUT  DD DSN=TELCABS.CABS.RATED(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(15,15),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//SORTWK01 DD UNIT=SYSDA,SPACE=(CYL,(15,15))
//SYSIN    DD DSN=TELCABS.CABS.JCL.CTLCARDS(CABSRT06),DISP=SHR
//SYSOUT   DD SYSOUT=*
//*
//STEP020  EXEC CABPRATE,PGM=CABRAT11,CYCLE=&CYCLE,
//             BILLPER=&BILLPER,RUNID=&RUNID,TARIFF=&TARIFF,
//             MODE=&RERUN,COND=(4,LT,STEP010)
//STEP020.RATIN   DD DSN=TELCABS.CABS.RATED(0),DISP=SHR
//STEP020.RATEMST DD DSN=TELCABS.CABS.RATE,DISP=SHR
//STEP020.CARRMST DD DSN=TELCABS.CABS.CARRIER,DISP=SHR
//STEP020.RATOUT   DD DSN=TELCABS.CABS.RATED(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(15,15),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//
