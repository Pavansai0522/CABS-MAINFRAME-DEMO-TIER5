//CABGDGDF JOB (CABS,DBA),'S.MARCHETTI',CLASS=A,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID,REGION=4M,
//             TIME=(5,0)
//*****************************************************************
//* CABGDGDF - ONE-TIME (RE-RUNNABLE) GDG BASE AND VSAM CLUSTER   *
//* DEFINITION JOB FOR THE WHOLE INGEST/RATING ESTATE.  RUN THIS  *
//* AGAINST A NEW REGION BEFORE THE FIRST CABING01/CABRAT01       *
//* SUBMISSION.  SAFE TO RESUBMIT - STEP010 IGNORES 'ALREADY      *
//* DEFINED' RETURN CODES VIA SET MAXCC.                          *
//*****************************************************************
//*
//* STEP010 - DEFINE EVERY GDG BASE USED BY THE INGEST AND        *
//* RATING STREAMS.  LIMIT(15) SCRATCH NOEMPTY THROUGHOUT EXCEPT  *
//* WHERE NOTED - SUSPENSE AND CONTROL KEEP A LONGER HISTORY FOR  *
//* AUDIT.
//*
//STEP010  EXEC PGM=IDCAMS,REGION=4M
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DEFINE GENERATIONDATAGROUP -
      (NAME(TELCABS.CABS.USAGE.RAW) -
       LIMIT(10) -
       SCRATCH -
       NOEMPTY)
  DEFINE GENERATIONDATAGROUP -
      (NAME(TELCABS.CABS.USAGE.EDITED) -
       LIMIT(15) -
       SCRATCH -
       NOEMPTY)
  DEFINE GENERATIONDATAGROUP -
      (NAME(TELCABS.CABS.USAGE.VALID) -
       LIMIT(15) -
       SCRATCH -
       NOEMPTY)
  DEFINE GENERATIONDATAGROUP -
      (NAME(TELCABS.CABS.USAGE.DEDUP) -
       LIMIT(15) -
       SCRATCH -
       NOEMPTY)
  DEFINE GENERATIONDATAGROUP -
      (NAME(TELCABS.CABS.USAGE.DATEVAL) -
       LIMIT(15) -
       SCRATCH -
       NOEMPTY)
  DEFINE GENERATIONDATAGROUP -
      (NAME(TELCABS.CABS.USAGE.VOICE) -
       LIMIT(15) -
       SCRATCH -
       NOEMPTY)
  DEFINE GENERATIONDATAGROUP -
      (NAME(TELCABS.CABS.USAGE.DATA) -
       LIMIT(15) -
       SCRATCH -
       NOEMPTY)
  DEFINE GENERATIONDATAGROUP -
      (NAME(TELCABS.CABS.USAGE.SPCL) -
       LIMIT(15) -
       SCRATCH -
       NOEMPTY)
  DEFINE GENERATIONDATAGROUP -
      (NAME(TELCABS.CABS.USAGE.CLEAN) -
       LIMIT(15) -
       SCRATCH -
       NOEMPTY)
  DEFINE GENERATIONDATAGROUP -
      (NAME(TELCABS.CABS.USAGE.SUSPENSE) -
       LIMIT(30) -
       SCRATCH -
       NOEMPTY)
  DEFINE GENERATIONDATAGROUP -
      (NAME(TELCABS.CABS.USAGE.CFWD) -
       LIMIT(20) -
       SCRATCH -
       NOEMPTY)
  DEFINE GENERATIONDATAGROUP -
      (NAME(TELCABS.CABS.USAGE.ENRICH) -
       LIMIT(15) -
       SCRATCH -
       NOEMPTY)
  DEFINE GENERATIONDATAGROUP -
      (NAME(TELCABS.CABS.USAGE.JURIS) -
       LIMIT(15) -
       SCRATCH -
       NOEMPTY)
  DEFINE GENERATIONDATAGROUP -
      (NAME(TELCABS.CABS.USAGE.RECYCLE) -
       LIMIT(15) -
       SCRATCH -
       NOEMPTY)
  DEFINE GENERATIONDATAGROUP -
      (NAME(TELCABS.CABS.USAGE.CONSOL) -
       LIMIT(15) -
       SCRATCH -
       NOEMPTY)
  DEFINE GENERATIONDATAGROUP -
      (NAME(TELCABS.CABS.RATED) -
       LIMIT(20) -
       SCRATCH -
       NOEMPTY)
  DEFINE GENERATIONDATAGROUP -
      (NAME(TELCABS.CABS.BILLDTL) -
       LIMIT(20) -
       SCRATCH -
       NOEMPTY)
  DEFINE GENERATIONDATAGROUP -
      (NAME(TELCABS.CABS.SUMMARY) -
       LIMIT(20) -
       SCRATCH -
       NOEMPTY)
  DEFINE GENERATIONDATAGROUP -
      (NAME(TELCABS.CABS.CONTROL) -
       LIMIT(30) -
       SCRATCH -
       NOEMPTY)
  DEFINE GENERATIONDATAGROUP -
      (NAME(TELCABS.CABS.RATE.LOAD) -
       LIMIT(8) -
       SCRATCH -
       NOEMPTY)
  SET MAXCC = 0
/*
//*
//* STEP020 - DELETE/DEFINE THE FOUR VSAM KSDS MASTERS.  DELETE
//* IS CONDITIONAL (NOPURGE) - IF THE CLUSTER DOES NOT YET EXIST
//* THE RETURN CODE IS ABSORBED BY THE SET MAXCC AT THE END.
//*
//STEP020  EXEC PGM=IDCAMS,REGION=4M
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DELETE TELCABS.CABS.CARRIER CLUSTER PURGE
  DEFINE CLUSTER -
      (NAME(TELCABS.CABS.CARRIER) -
       INDEXED -
       KEYS(4 0) -
       RECORDSIZE(200 200) -
       CISZ(4096) -
       FREESPACE(10 10) -
       SHAREOPTIONS(2 3) -
       VOLUMES(SYSDA) -
       CYLINDERS(5 5)) -
      DATA -
      (NAME(TELCABS.CABS.CARRIER.DATA)) -
      INDEX -
      (NAME(TELCABS.CABS.CARRIER.INDEX))
  DELETE TELCABS.CABS.CIRCUIT CLUSTER PURGE
  DEFINE CLUSTER -
      (NAME(TELCABS.CABS.CIRCUIT) -
       INDEXED -
       KEYS(20 0) -
       RECORDSIZE(150 150) -
       CISZ(4096) -
       FREESPACE(10 15) -
       SHAREOPTIONS(2 3) -
       VOLUMES(SYSDA) -
       CYLINDERS(10 10)) -
      DATA -
      (NAME(TELCABS.CABS.CIRCUIT.DATA)) -
      INDEX -
      (NAME(TELCABS.CABS.CIRCUIT.INDEX))
  DELETE TELCABS.CABS.RATE CLUSTER PURGE
  DEFINE CLUSTER -
      (NAME(TELCABS.CABS.RATE) -
       INDEXED -
       KEYS(18 0) -
       RECORDSIZE(120 120) -
       CISZ(4096) -
       FREESPACE(15 20) -
       SHAREOPTIONS(2 3) -
       VOLUMES(SYSDA) -
       CYLINDERS(20 10)) -
      DATA -
      (NAME(TELCABS.CABS.RATE.DATA)) -
      INDEX -
      (NAME(TELCABS.CABS.RATE.INDEX))
  DELETE TELCABS.CABS.FACTOR CLUSTER PURGE
  DEFINE CLUSTER -
      (NAME(TELCABS.CABS.FACTOR) -
       INDEXED -
       KEYS(14 0) -
       RECORDSIZE(80 80) -
       CISZ(4096) -
       FREESPACE(10 10) -
       SHAREOPTIONS(2 3) -
       VOLUMES(SYSDA) -
       CYLINDERS(3 3)) -
      DATA -
      (NAME(TELCABS.CABS.FACTOR.DATA)) -
      INDEX -
      (NAME(TELCABS.CABS.FACTOR.INDEX))
  SET MAXCC = 0
/*
//
