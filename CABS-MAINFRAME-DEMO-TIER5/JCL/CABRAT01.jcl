//CABRAT01 JOB (CABS,RATE),'P.NAIR',CLASS=A,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID,REGION=6M,
//             TIME=(20,0),RESTART=STEP050
//*****************************************************************
//* CABRAT01 - RATING STREAM                                     *
//*                                                               *
//* RUNS AFTER THE DAILY INGEST STREAM HAS CATALOGUED A CLEAN     *
//* USAGE GENERATION.  LOADS THE RATE TABLE, RATES EVERY ELEMENT  *
//* TYPE (SWITCHED, SPECIAL, UNE, RECIPROCAL COMP), APPLIES       *
//* BANDING, MIN/MAX, MANUAL OVERRIDES AND OPERATOR SERVICES,     *
//* RETRIES SUSPENDED ITEMS, BUILDS BILL DETAIL AND SUMMARISES.   *
//*                                                               *
//* &CYCLE, &BILLPER, &RUNID, &TARIFF, &MODE AND &RERUN ARE       *
//* PLAIN-TEXT TOKENS RESOLVED BY THE SCHEDULER BEFORE SUBMISSION.*
//*                                                               *
//* RESTART=STEP050 ON THE JOB CARD ABOVE IS THE OPERATOR'S       *
//* DEFAULT RE-ENTRY POINT (CABRAT04, SPECIAL ACCESS) - THE MOST  *
//* COMMON RESTART POINT PER THE 2018 OPS RUNBOOK, BECAUSE THE    *
//* SPECIAL ACCESS RATE TABLE SEGMENT IS THE ONE THAT MOST OFTEN  *
//* ARRIVES LATE FROM THE CARRIER GATEWAY.
//*****************************************************************
//*
//* STEP010 - CABRAT01 RATE TABLE LOAD.  REFRESHES THE RATEMST
//* VSAM KSDS FROM THE TARIFF FILING RECEIVED OVERNIGHT.
//*
//STEP010  EXEC PGM=CABRAT01,REGION=4M,
//             PARM='&CYCLE,&TARIFF'
//STEPLIB  DD DSN=TELCABS.CABS.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//RTBLIN   DD DSN=TELCABS.CABS.RATE.LOAD(0),DISP=SHR
//RATEMST  DD DSN=TELCABS.CABS.RATE,DISP=SHR
//CTLOUT   DD DSN=TELCABS.CABS.CONTROL(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(1,1),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=180,BLKSIZE=5400)
//RPTOUT   DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//*
//* STEP020 - SORT CLEAN USAGE FOR RATING.  ORDERS BY OCN/
//* JURISDICTION/ELEMENT SO THE RATEMST CACHE IN STEP030 IS
//* EFFECTIVE.  MODS E15/E35 (SEE CABSRT04) REFORMAT AND FILTER.
//*
//STEP020  EXEC PGM=SORT,REGION=4M
//SORTIN   DD DSN=TELCABS.CABS.USAGE.CLEAN(0),DISP=SHR
//SORTOUT  DD DSN=TELCABS.CABS.RATED(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(15,15),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//SORTWK01 DD UNIT=SYSDA,SPACE=(CYL,(15,15))
//SORTWK02 DD UNIT=SYSDA,SPACE=(CYL,(15,15))
//SORTWK03 DD UNIT=SYSDA,SPACE=(CYL,(15,15))
//SYSIN    DD DSN=TELCABS.CABS.JCL.CTLCARDS(CABSRT04),DISP=SHR
//SYSOUT   DD SYSOUT=*
//*
//* STEP030 - CABRAT02 DISPATCHER.  DYNAMICALLY CALLS THE
//* ORIGINATING/TERMINATING ACCESS, LOCAL TRANSPORT, TANDEM
//* SWITCHING AND CARRIER COMMON LINE ELEMENT MODULES BASED ON
//* THE MODULE SUFFIX CARRIED IN THE LOADED RATE TABLE ENTRY -
//* THAT TARGET IS NOT STATICALLY RESOLVABLE FROM THE SOURCE.
//*
//STEP030  EXEC CABPRATE,PGM=CABRAT02,CYCLE=&CYCLE,
//             BILLPER=&BILLPER,RUNID=&RUNID,TARIFF=&TARIFF,
//             MODE=&MODE
//STEP030.RATIN   DD DSN=TELCABS.CABS.RATED(0),DISP=SHR
//STEP030.RATEMST DD DSN=TELCABS.CABS.RATE,DISP=SHR
//STEP030.CARRMST DD DSN=TELCABS.CABS.CARRIER,DISP=SHR
//STEP030.RATOUT   DD DSN=TELCABS.CABS.RATED(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(15,15),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//*
//* STEP040 - CABRAT03 SWITCHED ACCESS - FIVE ELEMENT RATER.
//* READS THE VOICE USAGE SPLIT DIRECTLY (NOT THE DISPATCHER'S
//* OUTPUT) - THIS PROGRAM PREDATES THE DISPATCHER BY 16 YEARS
//* AND WAS NEVER REWIRED WHEN CABRAT02 WAS ADDED IN 2003.
//* BUILDS ITS OWN INTERNAL SORT (SORTWK1) FOR THE BAN LEVEL-
//* BREAK BILL DETAIL BUILD - THAT IS A COBOL SORT VERB, NOT
//* THIS JCL'S SORT PROGRAM, SO NO CTLCARDS MEMBER IS NEEDED.
//*
//STEP040  EXEC CABPRATE,PGM=CABRAT03,CYCLE=&CYCLE,
//             BILLPER=&BILLPER,RUNID=&RUNID,TARIFF=&TARIFF,
//             MODE=&MODE
//STEP040.RATIN   DD DSN=TELCABS.CABS.USAGE.VOICE(0),DISP=SHR
//STEP040.RATEMST DD DSN=TELCABS.CABS.RATE,DISP=SHR
//STEP040.CARRMST DD DSN=TELCABS.CABS.CARRIER,DISP=SHR
//STEP040.RATOUT   DD DSN=TELCABS.CABS.RATED(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(15,15),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//STEP040.BDTLOUT  DD DSN=TELCABS.CABS.BILLDTL(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(10,10),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=VB,LRECL=1651,BLKSIZE=6240)
//STEP040.SORTWK1 DD UNIT=SYSDA,SPACE=(CYL,(10,10))
//*
//* STEP050 - CABRAT04 SPECIAL ACCESS RATING.
//*
//STEP050  EXEC CABPRATE,PGM=CABRAT04,CYCLE=&CYCLE,
//             BILLPER=&BILLPER,RUNID=&RUNID,TARIFF=&TARIFF,
//             MODE=&MODE
//STEP050.RATIN   DD DSN=TELCABS.CABS.RATED(0),DISP=SHR
//STEP050.RATEMST DD DSN=TELCABS.CABS.RATE,DISP=SHR
//STEP050.CARRMST DD DSN=TELCABS.CABS.CARRIER,DISP=SHR
//STEP050.RATOUT   DD DSN=TELCABS.CABS.RATED(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(15,15),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//*
//* STEP060 - CABRAT05 UNBUNDLED NETWORK ELEMENT (UNE) RATING.
//* THE AUTO-REPRICE LOOP (P6100) IS GATED BY THE REPRICE SWITCH
//* ON THE RATE MASTER, WHICH THE TARIFF GROUP OWNS.
//*
//STEP060  EXEC CABPRATE,PGM=CABRAT05,CYCLE=&CYCLE,
//             BILLPER=&BILLPER,RUNID=&RUNID,TARIFF=&TARIFF,
//             MODE=&MODE
//STEP060.RATIN   DD DSN=TELCABS.CABS.RATED(0),DISP=SHR
//STEP060.RATEMST DD DSN=TELCABS.CABS.RATE,DISP=SHR
//STEP060.CIRCMST DD DSN=TELCABS.CABS.CIRCUIT,DISP=SHR
//STEP060.RATOUT   DD DSN=TELCABS.CABS.RATED(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(15,15),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//*
//* STEP070 - CABRAT11 RECIPROCAL COMPENSATION.
//*
//STEP070  EXEC CABPRATE,PGM=CABRAT11,CYCLE=&CYCLE,
//             BILLPER=&BILLPER,RUNID=&RUNID,TARIFF=&TARIFF,
//             MODE=&MODE
//STEP070.RATIN   DD DSN=TELCABS.CABS.RATED(0),DISP=SHR
//STEP070.RATEMST DD DSN=TELCABS.CABS.RATE,DISP=SHR
//STEP070.CARRMST DD DSN=TELCABS.CABS.CARRIER,DISP=SHR
//STEP070.RATOUT   DD DSN=TELCABS.CABS.RATED(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(15,15),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//*
//* STEP080 - CABRAT06 BANDED RATES.  THE BAND BOUNDARIES COME
//* FROM THE R3 POOL ON THE RATE MASTER, NOT FROM THIS JCL.
//*
//STEP080  EXEC CABPRATE,PGM=CABRAT06,CYCLE=&CYCLE,
//             BILLPER=&BILLPER,RUNID=&RUNID,TARIFF=&TARIFF,
//             MODE=&MODE
//STEP080.RATIN   DD DSN=TELCABS.CABS.RATED(0),DISP=SHR
//STEP080.RATEMST DD DSN=TELCABS.CABS.RATE,DISP=SHR
//STEP080.RATOUT   DD DSN=TELCABS.CABS.RATED(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(15,15),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//*
//* STEP090 - CABRAT07 MINIMUM / MAXIMUM RATE ENFORCEMENT.
//*
//STEP090  EXEC CABPRATE,PGM=CABRAT07,CYCLE=&CYCLE,
//             BILLPER=&BILLPER,RUNID=&RUNID,TARIFF=&TARIFF,
//             MODE=&MODE
//STEP090.RATIN   DD DSN=TELCABS.CABS.RATED(0),DISP=SHR
//STEP090.RATEMST DD DSN=TELCABS.CABS.RATE,DISP=SHR
//STEP090.RATOUT   DD DSN=TELCABS.CABS.RATED(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(15,15),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//*
//* STEP100 - CABRAT08 MANUAL RATE OVERRIDES.  OVRIN IS THE
//* CARD-IMAGE OVERRIDE DECK MAINTAINED BY PRICING.  DD OVERRIDE
//* BELOW POINTS AT THE PRODUCTION OVERRIDE DECK - COMPARE THE
//* TEST OVERRIDE FROM THE SAME PROC IN CABRT8R.JCL.
//*
//STEP100  EXEC CABPRATE,PGM=CABRAT08,CYCLE=&CYCLE,
//             BILLPER=&BILLPER,RUNID=&RUNID,TARIFF=&TARIFF,
//             MODE=&MODE
//STEP100.RATIN   DD DSN=TELCABS.CABS.RATED(0),DISP=SHR
//STEP100.OVRIN   DD DSN=TELCABS.CABS.RATEOVR,DISP=SHR
//STEP100.RATOUT   DD DSN=TELCABS.CABS.RATED(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(15,15),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//*
//* STEP110 - CABRAT13 OPERATOR SERVICES ACCESS RATING.  KEPT IN
//* THE STREAM PER CABS-STD-022 SINCE THE 1998 TARIFF FILING;
//* R1-OPR-SVC-SW ON THE RATE MASTER SELECTS THE RATING PATH.
//*
//STEP110  EXEC CABPRATE,PGM=CABRAT13,CYCLE=&CYCLE,
//             BILLPER=&BILLPER,RUNID=&RUNID,TARIFF=&TARIFF,
//             MODE=&MODE
//STEP110.RATIN   DD DSN=TELCABS.CABS.RATED(0),DISP=SHR
//STEP110.RATEMST DD DSN=TELCABS.CABS.RATE,DISP=SHR
//STEP110.RATOUT   DD DSN=TELCABS.CABS.RATED(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(15,15),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//*
//* STEP120 - CABRAT12 RETRY.  AUDLOG EXTEND - RETRY ATTEMPTS
//* ARE READ BACK BY POSITION, NOT BY KEY.
//*
//STEP120  EXEC CABPRATE,PGM=CABRAT12,CYCLE=&CYCLE,
//             BILLPER=&BILLPER,RUNID=&RUNID,TARIFF=&TARIFF,
//             MODE=&MODE
//STEP120.RATIN   DD DSN=TELCABS.CABS.RATED(0),DISP=SHR
//STEP120.RATOUT   DD DSN=TELCABS.CABS.RATED(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(15,15),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//STEP120.AUDLOG  DD DSN=TELCABS.CABS.AUDIT.LOG,DISP=MOD
//*
//* STEP130 - CABRAT10 BILL DETAIL BUILD.  MOVES THE VARIABLE
//* BILL DETAIL RECORD (UP TO 40 ELEMENTS) TO A FIXED 500-BYTE
//* WORK AREA IN P5200 - SILENTLY TRUNCATES BEYOND ELEMENT 14.
//*
//STEP130  EXEC CABPRATE,PGM=CABRAT10,CYCLE=&CYCLE,
//             BILLPER=&BILLPER,RUNID=&RUNID,TARIFF=&TARIFF,
//             MODE=&MODE
//STEP130.RATIN   DD DSN=TELCABS.CABS.RATED(0),DISP=SHR
//STEP130.BDTLOUT  DD DSN=TELCABS.CABS.BILLDTL(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(10,10),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=VB,LRECL=1651,BLKSIZE=6240)
//*
//* STEP140 - CABRAT09 SUMMARY.  INTERNAL SORT (S400/S450) HIDES
//* THE LEVEL-BREAK SUPPRESSION RULE IN THE OUTPUT PROCEDURE.
//*
//STEP140  EXEC CABPRATE,PGM=CABRAT09,CYCLE=&CYCLE,
//             BILLPER=&BILLPER,RUNID=&RUNID,TARIFF=&TARIFF,
//             MODE=&MODE
//STEP140.BDTIN   DD DSN=TELCABS.CABS.BILLDTL(0),DISP=SHR
//STEP140.SUMOUT   DD DSN=TELCABS.CABS.SUMMARY(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(10,10),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//STEP140.SORTWK1 DD UNIT=SYSDA,SPACE=(CYL,(10,10))
//
