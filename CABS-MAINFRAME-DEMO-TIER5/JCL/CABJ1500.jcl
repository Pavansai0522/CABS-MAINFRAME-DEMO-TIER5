//CABJ1500 JOB (CABS,BILL),'DEFAULT FACTOR DERIVATION',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//             NOTIFY=&SYSUID,REGION=0M,TIME=1440
//*****************************************************************
//* CABJ1500 - DEFAULT FACTOR FALLBACK AND DERIVATION             *
//*                                                               *
//* RUNS AFTER THE FACTOR LOAD AND BEFORE THE PIU APPLICATION.    *
//* THE STUDY SWITCH ON THE CONTROL CARD SELECTS WHICH PSU        *
//* DERIVATION CABJUR06 USES.  THE VALUE IS SET BY THE FACTOR     *
//* ADMINISTRATION GROUP PER CABS-STD-022 - IT IS NOT DEFAULTED.  *
//*****************************************************************
//JOBLIB   DD DSN=TELCABS.CABS.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//         DD DSN=SYS1.COB2LIB,DISP=SHR
//*
//STEP010  EXEC PGM=CABJUR06,REGION=6M
//STEPLIB  DD DSN=TELCABS.CABS.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.CABS.LOADLIB.EMERG,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//         DD DSN=SYS1.COB2LIB,DISP=SHR
//CARRMAST DD DSN=TELCABS.CABS.CARRIER,DISP=SHR
//FCTRMAST DD DSN=TELCABS.CABS.FACTOR,DISP=SHR
//FCTRDEF  DD DSN=TELCABS.CABS.FACTOR.DEF(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(15,15),RLSE),
//             DCB=(RECFM=FB,LRECL=76,BLKSIZE=0)
//CTLOUT   DD DSN=TELCABS.CABS.RUNCTL(+1),DISP=(MOD,KEEP)
//SUSPOUT  DD DSN=TELCABS.CABS.SUSPENSE(+1),DISP=(MOD,KEEP)
//REPORT   DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//SYSIN    DD *
RN%%RUNID  %%CYCLDT%%BILLPR00CABJ1500STEP010  NN%%FCTEFF N
/*
//
