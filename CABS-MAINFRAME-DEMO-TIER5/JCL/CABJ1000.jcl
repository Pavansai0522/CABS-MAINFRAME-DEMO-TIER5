//CABJ1000 JOB (CABS,BILL),'QUARTERLY PIU/PLU FACTOR LOAD',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//             NOTIFY=&SYSUID,REGION=0M,TIME=1440
//*****************************************************************
//* CABJ1000 - QUARTERLY FACTOR LOAD AND VALIDATION               *
//*                                                               *
//* SCHEDULED ON THE FIRST WORKING DAY OF EACH QUARTER.  THE      *
//* FACTOR FILING FROM THE CARRIERS ARRIVES OVERNIGHT AND IS      *
//* CATALOGUED AS THE ZERO GENERATION OF TELCABS.CABS.FACTOR.IN.  *
//*                                                               *
//* %%CYCLDT, %%BILLPR AND %%RUNID ARE SUBSTITUTED BY THE         *
//* SCHEDULER AT SUBMISSION.  THEY HAVE NO DEFAULT ANYWHERE IN    *
//* THE PROC.  A MANUAL SUBMISSION WITHOUT THEM FAILS CONVERSION. *
//* PARAMETER HANDLING PER CABS-STD-022.                          *
//* GENERATION HANDLING PER CABS-STD-026.                         *
//*****************************************************************
//JOBLIB   DD DSN=TELCABS.CABS.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//         DD DSN=SYS1.COB2LIB,DISP=SHR
//*
//STEP010  EXEC CABPFCTL,
//             CYCLE=%%CYCLDT,
//             BILLPER=%%BILLPR,
//             RUNID=%%RUNID,
//             RERUN=%%RERUN,
//             GDGIN='0'
//*
//* DD OVERRIDE - THE QUARTERLY LOAD TAKES THE FILING FROM THE
//* CARRIER GATEWAY, NOT FROM THE DAILY FEED THE PROC POINTS AT.
//* DD OVERRIDES ARE AGREED WITH OPERATIONS SUPPORT.
//*
//FCTLOAD.FCTRIN DD DSN=TELCABS.CABS.FACTOR.QTR(0),DISP=SHR
//*
//STEP020  EXEC PGM=IDCAMS,COND=(4,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  LISTCAT ENTRIES(TELCABS.CABS.FACTOR.VAL) ALL
/*
//
