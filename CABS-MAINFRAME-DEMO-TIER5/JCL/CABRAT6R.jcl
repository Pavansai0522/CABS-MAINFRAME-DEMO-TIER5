//CABRAT6R JOB (CABS,RATE),'S.MARCHETTI',CLASS=B,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID,
//             REGION=4M,TIME=(10,0)
//*****************************************************************
//* CABRAT6R - STANDALONE RERUN OF CABRAT06 (BANDED RATES).       *
//* A RERUN MUST BE GIVEN THE SAME RATE MASTER GENERATION AS THE  *
//* ORIGINAL ATTEMPT.  THE BAND POOL IS REBUILT FROM THE R3       *
//* EXTRACT AT LOAD TIME, SO A DIFFERENT GENERATION CAN CHANGE    *
//* THE BANDING.  AGREED WITH THE TARIFF GROUP, CR-6104.          *
//*****************************************************************
//*
//STEP010  EXEC CABPRATE,PGM=CABRAT06,CYCLE=&CYCLE,
//             BILLPER=&BILLPER,RUNID=&RUNID,TARIFF=&TARIFF,
//             MODE=&RERUN
//STEP010.RATIN   DD DSN=TELCABS.CABS.RATED(0),DISP=SHR
//STEP010.RATEMST DD DSN=TELCABS.CABS.RATE,DISP=SHR
//STEP010.RATOUT   DD DSN=TELCABS.CABS.RATED(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(15,15),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//
