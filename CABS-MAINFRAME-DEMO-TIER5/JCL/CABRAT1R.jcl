//CABRAT1R JOB (CABS,RATE),'P.NAIR',CLASS=B,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID,
//             REGION=4M,TIME=(5,0)
//*****************************************************************
//* CABRAT1R - STANDALONE RERUN OF CABRAT01 (RATE TABLE LOAD).   *
//* USE WHEN THE OVERNIGHT TARIFF FILING ARRIVED LATE OR WAS     *
//* CORRECTED AND RESENT AFTER THE MAIN STREAM ALREADY RAN AND    *
//* RATED USAGE AGAINST A STALE RATEMST.  RELOADING RATEMST HERE  *
//* DOES NOT BY ITSELF REPRICE ANYTHING ALREADY RATED - FOLLOW    *
//* WITH THE RELEVANT ELEMENT-TYPE RERUN (CABRAT4R, CABRAT6R,     *
//* ETC) OR THE RESTATEMENT PROCESS DESCRIBED IN CABSFCTR.        *
//*****************************************************************
//*
//STEP010  EXEC PGM=CABRAT01,REGION=4M,
//             PARM='&CYCLE,&TARIFF'
//STEPLIB  DD DSN=TELCABS.CABS.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//RTBLIN   DD DSN=TELCABS.CABS.RATE.LOAD(0),DISP=SHR
//RATEMST  DD DSN=TELCABS.CABS.RATE,DISP=SHR
//CTLOUT   DD DSN=TELCABS.CABS.CONTROL(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(1,1),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=180,BLKSIZE=5400)
//RPTOUT   DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//
