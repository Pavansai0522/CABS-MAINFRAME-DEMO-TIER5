//CABS2900 JOB (CABS,BILL),'SETTLEMENT DISPUTE HANDLER',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//             NOTIFY=&SYSUID,REGION=0M,TIME=1440
//*****************************************************************
//* CABS2900 - SETTLEMENT DISPUTE HANDLER                         *
//*                                                               *
//* APPLIES THE DISPUTE TRANSACTIONS KEYED BY THE ACCESS          *
//* MANAGEMENT GROUP.  THE SETTLEMENT MASTER IS UPDATED IN PLACE  *
//* SO A RERUN AFTER A PART DONE RUN REAPPLIES TRANSACTIONS THAT  *
//* HAVE ALREADY BEEN APPLIED.                                    *
//*****************************************************************
//JOBLIB   DD DSN=TELCABS.SETL.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//         DD DSN=SYS1.COB2LIB,DISP=SHR
//*
//STEP010  EXEC PGM=CABSET10,REGION=6M
//STEPLIB  DD DSN=TELCABS.SETL.LOADLIB.EMERG,DISP=SHR
//         DD DSN=TELCABS.SETL.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//         DD DSN=SYS1.COB2LIB,DISP=SHR
//DISPIN   DD DSN=TELCABS.SETL.DISPUTE.IN(0),DISP=SHR
//SETLMAST DD DSN=TELCABS.SETL.SETTLE.MASTER,DISP=SHR
//DISPOUT  DD DSN=TELCABS.SETL.DISPUTE.LOG(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(15,15),RLSE),
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//CTLOUT   DD DSN=TELCABS.SETL.RUNCTL(+1),DISP=(MOD,KEEP)
//SUSPOUT  DD DSN=TELCABS.SETL.SUSPENSE(+1),DISP=(MOD,KEEP)
//REPORT   DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//SYSIN    DD *
RN%%RUNID  %%CYCLDT%%BILLPR00CABS2900STEP010  NN%%AUTODY
/*
//
