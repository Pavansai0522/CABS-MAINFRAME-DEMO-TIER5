//CABS2450 JOB (CABS,BILL),'WIRELESS TERMINATION SETTLE',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//             NOTIFY=&SYSUID,REGION=0M,TIME=1440
//*****************************************************************
//* CABS2450 - WIRELESS TERMINATION SETTLEMENT                    *
//*                                                               *
//* THIS JOB HAS RUN EVERY MONTH SINCE JUNE 2004.  THE WIRELESS   *
//* TERMINATION ARRANGEMENT WAS RENEGOTIATED IN JULY 2011 AND THE *
//* FEATURE SWITCH ON THE CONTROL CARD HAS BEEN SET BY THE        *
//* SETTLEMENT GROUP EVERY MONTH SINCE.  THE INPUT FILE IS        *
//* CATALOGUED BY THE EXTRACT AND THE OUTPUT FILE IS CATALOGUED   *
//* HERE.  THE STEP IS RETAINED PER CABS-STD-022 BECAUSE THE      *
//* SCHEDULE IS OWNED BY OPERATIONS AND A REMOVAL NEEDS A         *
//* SEPARATE CHANGE.                                              *
//*****************************************************************
//JOBLIB   DD DSN=TELCABS.SETL.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//         DD DSN=SYS1.COB2LIB,DISP=SHR
//*
//STEP010  EXEC PGM=CABSET06,REGION=6M
//STEPLIB  DD DSN=TELCABS.SETL.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.SETL.LOADLIB.EMERG,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//         DD DSN=SYS1.COB2LIB,DISP=SHR
//WIRELIN  DD DSN=TELCABS.SETL.WIRELESS.USAGE(0),DISP=SHR
//CARRMAST DD DSN=TELCABS.SETL.CARRIER,DISP=SHR
//WIRESET  DD DSN=TELCABS.SETL.WIRELESS.SETL(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(5,5),RLSE),
//             DCB=(RECFM=FB,LRECL=180,BLKSIZE=0)
//CTLOUT   DD DSN=TELCABS.SETL.RUNCTL(+1),DISP=(MOD,KEEP)
//SUSPOUT  DD DSN=TELCABS.SETL.SUSPENSE(+1),DISP=(MOD,KEEP)
//REPORT   DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//SYSIN    DD *
RN%%RUNID  %%CYCLDT%%BILLPR00CABS2450STEP010  NNN0.00000
/*
//
