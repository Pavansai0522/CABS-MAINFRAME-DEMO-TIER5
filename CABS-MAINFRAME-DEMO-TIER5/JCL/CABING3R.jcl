//CABING3R JOB (CABS,INGST),'D.OKONKWO',CLASS=B,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID,
//             REGION=4M,TIME=(5,0)
//*****************************************************************
//* CABING3R - STANDALONE RERUN OF CABING03 (DUPLICATE / OUT-OF- *
//* SEQUENCE DETECTION).  THE PROGRAM HEADER REQUIRES VLDIN BE   *
//* PRESORTED BY OCN/BAN/SEQ ON EVERY RERUN - STEP010 DOES THAT. *
//*****************************************************************
//*
//* STEP010 - PRESORT.  MUST COMPLETE CLEAN OR STEP020 IS SKIPPED.
//*
//STEP010  EXEC PGM=SORT,REGION=4M
//SORTIN   DD DSN=TELCABS.CABS.USAGE.VALID(0),DISP=SHR
//SORTOUT  DD DSN=TELCABS.CABS.USAGE.VALID(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(10,10),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//SORTWK01 DD UNIT=SYSDA,SPACE=(CYL,(10,10))
//SYSIN    DD DSN=TELCABS.CABS.JCL.CTLCARDS(CABSRT01),DISP=SHR
//SYSOUT   DD SYSOUT=*
//*
//* STEP020 - RERUN CABING03 AGAINST THE PRESORTED OUTPUT.
//*
//STEP020  EXEC CABPINGT,PGM=CABING03,CYCLE=&CYCLE,
//             BILLPER=&BILLPER,RUNID=&RUNID,MODE=&RERUN,
//             COND=(4,LT,STEP010)
//STEP020.VLDIN   DD DSN=TELCABS.CABS.USAGE.VALID(0),DISP=SHR
//STEP020.DUPOUT   DD DSN=TELCABS.CABS.USAGE.DEDUP(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(10,10),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//
