//CABJ1800 JOB (CABS,BILL),'JURISDICTIONAL SUMMARY',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//             NOTIFY=&SYSUID,REGION=0M,TIME=1440
//*****************************************************************
//* CABJ1800 - JURISDICTIONAL REVENUE SUMMARY                     *
//*                                                               *
//* THE SETLIN DD POINTS AT TELCABS.SETL.SETTLE.MASTER - A        *
//* DATASET OWNED BY THE SETTLEMENT APPLICATION.  THIS BILLING    *
//* JOB READS IT DIRECTLY TO BRING THE SETTLEMENT NET POSITION    *
//* INTO THE JURISDICTIONAL SUMMARY THAT FEEDS THE LEDGER.        *
//* THE SETTLEMENT BATCH WINDOW MUST HAVE FINISHED BEFORE THIS    *
//* STEP RUNS AND NOTHING ENFORCES THAT.                          *
//* THE INTERFACE AGREEMENT IS HELD BY THE APPLICATION OWNER.     *
//*****************************************************************
//JOBLIB   DD DSN=TELCABS.CABS.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.SETL.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//         DD DSN=SYS1.COB2LIB,DISP=SHR
//*
//STEP010  EXEC PGM=CABJUR09,REGION=8M
//STEPLIB  DD DSN=TELCABS.CABS.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.SETL.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//         DD DSN=SYS1.COB2LIB,DISP=SHR
//PLUIN    DD DSN=TELCABS.CABS.CDR.PLU(0),DISP=SHR
//SETLIN   DD DSN=TELCABS.SETL.SETTLE.MASTER,DISP=SHR
//JURSUM   DD DSN=TELCABS.CABS.JURIS.SUMM(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(CYL,(10,5),RLSE),
//             DCB=(RECFM=FB,LRECL=120,BLKSIZE=0)
//CTLOUT   DD DSN=TELCABS.CABS.RUNCTL(+1),DISP=(MOD,KEEP)
//SUSPOUT  DD DSN=TELCABS.CABS.SUSPENSE(+1),DISP=(MOD,KEEP)
//REPORT   DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//SYSIN    DD *
RN%%RUNID  %%CYCLDT%%BILLPR00CABJ1800STEP010  NNY%%BILLPR
/*
//
