//CABRAT4R JOB (CABS,RATE),'P.NAIR',CLASS=B,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID,
//             REGION=4M,TIME=(10,0)
//*****************************************************************
//* CABRAT4R - STANDALONE RERUN OF CABRAT04 (SPECIAL ACCESS       *
//* RATING).  MOST FREQUENT RERUN IN THE ESTATE - THE SPECIAL     *
//* ACCESS RATE SEGMENT ARRIVES LATE FROM THE CARRIER GATEWAY     *
//* MORE OFTEN THAN ANY OTHER ELEMENT TYPE (SEE THE JOB-CARD      *
//* RESTART= NOTE ON CABRAT01).                                   *
//*****************************************************************
//*
//STEP010  EXEC CABPRATE,PGM=CABRAT04,CYCLE=&CYCLE,
//             BILLPER=&BILLPER,RUNID=&RUNID,TARIFF=&TARIFF,
//             MODE=&RERUN
//STEP010.RATIN   DD DSN=TELCABS.CABS.RATED(0),DISP=SHR
//STEP010.RATEMST DD DSN=TELCABS.CABS.RATE,DISP=SHR
//STEP010.CARRMST DD DSN=TELCABS.CABS.CARRIER,DISP=SHR
//STEP010.RATOUT   DD DSN=TELCABS.CABS.RATED(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(15,15),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//
