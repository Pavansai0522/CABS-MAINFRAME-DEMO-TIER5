//CABRT10R JOB (CABS,RATE),'A.BUKOWSKI',CLASS=B,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID,
//             REGION=4M,TIME=(10,0)
//*****************************************************************
//* CABRT10R - STANDALONE RERUN OF CABRAT10 (BILL DETAIL BUILD).  *
//* STEP010 RESEQUENCES THE RATED CHAIN BY BAN/SECTION/LINE AND,  *
//* AS A SIDE EFFECT, ZEROES THE RETRY COUNT FIELD SO THE RERUN   *
//* DOES NOT INHERIT A STALE COUNT FROM THE FAILED ATTEMPT.       *
//*****************************************************************
//*
//STEP010  EXEC PGM=SORT,REGION=4M
//SORTIN   DD DSN=TELCABS.CABS.RATED(0),DISP=SHR
//SORTOUT  DD DSN=TELCABS.CABS.RATED(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(15,15),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//SORTWK01 DD UNIT=SYSDA,SPACE=(CYL,(15,15))
//SYSIN    DD DSN=TELCABS.CABS.JCL.CTLCARDS(CABSRT05),DISP=SHR
//SYSOUT   DD SYSOUT=*
//*
//STEP020  EXEC CABPRATE,PGM=CABRAT10,CYCLE=&CYCLE,
//             BILLPER=&BILLPER,RUNID=&RUNID,TARIFF=&TARIFF,
//             MODE=&RERUN,COND=(4,LT,STEP010)
//STEP020.RATIN   DD DSN=TELCABS.CABS.RATED(0),DISP=SHR
//STEP020.BDTLOUT  DD DSN=TELCABS.CABS.BILLDTL(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(10,10),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=VB,LRECL=1651,BLKSIZE=6240)
//
