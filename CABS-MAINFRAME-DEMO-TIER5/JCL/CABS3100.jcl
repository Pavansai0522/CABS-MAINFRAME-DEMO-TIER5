//CABS3100 JOB (CABS,BILL),'SETTLEMENT PERIOD CLOSE',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//             NOTIFY=&SYSUID,REGION=0M,TIME=1440
//*****************************************************************
//* CABS3100 - SETTLEMENT PERIOD CLOSE                            *
//*                                                               *
//* CLOSES THE SETTLEMENT PERIOD IN THE DB2 PERIOD TABLE AND IN   *
//* THE VSAM CLOSE FILE.  THE TWO UPDATES ARE NOT COORDINATED -   *
//* THE COMMIT COVERS DB2 ONLY AND THE VSAM WRITES ARE ALREADY    *
//* HARDENED WHEN IT IS TAKEN.                                    *
//* BOTH STORES ARE LISTED IN THE DATASET REGISTER.               *
//* OVERRIDE CONVENTIONS PER CABS-STD-024.                        *
//*****************************************************************
//STEP010  EXEC CABPDB2P,
//             PGMNAME=CABSET12,
//             CYCLE=%%CYCLDT,
//             BILLPER=%%BILLPR,
//             RUNID=%%RUNID,
//             SUBSYS=%%DB2SUB,
//             PLAN=%%DB2PLN,
//             LOADLIB=TELCABS.SETL.LOADLIB
//*
//DB2STEP.ADJIN    DD DUMMY,DCB=(RECFM=VB,LRECL=1651,BLKSIZE=12040)
//DB2STEP.BALMAST  DD DUMMY
//DB2STEP.NETIN    DD DSN=TELCABS.SETL.NET(0),DISP=SHR
//DB2STEP.CLOSEMST DD DSN=TELCABS.SETL.CLOSE,DISP=SHR
//DB2STEP.CTLOUT   DD DSN=TELCABS.SETL.RUNCTL(+1),DISP=(MOD,KEEP)
//DB2STEP.SUSPOUT  DD DSN=TELCABS.SETL.SUSPENSE(+1),DISP=(MOD,KEEP)
//DB2STEP.SYSIN    DD *
RN%%RUNID  %%CYCLDT%%BILLPR00CABS3100DB2STEP NN%%CLSPER N015
/*
//
