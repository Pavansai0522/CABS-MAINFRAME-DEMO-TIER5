//CABJ1700 JOB (CABS,BILL),'RESTATEMENT REVERSAL',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//             NOTIFY=&SYSUID,REGION=0M,TIME=1440
//*****************************************************************
//* CABJ1700 - RESTATEMENT REVERSAL                               *
//*                                                               *
//* BACKS OUT A RESTATEMENT THAT SHOULD NOT HAVE BEEN RAISED.     *
//* THE RUN IDENTIFIER OF THE RUN BEING REVERSED IS SUPPLIED BY   *
//* THE OPERATOR ON THE CONTROL CARD - THERE IS NO WAY FOR THE    *
//* PROGRAM TO WORK IT OUT AND NO CHECK THAT IT IS CORRECT.       *
//* THE SUBMISSION STANDARD IS CABS-STD-022 - NOTHING DEFAULTS.   *
//* THE RETENTION LIMIT IS SET IN THE DATASET REGISTER.           *
//*****************************************************************
//JOBLIB   DD DSN=TELCABS.CABS.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.CABS.LOADLIB.EMERG,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//         DD DSN=SYS1.COB2LIB,DISP=SHR
//*
//STEP010  EXEC PGM=CABJUR08,REGION=8M
//STEPLIB  DD DSN=TELCABS.CABS.LOADLIB.EMERG,DISP=SHR
//         DD DSN=TELCABS.CABS.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//         DD DSN=SYS1.COB2LIB,DISP=SHR
//ADJIN    DD DSN=TELCABS.CABS.RESTATE.ADJ(-1),DISP=SHR
//AUDTIN   DD DSN=TELCABS.CABS.RESTATE.AUDIT(-1),DISP=SHR
//REVOUT   DD DSN=TELCABS.CABS.RESTATE.REV(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(CYL,(50,25),RLSE),
//             DCB=(RECFM=VB,LRECL=1651,BLKSIZE=0)
//CTLOUT   DD DSN=TELCABS.CABS.RUNCTL(+1),DISP=(MOD,KEEP)
//SUSPOUT  DD DSN=TELCABS.CABS.SUSPENSE(+1),DISP=(MOD,KEEP)
//REPORT   DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//SYSIN    DD *
RN%%RUNID  %%CYCLDT%%BILLPR00CABJ1700STEP010  NN%%REVRUN100.0021
/*
//
