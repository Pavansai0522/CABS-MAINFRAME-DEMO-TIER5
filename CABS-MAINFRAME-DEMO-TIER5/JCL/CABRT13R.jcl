//CABRT13R JOB (CABS,RATE),'T.VANCE',CLASS=B,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID,
//             REGION=4M,TIME=(10,0)
//*****************************************************************
//* CABRT13R - STANDALONE RERUN OF CABRAT13 (OPERATOR SERVICES    *
//* ACCESS RATING).  RETAINED FOR COMPLETENESS AND FOR THE        *
//* OCCASIONAL AUDIT REQUEST TO PROVE THE LOGIC STILL COMPILES    *
//* AND RUNS CLEAN AGAINST CURRENT DATA.  R1-OPR-SVC-SW ON THE    *
//* RATE MASTER SELECTS THE RATING PATH AND IS OWNED BY THE       *
//* TARIFF GROUP, NOT BY OPERATIONS.                              *
//*****************************************************************
//*
//STEP010  EXEC CABPRATE,PGM=CABRAT13,CYCLE=&CYCLE,
//             BILLPER=&BILLPER,RUNID=&RUNID,TARIFF=&TARIFF,
//             MODE=&RERUN
//STEP010.RATIN   DD DSN=TELCABS.CABS.RATED(0),DISP=SHR
//STEP010.RATEMST DD DSN=TELCABS.CABS.RATE,DISP=SHR
//STEP010.RATOUT   DD DSN=TELCABS.CABS.RATED(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(15,15),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//
