//CABING4R JOB (CABS,INGST),'J.CASTILLO',CLASS=B,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID,
//             REGION=4M,TIME=(5,0)
//*****************************************************************
//* CABING4R - STANDALONE RERUN OF CABING04 (YYDDD DATE           *
//* VALIDATION).  FULL RERUN - READS THE CURRENT DEDUP GENERATION.*
//*****************************************************************
//*
//* TYPICAL TRIGGER: A CYCLE DATE OVERRIDE WAS APPLIED TO
//* CORRECT A BAD CYCLE STAMP AND CABING04'S FUTURE-DATE CHECK
//* (WHICH COMPARES AGAINST THE CYCLE DATE, NOT TODAY - SEE
//* THE V1.41 2014 REVISION NOTE) NEEDS TO RE-EVALUATE EVERY
//* RECORD AGAINST THE CORRECTED CYCLE.  FULL RERUN, NO
//* PARTIAL-RESTART OPTION EXISTS FOR THIS PROGRAM.
//*
//*
//STEP010  EXEC CABPINGT,PGM=CABING04,CYCLE=&CYCLE,
//             BILLPER=&BILLPER,RUNID=&RUNID,MODE=&RERUN
//STEP010.DUPIN   DD DSN=TELCABS.CABS.USAGE.DEDUP(0),DISP=SHR
//STEP010.DTVOUT   DD DSN=TELCABS.CABS.USAGE.DATEVAL(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(10,10),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//
