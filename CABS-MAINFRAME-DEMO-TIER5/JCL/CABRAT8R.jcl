//CABRAT8R JOB (CABS,RATE),'K.ADEYEMI',CLASS=B,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID,
//             REGION=4M,TIME=(10,0)
//*****************************************************************
//* CABRAT8R - STANDALONE RERUN OF CABRAT08 (MANUAL RATE          *
//* OVERRIDES).  DD OVERRIDE BELOW POINTS OVRIN AT THE PRICING    *
//* TEAM'S TEST OVERRIDE DECK RATHER THAN PRODUCTION - USED TO    *
//* VALIDATE A NEW OVERRIDE BEFORE IT IS PROMOTED.  COMPARE THE   *
//* PRODUCTION OVRIN DD IN THE MAIN STREAM'S STEP100.              *
//*****************************************************************
//*
//STEP010  EXEC CABPRATE,PGM=CABRAT08,CYCLE=&CYCLE,
//             BILLPER=&BILLPER,RUNID=&RUNID,TARIFF=&TARIFF,
//             MODE=&RERUN
//STEP010.RATIN   DD DSN=TELCABS.CABS.RATED(0),DISP=SHR
//STEP010.OVRIN   DD DSN=TELCABS.CABS.RATEOVR.TEST,DISP=SHR
//STEP010.RATOUT   DD DSN=TELCABS.CABS.RATED(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(15,15),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//
