//CABS7000 JOB (CABS,CLOS),'MONTH END CLOSE STREAM',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//             NOTIFY=&SYSUID,REGION=0M,TIME=1440,RESTART=%%RSTEP
//*****************************************************************
//* CABS7000 - MONTH END CLOSE STREAM                             *
//*                                                               *
//* THE STREAM THAT CHAINS THE WHOLE MONTH END TOGETHER.  IT      *
//* SUBMITS THE BILL CALCULATION, FORMAT AND REPORT JOBS IN ORDER *
//* THROUGH THE INTERNAL READER AND THEN RUNS THE CLOSE ITSELF.   *
//*                                                               *
//* THE RESTART PARAMETER ON THE JOB CARD IS SUBSTITUTED BY THE   *
//* SCHEDULER.  A NORMAL RUN SUBSTITUTES STEP010; A RESTART       *
//* SUBSTITUTES THE STEP THE OPERATOR NAMED.  THERE IS NO         *
//* DEFAULT - AN UNSUBSTITUTED RESTART IS A JCL ERROR, WHICH IS   *
//* WHAT CABS-STD-022 REQUIRES.                                   *
//*                                                               *
//* EVERY STEP BELOW IS CONDITIONAL ON THE ONE BEFORE IT.  THE    *
//* BALANCING REPORT SETS RETURN CODE 12 WHEN THE CYCLE DOES NOT  *
//* BALANCE, WHICH STOPS THE CLOSE AND THE PRINT RELEASE.         *
//*****************************************************************
//STEP010  EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT2   DD SYSOUT=(A,INTRDR)
//SYSUT1   DD DSN=TELCABS.CABS.JCLLIB(CABS4000),DISP=SHR
//         DD DSN=TELCABS.CABS.JCLLIB(CABS4100),DISP=SHR
//         DD DSN=TELCABS.CABS.JCLLIB(CABS4150),DISP=SHR
//         DD DSN=TELCABS.CABS.JCLLIB(CABS4200),DISP=SHR
//         DD DSN=TELCABS.CABS.JCLLIB(CABS4250),DISP=SHR
//         DD DSN=TELCABS.CABS.JCLLIB(CABS4300),DISP=SHR
//         DD DSN=TELCABS.CABS.JCLLIB(CABS4450),DISP=SHR
//         DD DSN=TELCABS.CABS.JCLLIB(CABS4400),DISP=SHR
//         DD DSN=TELCABS.CABS.JCLLIB(CABS4350),DISP=SHR
//         DD DSN=TELCABS.CABS.JCLLIB(CABS4500),DISP=SHR
//         DD DSN=TELCABS.CABS.JCLLIB(CABS4550),DISP=SHR
//         DD DSN=TELCABS.CABS.JCLLIB(CABS4600),DISP=SHR
//*
//*  WAIT FOR THE BILL CALCULATION STREAM.  THE SCHEDULER HOLDS
//*  THIS STEP UNTIL THE LAST NUMBERED INVOICE FILE IS CATALOGED.
//*
//STEP020  EXEC PGM=IEFBR14,COND=(0,NE)
//WAITON   DD DSN=TELCABS.CABS.BILLHDR.FIN(0),DISP=SHR
//*
//STEP030  EXEC PGM=IEBGENER,COND=(4,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT2   DD SYSOUT=(A,INTRDR)
//SYSUT1   DD DSN=TELCABS.CABS.JCLLIB(CABS5000),DISP=SHR
//         DD DSN=TELCABS.CABS.JCLLIB(CABS5100),DISP=SHR
//         DD DSN=TELCABS.CABS.JCLLIB(CABS5200),DISP=SHR
//         DD DSN=TELCABS.CABS.JCLLIB(CABS5300),DISP=SHR
//         DD DSN=TELCABS.CABS.JCLLIB(CABS5400),DISP=SHR
//         DD DSN=TELCABS.CABS.JCLLIB(CABS5500),DISP=SHR
//*
//*  THE BALANCING REPORT.  RUN IN LINE, NOT SUBMITTED, SO THAT
//*  ITS RETURN CODE GOVERNS THE STEPS THAT FOLLOW.
//*
//STEP040  EXEC CABPRPTB,
//             PGMNAME=CABRPT01,
//             CYCLE=%%CYCLDT,
//             BILLPER=%%BILLPR,
//             RUNID=%%RUNID,
//             JOBNM=CABS7000,
//             STEPNM=STEP040,
//             HALT=Y,
//             CHAIN=Y,
//             EXPPRC=%%EXPPRC,
//             INGDG='0',
//             OUTGDG='+1'
//RPTSTEP.BDTLIN   DD DUMMY
//RPTSTEP.CARRMST  DD DUMMY
//RPTSTEP.CTLIN    DD DSN=TELCABS.CABS.CONTROL(0),DISP=SHR
//         DD DSN=TELCABS.CABS.CONTROL(-1),DISP=SHR
//         DD DSN=TELCABS.CABS.CONTROL(-2),DISP=SHR
//         DD DSN=TELCABS.CABS.CONTROL(-3),DISP=SHR
//RPTSTEP.PROOFIN  DD DSN=TELCABS.CABS.BILLPROOF(0),DISP=SHR
//RPTSTEP.SYSIN    DD *
RN%%RUNID  %%CYCLDT%%BILLPR00CABS7000STEP040YYYY N%%EXPPRC
/*
//*
//*  THE REPORTING JOBS.  ONLY SUBMITTED WHEN THE CYCLE BALANCED.
//*
//STEP050  EXEC PGM=IEBGENER,COND=(4,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT2   DD SYSOUT=(A,INTRDR)
//SYSUT1   DD DSN=TELCABS.CABS.JCLLIB(CABS6100),DISP=SHR
//         DD DSN=TELCABS.CABS.JCLLIB(CABS6200),DISP=SHR
//         DD DSN=TELCABS.CABS.JCLLIB(CABS6300),DISP=SHR
//*
//*  THE PERIOD CLOSE.  RUN IN LINE.  IT WILL NOT CLOSE THE
//*  PERIOD IF ANY PROCESS IN THE MONTH WAS OUT OF BALANCE OR ANY
//*  INVOICE IS STILL HELD.
//*
//STEP060  EXEC CABPCLOS,
//             PGMNAME=CABRPT08,
//             CYCLE=%%CYCLDT,
//             BILLPER=%%BILLPR,
//             RUNID=%%RUNID,
//             JOBNM=CABS7000,
//             STEPNM=STEP060,
//             CLSPER=%%CLSPER,
//             CLSDT=%%CLSDT,
//             LEDGCO=%%LEDGCO,
//             SIGNOF=%%SIGNOF,
//             INGDG='0',
//             OUTGDG='+1',
//             COND=(4,LT)
//CLSSTEP.CTLIN    DD DSN=TELCABS.CABS.CONTROL(0),DISP=SHR
//         DD DSN=TELCABS.CABS.CONTROL(-1),DISP=SHR
//         DD DSN=TELCABS.CABS.CONTROL(-2),DISP=SHR
//         DD DSN=TELCABS.CABS.CONTROL(-3),DISP=SHR
//         DD DSN=TELCABS.CABS.CONTROL(-4),DISP=SHR
//CLSSTEP.CLOSEMS  DD DSN=TELCABS.CABS.CLOSEMST,DISP=OLD
//CLSSTEP.SYSIN    DD *
RN%%RUNID  %%CYCLDT%%BILLPR00CABS7000STEP060NN%%CLSPER%%CLSDT %%LEDGCO%%SIGNOF
/*
//*
//*  ROLL THE GENERATION GROUPS FORWARD AND TAKE THE ARCHIVE COPY.
//*
//STEP070  EXEC PGM=IDCAMS,COND=(4,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  REPRO INDATASET(TELCABS.CABS.BILLHDR.FIN(0)) -
        OUTDATASET(TELCABS.CABS.ARCHIVE.BILLHDR(+1))
  IF LASTCC = 0 THEN -
     REPRO INDATASET(TELCABS.CABS.BILLDTL.SEQ(0)) -
           OUTDATASET(TELCABS.CABS.ARCHIVE.BILLDTL(+1))
/*
//
