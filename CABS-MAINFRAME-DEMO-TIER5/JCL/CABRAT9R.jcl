//CABRAT9R JOB (CABS,RATE),'K.ADEYEMI',CLASS=B,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID,
//             REGION=4M,TIME=(10,0)
//*****************************************************************
//* CABRAT9R - STANDALONE RERUN OF CABRAT09 (SUMMARY).  STEP010   *
//* SORTS AND SUMS THE BILL DETAIL AND APPLIES THE ROUNDING SORT  *
//* EXIT (CABSE35B, SEE CABSRT07) BEFORE THE SUMMARY PROGRAM      *
//* RUNS - THIS IS THE ONLY POINT WHERE SUMMARY-LEVEL AMOUNTS ARE *
//* ROUNDED ANYWHERE IN THE ESTATE.                                *
//*****************************************************************
//*
//STEP010  EXEC PGM=SORT,REGION=4M
//SORTIN   DD DSN=TELCABS.CABS.BILLDTL(0),DISP=SHR
//SORTOUT  DD DSN=TELCABS.CABS.SUMMARY(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(10,10),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//SORTWK01 DD UNIT=SYSDA,SPACE=(CYL,(10,10))
//SYSIN    DD DSN=TELCABS.CABS.JCL.CTLCARDS(CABSRT07),DISP=SHR
//SYSOUT   DD SYSOUT=*
//*
//STEP020  EXEC CABPRATE,PGM=CABRAT09,CYCLE=&CYCLE,
//             BILLPER=&BILLPER,RUNID=&RUNID,TARIFF=&TARIFF,
//             MODE=&RERUN,COND=(4,LT,STEP010)
//STEP020.BDTIN   DD DSN=TELCABS.CABS.SUMMARY(0),DISP=SHR
//STEP020.SUMOUT   DD DSN=TELCABS.CABS.SUMMARY(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(10,10),RLSE),UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//
