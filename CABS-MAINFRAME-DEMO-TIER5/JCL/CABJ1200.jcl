//CABJ1200 JOB (CABS,BILL),'JURISDICTION DETERMINATION',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//             NOTIFY=&SYSUID,REGION=0M,TIME=1440
//*****************************************************************
//* CABJ1200 - JURISDICTION DETERMINATION                         *
//*                                                               *
//* DRIVES CABJUR03 THROUGH THE SHARED JURISDICTION FRAGMENT.     *
//* THE PROGRAM NAME AND THE OUTPUT DATASET SUFFIX ARE PASSED IN  *
//* AS SYMBOLICS, SO THIS JOB AND CABJ1300 AND CABJ1400 ALL USE   *
//* THE SAME PROC WITH DIFFERENT VALUES.                          *
//* PROC LIBRARY MEMBERS ARE OWNED BY OPERATIONS SUPPORT.         *
//* CONCATENATION ORDER SET BY THE 1996 LIBRARY REORGANISATION.   *
//*****************************************************************
//STEP010  EXEC CABPJURS,
//             PGMNAME=CABJUR03,
//             CYCLE=%%CYCLDT,
//             BILLPER=%%BILLPR,
//             RUNID=%%RUNID,
//             STEPSEQ=030,
//             OUTDD=CDR.JURIS,
//             INGDG='0'
//*
//* THE STATE OVERRIDE MODULES LIVE IN A SEPARATE LIBRARY THAT IS
//* CONCATENATED AHEAD OF EVERYTHING ELSE FOR THIS STEP ONLY.
//* CABJXCAL EXISTS IN BOTH THAT LIBRARY AND THE COMMON LIBRARY.
//* LIBRARY ORDER IS OWNED BY OPERATIONS SUPPORT.
//* OVERRIDE CONVENTIONS PER CABS-STD-024.
//*
//JURSTEP.STEPLIB DD DSN=TELCABS.CABS.LOADLIB.STATE,DISP=SHR
//         DD DSN=TELCABS.CABS.LOADLIB.EMERG,DISP=SHR
//         DD DSN=TELCABS.CABS.LOADLIB,DISP=SHR
//         DD DSN=TELCABS.COMMON.LOADLIB,DISP=SHR
//         DD DSN=SYS1.COB2LIB,DISP=SHR
//JURSTEP.SYSIN DD *
RN%%RUNID  %%CYCLDT%%BILLPR00CABJ1200JURSTEP  LY
/*
//
