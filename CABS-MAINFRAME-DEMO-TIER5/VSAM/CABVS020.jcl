//CABVS020 JOB (CABS,DBA),'CDR CLEAN ESDS DEFINE',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//             NOTIFY=&SYSUID,REGION=4M,TIME=(10,0)
//*****************************************************************
//* CABVS020 - DEFINE THE CDR CLEAN STAGING ESDS                  *
//*                                                               *
//* DEFINES TELCABS.CABS.CDR.CLEAN.ES, AN ENTRY-SEQUENCED STAGING *
//* AREA FOR CDR RECORDS THAT HAVE PASSED PRE-EDIT.  RECORD       *
//* LAYOUT IS CABSCDR - RECFM MATCHES THE STANDARD 200-BYTE       *
//* USAGE RECORD.                                                 *
//*                                                               *
//* ALLOCATED UNDER CR-4471 FOR THE 1994 EMI BRIDGE CONVERSION AS *
//* A STAGING POOL AHEAD OF THE OLD 42-XX FEED FORMAT BEING       *
//* RETIRED.  THE STANDARD USAGE.CLEAN GDG CHAIN (SEE CABGDGDF)   *
//* SUPERSEDED THIS AS THE OPERATIONAL CLEAN-STAGE DATASET WHEN   *
//* THE BRIDGE WAS DECOMMISSIONED.  RERUN THIS JOB ONLY ON A COLD *
//* START OF A NEW REGION - IN AN ESTABLISHED ENVIRONMENT THE     *
//* CLUSTER SHOULD ALREADY EXIST AND THE DEFINE WILL NO-OP.       *
//*                                                               *
//* REVISION HISTORY                                              *
//*   1994-08-09  D.OKONKWO     INITIAL ALLOCATION - CR-4471      *
//*   1995-01-30  D.OKONKWO     FREESPACE INCREASED DURING THE    *
//*                             BRIDGE CUTOVER WINDOW              *
//*   2001-11-06  P.NAIR        RECORDSIZE ALIGNED TO CABSCDR      *
//*                             V2.03 DATA SVC REDEFINE            *
//*****************************************************************
//STEP010  EXEC PGM=IDCAMS,REGION=4M
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  SET MAXCC = 0
  DELETE TELCABS.CABS.CDR.CLEAN.ES CLUSTER PURGE
  DEFINE CLUSTER -
      (NAME(TELCABS.CABS.CDR.CLEAN.ES) -
       NONINDEXED -
       RECORDSIZE(200 200) -
       FREESPACE(0 0) -
       SHAREOPTIONS(2 3) -
       VOLUMES(TELV04) -
       CYLINDERS(60 30) -
       SPEED) -
      DATA -
      (NAME(TELCABS.CABS.CDR.CLEAN.ES.DATA) -
       CISZ(4096))
  IF LASTCC > 4 THEN -
    SET MAXCC = 12
  ELSE -
    SET MAXCC = 0
/*
//*
//* STEP020 - LISTCAT.  RUN INFREQUENTLY - THIS CLUSTER IS NOT ON *
//* THE STANDARD OPERATIONS CHECKLIST BECAUSE NO CURRENT SCHEDULE *
//* ENTRY OPENS IT.  KEPT FOR THE COLD-START REBUILD PROCEDURE.   *
//*
//STEP020  EXEC PGM=IDCAMS,REGION=4M,COND=(4,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  LISTCAT ENTRIES(TELCABS.CABS.CDR.CLEAN.ES) ALL
/*
//*
//* STEP030 - PRINT THE FIRST FEW RECORDS IN CHARACTER FORMAT.    *
//* USEFUL ONLY IMMEDIATELY AFTER A COLD-START DEFINE WHEN THE    *
//* CLUSTER IS STILL EMPTY - THIS WILL RETURN NOTHING IN ANY      *
//* ESTABLISHED ENVIRONMENT AND IS NOT AN ERROR CONDITION.        *
//*
//STEP030  EXEC PGM=IDCAMS,REGION=4M,COND=(4,LT)
//SYSPRINT DD SYSOUT=*
//DDIN     DD DSN=TELCABS.CABS.CDR.CLEAN.ES,DISP=SHR
//SYSIN    DD *
  PRINT INFILE(DDIN) COUNT(10) CHARACTER
/*
//
