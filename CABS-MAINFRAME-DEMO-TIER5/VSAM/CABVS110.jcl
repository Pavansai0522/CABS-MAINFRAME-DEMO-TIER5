//CABVS110 JOB (CABS,DBA),'SUSPENSE ESDS DEFINE',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//             NOTIFY=&SYSUID,REGION=4M,TIME=(10,0)
//*****************************************************************
//* CABVS110 - DEFINE THE SUSPENSE RECORD ESDS                    *
//*                                                               *
//* DEFINES TELCABS.CABS.SUSPENSE.ES, AN ENTRY-SEQUENCED CLUSTER  *
//* SIZED FOR THE 300-BYTE CABS-SUSPENSE-RECORD LAYOUT SHARED     *
//* VIA CABSERR.  NOT TO BE CONFUSED WITH TELCABS.CABS.SUSPENSE,  *
//* THE GDG CHAIN THE INGEST AND RATING FAMILIES ACTUALLY WRITE   *
//* SUSPENSE OUTPUT TO (DD SUSOUT/SUSPOUT) - THE NAMES ARE         *
//* SIMILAR BUT THE DATASETS ARE NOT THE SAME.                    *
//*                                                                *
//* ALLOCATED UNDER CR-4471 FOR THE 1994 CONVERSION AS A DIRECTLY  *
//* ADDRESSABLE SUSPENSE POOL FOR THE OPERATOR RECOVERY SCREEN     *
//* THAT PRECEDED THE CURRENT GDG-BASED SUSPENSE REVIEW PROCESS.   *
//* RERUN ONLY ON A COLD START OF A NEW REGION.                    *
//*                                                                *
//* REVISION HISTORY                                               *
//*   1994-10-11  D.OKONKWO     INITIAL ALLOCATION - CR-4471       *
//*   1997-02-05  J.M.CASTILLO  SEVERITY BYTE ADDED TO THE LAYOUT -*
//*                             RECORD LENGTH UNCHANGED, FILLER    *
//*                             REDUCED                            *
//*****************************************************************
//STEP010  EXEC PGM=IDCAMS,REGION=4M
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  SET MAXCC = 0
  DELETE TELCABS.CABS.SUSPENSE.ES CLUSTER PURGE
  DEFINE CLUSTER -
      (NAME(TELCABS.CABS.SUSPENSE.ES) -
       NONINDEXED -
       RECORDSIZE(300 300) -
       FREESPACE(0 0) -
       SHAREOPTIONS(2 3) -
       VOLUMES(TELV05) -
       CYLINDERS(20 10) -
       SPEED) -
      DATA -
      (NAME(TELCABS.CABS.SUSPENSE.ES.DATA) -
       CISZ(4096))
  IF LASTCC > 4 THEN -
    SET MAXCC = 12
  ELSE -
    SET MAXCC = 0
/*
//*
//* STEP020 - LISTCAT.  NOT ON THE STANDARD OPERATIONS CHECKLIST  *
//* SINCE NO CURRENT SCHEDULE ENTRY OPENS THIS CLUSTER.  KEPT FOR *
//* THE COLD-START REBUILD PROCEDURE ONLY.                        *
//*
//STEP020  EXEC PGM=IDCAMS,REGION=4M,COND=(4,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  LISTCAT ENTRIES(TELCABS.CABS.SUSPENSE.ES) ALL
/*
//*
//* STEP030 - PRINT THE FIRST FEW RECORDS IN CHARACTER FORMAT.    *
//* USEFUL ONLY IMMEDIATELY AFTER A COLD-START DEFINE WHEN THE    *
//* CLUSTER IS STILL EMPTY - RETURNS NOTHING IN ANY ESTABLISHED   *
//* ENVIRONMENT AND IS NOT AN ERROR CONDITION.                    *
//*
//STEP030  EXEC PGM=IDCAMS,REGION=4M,COND=(4,LT)
//SYSPRINT DD SYSOUT=*
//DDIN     DD DSN=TELCABS.CABS.SUSPENSE.ES,DISP=SHR
//SYSIN    DD *
  PRINT INFILE(DDIN) COUNT(10) CHARACTER
/*
//
