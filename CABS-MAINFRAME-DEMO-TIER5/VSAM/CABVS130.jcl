//CABVS130 JOB (CABS,DBA),'CARRIER AIX BLDINDEX',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//             NOTIFY=&SYSUID,REGION=6M,TIME=(15,0)
//*****************************************************************
//* CABVS130 - BUILD THE CARRIER ACNA ALTERNATE INDEX             *
//*                                                               *
//* POPULATES TELCABS.CABS.CARRIER.AIX (DEFINED EMPTY BY CABVS040)*
//* FROM THE CURRENT CONTENTS OF TELCABS.CABS.CARRIER.  MUST RUN  *
//* IMMEDIATELY AFTER CABVS040 ON A COLD START, AND AGAIN AFTER   *
//* ANY BULK RELOAD OF THE CARRIER MASTER THAT BYPASSES THE       *
//* UPGRADE PATH (E.G. A REPRO REPLACE RATHER THAN INDIVIDUAL     *
//* PUTS THROUGH THE PATH).                                        *
//*                                                                *
//* BLDINDEX SORTS THE BASE CLUSTER ON THE ALTERNATE KEY - THE     *
//* THREE SORT WORK DDS BELOW ARE SIZED FOR THE FULL CARRIER       *
//* MASTER, NOT JUST THE INCREMENTAL CHANGE SET, BECAUSE BLDINDEX  *
//* ALWAYS REBUILDS FROM SCRATCH.                                  *
//*                                                                *
//* REVISION HISTORY                                               *
//*   1994-08-23  D.OKONKWO     INITIAL VERSION - CR-4471          *
//*   2001-06-04  P.NAIR        SORT WORK SPACE DOUBLED - THE      *
//*                             CLEC ONBOARDING WAVE WAS CAUSING   *
//*                             SORTWK ABENDS ON THE ORIGINAL SIZE *
//*   2016-09-13  T.VANCE       REGION RAISED TO 6M FOR THE SORT   *
//*                             WORK ALLOCATION UNDER Z/OS SORT     *
//*****************************************************************
//STEP010  EXEC PGM=IDCAMS,REGION=6M
//SYSPRINT DD SYSOUT=*
//SORTWK01 DD UNIT=SYSDA,SPACE=(CYL,(50,50))
//SORTWK02 DD UNIT=SYSDA,SPACE=(CYL,(50,50))
//SORTWK03 DD UNIT=SYSDA,SPACE=(CYL,(50,50))
//INDD1    DD DSN=TELCABS.CABS.CARRIER,DISP=SHR
//OUTDD1   DD DSN=TELCABS.CABS.CARRIER.AIX,DISP=SHR
//SYSIN    DD *
  BLDINDEX -
      INFILE(INDD1) -
      OUTFILE(OUTDD1) -
      WORKFILES(3)
  IF LASTCC > 4 THEN -
    SET MAXCC = 12
  ELSE -
    SET MAXCC = 0
/*
//*
//* STEP020 - LISTCAT VERIFICATION.  RECORD COUNT ON THE AIX      *
//* SHOULD MATCH THE CARRIER MASTER RECORD COUNT - ONE ALTERNATE  *
//* ENTRY PER BASE RECORD EVEN THOUGH THE KEY IS NON-UNIQUE.       *
//*
//STEP020  EXEC PGM=IDCAMS,REGION=4M,COND=(4,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  LISTCAT ENTRIES(TELCABS.CABS.CARRIER) ALL
  LISTCAT ENTRIES(TELCABS.CABS.CARRIER.AIX) ALL
/*
//*
//* STEP030 - EXAMINE THE AIX AND ITS PATH.  RUN AFTER ANY        *
//* BLDINDEX THAT COMPLETED WITH A NON-ZERO CONDITION CODE ON A   *
//* PRIOR ATTEMPT - EXAMINE CATCHES A PARTIALLY BUILT INDEX THAT  *
//* LISTCAT ALONE WILL NOT SHOW.                                  *
//*
//STEP030  EXEC PGM=IDCAMS,REGION=4M,COND=(4,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  EXAMINE NAME(TELCABS.CABS.CARRIER.AIX) INDEXTEST DATATEST
/*
//
