//CABVS040 JOB (CABS,DBA),'CARRIER ACNA AIX/PATH DEFINE',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//             NOTIFY=&SYSUID,REGION=4M,TIME=(10,0)
//*****************************************************************
//* CABVS040 - DEFINE THE CARRIER ACNA ALTERNATE INDEX AND PATH    *
//*                                                                *
//* DEFINES TELCABS.CABS.CARRIER.AIX (ALTERNATE INDEX ON CR-ACNA,  *
//* 3 BYTES AT OFFSET 44, NON-UNIQUE) AND TELCABS.CABS.CARRIER.    *
//* PATH OVER THE CARRIER MASTER DEFINED BY CABVS030.  THE AIX IS  *
//* DEFINED EMPTY - CABVS130 (BLDINDEX) MUST RUN IMMEDIATELY       *
//* AFTER OR THE PATH RETURNS NO ROWS.                             *
//*                                                                *
//* BUILT UNDER CR-4471 FOR THE 1994 CONVERSION TO SUPPORT ACNA-   *
//* KEYED CARRIER LOOKUP FROM THE SETTLEMENT FRONT END THAT WAS    *
//* RETIRED WITH THE CMDS/RAO GATEWAY REPLATFORM.  RERUN THIS JOB  *
//* ONLY ON A COLD START - THE PATH NAME IS REFERENCED BY THE      *
//* OPERATOR PROCEDURE LIBRARY FOR THE RETIRED FRONT END, WHICH IS *
//* STILL ON FILE PENDING FORMAL WITHDRAWAL.                       *
//*                                                                *
//* REVISION HISTORY                                               *
//*   1994-08-22  D.OKONKWO     INITIAL DEFINITION - CR-4471       *
//*   1997-04-14  J.M.CASTILLO  UPGRADE OPTION CONFIRMED - AIX     *
//*                             REBUILDS AUTOMATICALLY ON MASTER   *
//*                             UPDATE VIA THE CARRMST PATH         *
//*   2006-09-30  A.BUKOWSKI    SHAREOPTIONS ALIGNED TO THE MASTER *
//*****************************************************************
//STEP010  EXEC PGM=IDCAMS,REGION=4M
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  SET MAXCC = 0
  DELETE TELCABS.CABS.CARRIER.PATH PURGE
  SET MAXCC = 0
  DELETE TELCABS.CABS.CARRIER.AIX CLUSTER PURGE
  DEFINE AIX -
      (NAME(TELCABS.CABS.CARRIER.AIX) -
       RELATE(TELCABS.CABS.CARRIER) -
       KEYS(3 44) -
       RECORDSIZE(9 9) -
       NONUNIQUEKEY -
       UPGRADE -
       FREESPACE(10 10) -
       SHAREOPTIONS(2 3) -
       VOLUMES(TELV02) -
       CYLINDERS(2 1)) -
      DATA -
      (NAME(TELCABS.CABS.CARRIER.AIX.DATA) -
       CISZ(2048)) -
      INDEX -
      (NAME(TELCABS.CABS.CARRIER.AIX.INDEX) -
       CISZ(1024))
  DEFINE PATH -
      (NAME(TELCABS.CABS.CARRIER.PATH) -
       PATHENTRY(TELCABS.CABS.CARRIER.AIX) -
       UPDATE)
  IF LASTCC > 4 THEN -
    SET MAXCC = 12
  ELSE -
    SET MAXCC = 0
/*
//*
//* STEP020 - LISTCAT.  THE AIX SHOWS ZERO RECORDS UNTIL CABVS130  *
//* RUNS.  THAT IS EXPECTED IMMEDIATELY AFTER THIS JOB AND IS NOT  *
//* AN ERROR CONDITION ON ITS OWN.                                 *
//*
//STEP020  EXEC PGM=IDCAMS,REGION=4M,COND=(4,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  LISTCAT ENTRIES(TELCABS.CABS.CARRIER.AIX) ALL
  LISTCAT ENTRIES(TELCABS.CABS.CARRIER.PATH) ALL
/*
//
