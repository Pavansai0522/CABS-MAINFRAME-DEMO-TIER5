//CABVS090 JOB (CABS,DBA),'BILL DETAIL ESDS DEFINE',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//             NOTIFY=&SYSUID,REGION=4M,TIME=(10,0)
//*****************************************************************
//* CABVS090 - DEFINE THE BILL DETAIL RETENTION ESDS               *
//*                                                                *
//* DEFINES TELCABS.CABS.BILLDTL.ES, AN ENTRY-SEQUENCED CLUSTER    *
//* SIZED FOR THE VARIABLE-LENGTH CABSBILL RECORD (RECFM VB,       *
//* LRECL 1651 = 1647 DATA BYTES + 4 BYTE RDW, OCCURS              *
//* DEPENDING ON UP TO 40 RATE ELEMENTS).  VSAM RECORDSIZE         *
//* CARRIES NO RDW, SO THE CLUSTER MAXIMUM IS 1647.                *
//*                                                                *
//* ALLOCATED UNDER CR-4471 FOR A 1996 PILOT THAT KEPT BILL        *
//* DETAIL IN A DIRECTLY ADDRESSABLE VSAM CLUSTER INSTEAD OF THE   *
//* BILLDTL GDG CHAIN, TO SUPPORT AD HOC RBA-POSITIONED READS      *
//* FROM THE DISPUTE RESEARCH DESK.  THE PILOT WAS NOT ADOPTED     *
//* ESTATE-WIDE.  RERUN THIS JOB ONLY ON A COLD START OF A NEW     *
//* REGION - IN AN ESTABLISHED ENVIRONMENT THE CLUSTER SHOULD      *
//* ALREADY EXIST.                                                 *
//*                                                                *
//* REVISION HISTORY                                               *
//*   1996-06-03  J.M.CASTILLO  INITIAL ALLOCATION - CR-4471,      *
//*                             DISPUTE DESK PILOT                 *
//*   1996-09-17  J.M.CASTILLO  RECORDSIZE WIDENED TO MATCH THE    *
//*                             40-ELEMENT CABSBILL MAXIMUM        *
//*   2003-01-08  A.BUKOWSKI    FREESPACE REMOVED - ESDS APPEND    *
//*                             ONLY, FREESPACE WAS WASTED SPACE   *
//*****************************************************************
//STEP010  EXEC PGM=IDCAMS,REGION=4M
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  SET MAXCC = 0
  DELETE TELCABS.CABS.BILLDTL.ES CLUSTER PURGE
  DEFINE CLUSTER -
      (NAME(TELCABS.CABS.BILLDTL.ES) -
       NONINDEXED -
       RECORDSIZE(200 1647) -
       FREESPACE(0 0) -
       SHAREOPTIONS(2 3) -
       VOLUMES(TELV07 TELV08) -
       CYLINDERS(150 75) -
       SPEED) -
      DATA -
      (NAME(TELCABS.CABS.BILLDTL.ES.DATA) -
       CISZ(8192))
  IF LASTCC > 4 THEN -
    SET MAXCC = 12
  ELSE -
    SET MAXCC = 0
/*
//*
//* STEP020 - LISTCAT.  NOT ON THE STANDARD OPERATIONS CHECKLIST  *
//* SINCE NO CURRENT SCHEDULE ENTRY OPENS THIS CLUSTER.  KEPT FOR *
//* THE COLD-START REBUILD PROCEDURE ONLY.                        *
//*
//STEP020  EXEC PGM=IDCAMS,REGION=4M,COND=(4,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  LISTCAT ENTRIES(TELCABS.CABS.BILLDTL.ES) ALL
/*
//*
//* STEP030 - PRINT THE FIRST FEW RECORDS IN CHARACTER FORMAT FOR *
//* A VISUAL CHECK OF THE RECFM VB LENGTH PREFIX AGAINST THE      *
//* CABSBILL LAYOUT.  RETURNS NOTHING IN ANY ESTABLISHED           *
//* ENVIRONMENT WHERE NOTHING HAS EVER WRITTEN TO THIS CLUSTER.    *
//*
//STEP030  EXEC PGM=IDCAMS,REGION=4M,COND=(4,LT)
//SYSPRINT DD SYSOUT=*
//DDIN     DD DSN=TELCABS.CABS.BILLDTL.ES,DISP=SHR
//SYSIN    DD *
  PRINT INFILE(DDIN) COUNT(5) CHARACTER
/*
//
