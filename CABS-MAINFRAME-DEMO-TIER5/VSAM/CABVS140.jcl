//CABVS140 JOB (CABS,DBA),'CARRIER+RATE INITIAL LOAD',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//             NOTIFY=&SYSUID,REGION=4M,TIME=(20,0)
//*****************************************************************
//* CABVS140 - SEQUENTIAL TO KSDS LOAD - CARRIER MASTER AND RATE  *
//*            TABLE                                              *
//*                                                                *
//* LOADS TELCABS.CABS.CARRIER FROM TELCABS.CABS.CARRIER.LOAD AND  *
//* TELCABS.CABS.RATE FROM THE ZERO GENERATION OF TELCABS.CABS.    *
//* RATE.LOAD.  BOTH CLUSTERS MUST ALREADY BE DEFINED (CABVS030,   *
//* CABVS050) AND EMPTY OR CLEARED BEFORE THIS JOB RUNS.            *
//*                                                                *
//* %%SKIPCT AND %%LOADCT ARE SUBSTITUTED BY THE SCHEDULER ON A    *
//* RESTART.  A LOAD THAT ABENDS PART WAY THROUGH IS RESUBMITTED   *
//* WITH %%SKIPCT SET TO THE RECORD COUNT ALREADY COMMITTED (FROM  *
//* THE SYSPRINT OF THE FAILED RUN) AND %%LOADCT LEFT AT ITS       *
//* DEFAULT OF 999999999 SO THE REMAINDER LOADS IN ONE PASS.  ON A *
//* FIRST-TIME LOAD BOTH DEFAULT TO ZERO/UNLIMITED VIA THE PROC.   *
//*                                                                *
//* REVISION HISTORY                                               *
//*   1988-05-12  R.T.WHEELER   INITIAL VERSION - CARRIER ONLY     *
//*   1989-01-22  R.T.WHEELER   RATE TABLE LOAD STEP ADDED         *
//*   2001-11-06  P.NAIR        SKIP/COUNT RESTART FACILITY ADDED  *
//*                             AFTER A LOAD ABEND LEFT THE RATE    *
//*                             TABLE HALF POPULATED WITH NO WAY   *
//*                             TO RESUME WITHOUT A FULL RELOAD     *
//*   2019-07-30  T.VANCE       VERIFY STEP ADDED AFTER BOTH LOADS *
//*****************************************************************
//STEP010  EXEC PGM=IDCAMS,REGION=4M,
//             PARM='%%SKIPCT,%%LOADCT'
//SYSPRINT DD SYSOUT=*
//CARIN    DD DSN=TELCABS.CABS.CARRIER.LOAD,DISP=SHR
//CAROUT   DD DSN=TELCABS.CABS.CARRIER,DISP=SHR
//SYSIN    DD *
  REPRO INFILE(CARIN) OUTFILE(CAROUT) -
      SKIP(%%SKIPCT) -
      COUNT(%%LOADCT)
  IF LASTCC > 4 THEN -
    SET MAXCC = 12
  ELSE -
    SET MAXCC = 0
/*
//*
//* STEP020 - RATE TABLE LOAD.  RUNS EVEN IF STEP010 FLAGGED A    *
//* WARNING (COND=(4,LT) ONLY SKIPS ON A HARD FAILURE) SINCE THE  *
//* TWO MASTERS ARE LOADED FROM INDEPENDENT EXTRACTS.               *
//*
//STEP020  EXEC PGM=IDCAMS,REGION=4M,COND=(8,LT)
//SYSPRINT DD SYSOUT=*
//RATIN    DD DSN=TELCABS.CABS.RATE.LOAD(0),DISP=SHR
//RATOUT   DD DSN=TELCABS.CABS.RATE,DISP=SHR
//SYSIN    DD *
  REPRO INFILE(RATIN) OUTFILE(RATOUT) -
      SKIP(%%SKIPCT) -
      COUNT(%%LOADCT)
  IF LASTCC > 4 THEN -
    SET MAXCC = 12
  ELSE -
    SET MAXCC = 0
/*
//*
//* STEP030 - VERIFY BOTH CLUSTERS.  A LOAD THAT ABENDED MID-CI    *
//* SPLIT CAN LEAVE THE VSAM CATALOG ENTRY OUT OF SYNC WITH THE    *
//* HIGH-USED-RBA - VERIFY FORCES A RECONCILE BEFORE THE FIRST     *
//* PRODUCTION READ.                                                *
//*
//STEP030  EXEC PGM=IDCAMS,REGION=4M,COND=(4,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  VERIFY DATASET(TELCABS.CABS.CARRIER)
  VERIFY DATASET(TELCABS.CABS.RATE)
  LISTCAT ENTRIES(TELCABS.CABS.CARRIER) ALL
  LISTCAT ENTRIES(TELCABS.CABS.RATE) ALL
/*
//
