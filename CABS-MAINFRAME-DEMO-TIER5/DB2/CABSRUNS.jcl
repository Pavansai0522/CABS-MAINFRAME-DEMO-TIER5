//CABSRUNS JOB (CABS,DBA),'CABS/SETL RUNSTATS+REORG',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//             NOTIFY=&SYSUID,REGION=0M,TIME=1440
//*****************************************************************
//* CABSRUNS - MONTHLY RUNSTATS AND REORG FOR THE CABSDB01 DATABASE
//*                                                               *
//* SCHEDULED FOR THE THIRD SATURDAY OF THE MONTH, 02:00-06:00     *
//* LOCAL, INSIDE THE STANDING SUNDAY MAINTENANCE WINDOW.  THIS    *
//* WINDOW WAS NEGOTIATED WITH THE SETTLEMENT OPERATIONS TEAM      *
//* BECAUSE THE CABS3100 PERIOD CLOSE JOB (SEE JCL/CABS3100.JCL)   *
//* MUST NOT OVERLAP A REORG OF TSSETT OR TSSPRD - AN INFLIGHT     *
//* REORG HOLDS THE TABLESPACE IN A RESTRICTED STATE THAT WOULD    *
//* ABEND THE CLOSE STEP WITH SQLCODE -904.  DO NOT MOVE THIS JOB  *
//* EARLIER IN THE WEEKEND WITHOUT CHECKING THE SETTLEMENT CYCLE   *
//* CALENDAR IN TELCABS.SETL.CONTROL.CALENDAR.                     *
//*                                                                *
//* REORG RUNS SHRLEVEL REFERENCE - READ ACCESS ONLY DURING THE    *
//* UNLOAD/RELOAD.  THIS IS ACCEPTABLE INSIDE THE WINDOW BECAUSE   *
//* NO ON-LINE CICS TRANSACTION IS SCHEDULED TO BE ACTIVE.         *
//*****************************************************************
//*
//STEP010  EXEC PGM=DSNUTILB,PARM='DSNP,CABSRUNS'
//STEPLIB  DD DSN=DSNP.SDSNLOAD,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//UTPRINT  DD SYSOUT=*
//SORTWK00 DD UNIT=SYSDA,SPACE=(CYL,(50,50))
//SORTWK01 DD UNIT=SYSDA,SPACE=(CYL,(50,50))
//SYSIN    DD *
  RUNSTATS TABLESPACE CABSDB01.TSRTHS
    TABLE(ALL) INDEX(ALL)
    SHRLEVEL REFERENCE
    REPORT YES
    UPDATE ALL

  RUNSTATS TABLESPACE CABSDB01.TSFCHS
    TABLE(ALL) INDEX(ALL)
    SHRLEVEL REFERENCE
    REPORT YES
    UPDATE ALL

  RUNSTATS TABLESPACE CABSDB01.TSSETT
    TABLE(ALL) INDEX(ALL)
    SHRLEVEL REFERENCE
    REPORT YES
    UPDATE ALL

  RUNSTATS TABLESPACE CABSDB01.TSSPRD
    TABLE(ALL) INDEX(ALL)
    SHRLEVEL REFERENCE
    REPORT YES
    UPDATE ALL

  RUNSTATS TABLESPACE CABSDB01.TSADJ
    TABLE(ALL) INDEX(ALL)
    SHRLEVEL REFERENCE
    REPORT YES
    UPDATE ALL

  RUNSTATS TABLESPACE CABSDB01.TSINVR
    TABLE(ALL) INDEX(ALL)
    SHRLEVEL REFERENCE
    REPORT YES
    UPDATE ALL

  RUNSTATS TABLESPACE CABSDB01.TSAUDT
    TABLE(ALL) INDEX(ALL)
    SHRLEVEL REFERENCE
    REPORT YES
    UPDATE ALL
/*
//*
//STEP020  EXEC PGM=DSNUTILB,PARM='DSNP,CABSRUNS',COND=(4,LT,STEP010)
//STEPLIB  DD DSN=DSNP.SDSNLOAD,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//UTPRINT  DD SYSOUT=*
//SORTWK00 DD UNIT=SYSDA,SPACE=(CYL,(100,100))
//SORTWK01 DD UNIT=SYSDA,SPACE=(CYL,(100,100))
//SYSIN    DD *
* REORG SETLTRAN AND SETLPERIOD FIRST - THESE ARE THE TWO
* TABLESPACES THE CABS3100 CLOSE JOB TOUCHES.  THEY MUST BE BACK
* IN AVAILABLE STATE WELL BEFORE THE WINDOW CLOSES AT 06:00.
  REORG TABLESPACE CABSDB01.TSSETT
    SHRLEVEL REFERENCE
    UNLOAD CONTINUE
    SORTDATA
    STATISTICS TABLE(ALL) INDEX(ALL) REPORT YES UPDATE ALL

  REORG TABLESPACE CABSDB01.TSSPRD
    SHRLEVEL REFERENCE
    UNLOAD CONTINUE
    SORTDATA
    STATISTICS TABLE(ALL) INDEX(ALL) REPORT YES UPDATE ALL

  REORG TABLESPACE CABSDB01.TSADJ
    SHRLEVEL REFERENCE
    UNLOAD CONTINUE
    SORTDATA
    STATISTICS TABLE(ALL) INDEX(ALL) REPORT YES UPDATE ALL

  REORG TABLESPACE CABSDB01.TSRTHS
    SHRLEVEL REFERENCE
    UNLOAD CONTINUE
    SORTDATA
    STATISTICS TABLE(ALL) INDEX(ALL) REPORT YES UPDATE ALL

  REORG TABLESPACE CABSDB01.TSFCHS
    SHRLEVEL REFERENCE
    UNLOAD CONTINUE
    SORTDATA
    STATISTICS TABLE(ALL) INDEX(ALL) REPORT YES UPDATE ALL

  REORG TABLESPACE CABSDB01.TSINVR
    SHRLEVEL REFERENCE
    UNLOAD CONTINUE
    SORTDATA
    STATISTICS TABLE(ALL) INDEX(ALL) REPORT YES UPDATE ALL

  REORG TABLESPACE CABSDB01.TSAUDT
    SHRLEVEL REFERENCE
    UNLOAD CONTINUE
    SORTDATA
    STATISTICS TABLE(ALL) INDEX(ALL) REPORT YES UPDATE ALL
/*
//
