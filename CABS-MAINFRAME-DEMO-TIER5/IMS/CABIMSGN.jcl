//CABIMSGN JOB (CABS,IMSDBA),'IMS DBD/PSB/ACB GEN',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//             NOTIFY=&SYSUID,REGION=0M,TIME=1440
//*****************************************************************
//* CABIMSGN - IMS DATABASE AND PROGRAM SPECIFICATION GENERATION  *
//*                                                                *
//* THREE STEP GROUPS.  GROUP 1 ASSEMBLES AND LINK-EDITS EVERY    *
//* DBD SOURCE MEMBER INTO IMS.DBDLIB.  GROUP 2 DOES THE SAME     *
//* FOR EVERY PSB SOURCE MEMBER INTO IMS.PSBLIB.  GROUP 3 RUNS    *
//* ACBGEN AGAINST THE UPDATED DBDLIB/PSBLIB PAIR TO BUILD THE    *
//* MATCHED ACBS THE ONLINE REGION LOADS AT /STA.                 *
//*                                                                *
//* THE ACBGEN STEP MUST RUN AFTER ANY DBDGEN OR PSBGEN THAT      *
//* TOUCHES A DATABASE OR PROGRAM THIS REGION USES - AN ACBGEN    *
//* RUN AGAINST A STALE DBDLIB MEMBER PRODUCES AN ACB THAT DOES   *
//* NOT MATCH THE SOURCE, WHICH FAILS QUIETLY UNTIL THE FIRST     *
//* PROGRAM THAT NEEDS THE CHANGED SEGMENT.  BRING THE ONLINE     *
//* REGION DOWN WITH /DBR FOR EVERY DATABASE IN THIS JOB BEFORE   *
//* SUBMITTING, AND BRING IT BACK UP WITH /STA AFTERWARD SO THE   *
//* REGION PICKS UP THE NEW ACB RATHER THAN RUNNING ON THE ONE    *
//* IT ALREADY HAS IN STORAGE.                                    *
//*****************************************************************
//*
//* -----------------------------------------------------------
//* STEP GROUP 1 - DBDGEN.  ASSEMBLE + LINK-EDIT, ONE PAIR PER
//* DATABASE, IN DEPENDENCY ORDER (INDEX DATABASES BEFORE THE
//* DATABASES THAT REFERENCE THEM VIA LCHILD).
//* -----------------------------------------------------------
//D01     EXEC PGM=ASMA90,REGION=4M,
//             PARM='DECK,NOOBJECT,NOLIST'
//SYSLIB   DD DSN=IMS.MACLIB,DISP=SHR
//         DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(5,5))
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DSN=&&D01,DISP=(MOD,PASS),UNIT=SYSDA,
//             SPACE=(TRK,(5,5)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120)
//SYSIN    DD DSN=TELCABS.IMS.SRCLIB(CABCARDB),DISP=SHR
//D01L    EXEC PGM=IEWL,REGION=2M,COND=(0,LT,D01)
//SYSLMOD  DD DSN=IMS.DBDLIB(CABCARDB),DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSPRINT DD SYSOUT=*
//SYSLIN   DD DSN=&&D01,DISP=(OLD,DELETE)
//*
//D02     EXEC PGM=ASMA90,REGION=4M,
//             PARM='DECK,NOOBJECT,NOLIST'
//SYSLIB   DD DSN=IMS.MACLIB,DISP=SHR
//         DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(5,5))
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DSN=&&D02,DISP=(MOD,PASS),UNIT=SYSDA,
//             SPACE=(TRK,(5,5)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120)
//SYSIN    DD DSN=TELCABS.IMS.SRCLIB(CABCIRIX),DISP=SHR
//D02L    EXEC PGM=IEWL,REGION=2M,COND=(0,LT,D02)
//SYSLMOD  DD DSN=IMS.DBDLIB(CABCIRIX),DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSPRINT DD SYSOUT=*
//SYSLIN   DD DSN=&&D02,DISP=(OLD,DELETE)
//*
//D03     EXEC PGM=ASMA90,REGION=4M,
//             PARM='DECK,NOOBJECT,NOLIST'
//SYSLIB   DD DSN=IMS.MACLIB,DISP=SHR
//         DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(5,5))
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DSN=&&D03,DISP=(MOD,PASS),UNIT=SYSDA,
//             SPACE=(TRK,(5,5)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120)
//SYSIN    DD DSN=TELCABS.IMS.SRCLIB(CABCIRDB),DISP=SHR
//D03L    EXEC PGM=IEWL,REGION=2M,COND=(0,LT,D03)
//SYSLMOD  DD DSN=IMS.DBDLIB(CABCIRDB),DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSPRINT DD SYSOUT=*
//SYSLIN   DD DSN=&&D03,DISP=(OLD,DELETE)
//*
//D04     EXEC PGM=ASMA90,REGION=4M,
//             PARM='DECK,NOOBJECT,NOLIST'
//SYSLIB   DD DSN=IMS.MACLIB,DISP=SHR
//         DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(5,5))
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DSN=&&D04,DISP=(MOD,PASS),UNIT=SYSDA,
//             SPACE=(TRK,(5,5)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120)
//SYSIN    DD DSN=TELCABS.IMS.SRCLIB(CABSETSX),DISP=SHR
//D04L    EXEC PGM=IEWL,REGION=2M,COND=(0,LT,D04)
//SYSLMOD  DD DSN=IMS.DBDLIB(CABSETSX),DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSPRINT DD SYSOUT=*
//SYSLIN   DD DSN=&&D04,DISP=(OLD,DELETE)
//*
//D05     EXEC PGM=ASMA90,REGION=4M,
//             PARM='DECK,NOOBJECT,NOLIST'
//SYSLIB   DD DSN=IMS.MACLIB,DISP=SHR
//         DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(5,5))
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DSN=&&D05,DISP=(MOD,PASS),UNIT=SYSDA,
//             SPACE=(TRK,(5,5)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120)
//SYSIN    DD DSN=TELCABS.IMS.SRCLIB(CABSETDB),DISP=SHR
//D05L    EXEC PGM=IEWL,REGION=2M,COND=(0,LT,D05)
//SYSLMOD  DD DSN=IMS.DBDLIB(CABSETDB),DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSPRINT DD SYSOUT=*
//SYSLIN   DD DSN=&&D05,DISP=(OLD,DELETE)
//*
//D06     EXEC PGM=ASMA90,REGION=4M,
//             PARM='DECK,NOOBJECT,NOLIST'
//SYSLIB   DD DSN=IMS.MACLIB,DISP=SHR
//         DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(5,5))
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DSN=&&D06,DISP=(MOD,PASS),UNIT=SYSDA,
//             SPACE=(TRK,(5,5)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120)
//SYSIN    DD DSN=TELCABS.IMS.SRCLIB(CABBHSDB),DISP=SHR
//D06L    EXEC PGM=IEWL,REGION=2M,COND=(0,LT,D06)
//SYSLMOD  DD DSN=IMS.DBDLIB(CABBHSDB),DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSPRINT DD SYSOUT=*
//SYSLIN   DD DSN=&&D06,DISP=(OLD,DELETE)
//*
//* -----------------------------------------------------------
//* STEP GROUP 2 - PSBGEN.  ASSEMBLE + LINK-EDIT, ONE PAIR PER
//* PROGRAM SPECIFICATION.
//* -----------------------------------------------------------
//P01     EXEC PGM=ASMA90,REGION=4M,
//             PARM='DECK,NOOBJECT,NOLIST'
//SYSLIB   DD DSN=IMS.MACLIB,DISP=SHR
//         DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(5,5))
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DSN=&&P01,DISP=(MOD,PASS),UNIT=SYSDA,
//             SPACE=(TRK,(5,5)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120)
//SYSIN    DD DSN=TELCABS.IMS.SRCLIB(CABCT01P),DISP=SHR
//P01L    EXEC PGM=IEWL,REGION=2M,COND=(0,LT,P01)
//SYSLMOD  DD DSN=IMS.PSBLIB(CABCT01P),DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSPRINT DD SYSOUT=*
//SYSLIN   DD DSN=&&P01,DISP=(OLD,DELETE)
//*
//P02     EXEC PGM=ASMA90,REGION=4M,
//             PARM='DECK,NOOBJECT,NOLIST'
//SYSLIB   DD DSN=IMS.MACLIB,DISP=SHR
//         DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(5,5))
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DSN=&&P02,DISP=(MOD,PASS),UNIT=SYSDA,
//             SPACE=(TRK,(5,5)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120)
//SYSIN    DD DSN=TELCABS.IMS.SRCLIB(CABCT02P),DISP=SHR
//P02L    EXEC PGM=IEWL,REGION=2M,COND=(0,LT,P02)
//SYSLMOD  DD DSN=IMS.PSBLIB(CABCT02P),DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSPRINT DD SYSOUT=*
//SYSLIN   DD DSN=&&P02,DISP=(OLD,DELETE)
//*
//P03     EXEC PGM=ASMA90,REGION=4M,
//             PARM='DECK,NOOBJECT,NOLIST'
//SYSLIB   DD DSN=IMS.MACLIB,DISP=SHR
//         DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(5,5))
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DSN=&&P03,DISP=(MOD,PASS),UNIT=SYSDA,
//             SPACE=(TRK,(5,5)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120)
//SYSIN    DD DSN=TELCABS.IMS.SRCLIB(CABCT03P),DISP=SHR
//P03L    EXEC PGM=IEWL,REGION=2M,COND=(0,LT,P03)
//SYSLMOD  DD DSN=IMS.PSBLIB(CABCT03P),DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSPRINT DD SYSOUT=*
//SYSLIN   DD DSN=&&P03,DISP=(OLD,DELETE)
//*
//P04     EXEC PGM=ASMA90,REGION=4M,
//             PARM='DECK,NOOBJECT,NOLIST'
//SYSLIB   DD DSN=IMS.MACLIB,DISP=SHR
//         DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(5,5))
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DSN=&&P04,DISP=(MOD,PASS),UNIT=SYSDA,
//             SPACE=(TRK,(5,5)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120)
//SYSIN    DD DSN=TELCABS.IMS.SRCLIB(CABCT04P),DISP=SHR
//P04L    EXEC PGM=IEWL,REGION=2M,COND=(0,LT,P04)
//SYSLMOD  DD DSN=IMS.PSBLIB(CABCT04P),DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSPRINT DD SYSOUT=*
//SYSLIN   DD DSN=&&P04,DISP=(OLD,DELETE)
//*
//P05     EXEC PGM=ASMA90,REGION=4M,
//             PARM='DECK,NOOBJECT,NOLIST'
//SYSLIB   DD DSN=IMS.MACLIB,DISP=SHR
//         DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(5,5))
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DSN=&&P05,DISP=(MOD,PASS),UNIT=SYSDA,
//             SPACE=(TRK,(5,5)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120)
//SYSIN    DD DSN=TELCABS.IMS.SRCLIB(CABCT05P),DISP=SHR
//P05L    EXEC PGM=IEWL,REGION=2M,COND=(0,LT,P05)
//SYSLMOD  DD DSN=IMS.PSBLIB(CABCT05P),DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSPRINT DD SYSOUT=*
//SYSLIN   DD DSN=&&P05,DISP=(OLD,DELETE)
//*
//P06     EXEC PGM=ASMA90,REGION=4M,
//             PARM='DECK,NOOBJECT,NOLIST'
//SYSLIB   DD DSN=IMS.MACLIB,DISP=SHR
//         DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(5,5))
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DSN=&&P06,DISP=(MOD,PASS),UNIT=SYSDA,
//             SPACE=(TRK,(5,5)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120)
//SYSIN    DD DSN=TELCABS.IMS.SRCLIB(CABCT06P),DISP=SHR
//P06L    EXEC PGM=IEWL,REGION=2M,COND=(0,LT,P06)
//SYSLMOD  DD DSN=IMS.PSBLIB(CABCT06P),DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSPRINT DD SYSOUT=*
//SYSLIN   DD DSN=&&P06,DISP=(OLD,DELETE)
//*
//* -----------------------------------------------------------
//* STEP GROUP 3 - ACBGEN.  BUILDS THE MATCHED DBD/PSB ACBS
//* FROM THE DBDLIB/PSBLIB UPDATED ABOVE.  RUN THIS LAST, AND
//* ONLY WITH THE TARGET DEPENDENT REGIONS DOWN.
//* -----------------------------------------------------------
//ACBGEN  EXEC PGM=DFSRRC00,REGION=4M,
//             PARM='UPB,DFSUTB00,,,,,,,,,,,,Y'
//STEPLIB  DD DSN=IMS.RESLIB,DISP=SHR
//IMS      DD DSN=IMS.DBDLIB,DISP=SHR
//         DD DSN=IMS.PSBLIB,DISP=SHR
//DFSRESLB DD DSN=IMS.RESLIB,DISP=SHR
//DFSVSAMP DD DSN=TELCABS.IMS.VSAMPARM,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//
