*****************************************************************
* CABSETDB - SETTLEMENT DATABASE                                *
* HDAM ROOT SETLSEG KEYED BY SETTLEMENT TYPE + COUNTERPARTY OCN *
* + SETTLE PERIOD + SEQUENCE, WITH DETAIL AND DISPOSITION       *
* DEPENDENTS.  SECONDARY-INDEXED BY OCN/PERIOD VIA CABSETSX SO  *
* THE NIGHTLY RECONCILIATION RUN CAN DRIVE BY COUNTERPARTY       *
* WITHOUT A ROOT SCAN.  QUALIFIED BY CABCT05P AND CABCT06P.      *
* DATASET TELCABS.IMS.SETLDB ON THE OSAM GROUP DBDSETL.          *
* REVISION HISTORY                                              *
*   V1.00  1991-03-04  R.OKAFOR    INITIAL GEN, ROOT + SETLDTL   *
*   V1.01  1993-08-19  L.FENNIMORE ADDED SETLDISP                *
*   V1.02  1995-11-27  L.FENNIMORE ADDED SECONDARY INDEX          *
*                                  CABSETSX ON STOCNPD            *
*   V1.03  1997-06-30  T.OKONKWO   RMNAME ANCHOR POINTS TUNED     *
*                                  FOR THE 1997 SETTLEMENT VOLUME *
*                                  STUDY - NOT REVISITED SINCE    *
*   V2.00  2009-10-05  D.WASILEWSKI ADDED STDISPSW FIELD          *
*   V2.01  2016-01-25  M.OYELARAN  RECOMPILE ONLY                 *
*****************************************************************
         PRINT NOGEN
CABSETDB DBD   NAME=CABSETDB,ACCESS=(HDAM,OSAM),                     X
               RMNAME=(DFSHDC40,20,1200,3000)
*
DATASET  DD1=SETLDB1,DEVICE=3390,SIZE=3000
*
* ROOT - ONE PER SETTLEMENT TRANSACTION.  STKEY IS SETTLE TYPE
* (1) + COUNTERPARTY OCN (4) + SETTLE PERIOD (6) + SEQUENCE (9).
* STOCNPD IS THE SOURCE FIELD FOR THE SECONDARY INDEX BELOW -
* IT OVERLAPS THE BACK OF THE OCN AND THE FRONT OF THE PERIOD
* SO THE INDEX CAN BE BUILT WITHOUT A SEPARATE COPY OF EITHER.
*
SEGM     NAME=SETLSEG,BYTES=240,PARENT=0,FREQ=40000
LCHILD   NAME=(SETLXSEG,CABSETSX),POINTER=INDX
XDFLD    NAME=SETLXOCN,SEGMENT=SETLSEG,SRCH=STOCNPD
FIELD    NAME=(STKEY,SEQ,U),BYTES=20,START=1,TYPE=C
FIELD    NAME=STOCNPD,BYTES=10,START=2,TYPE=C
FIELD    NAME=STDIRECT,BYTES=1,START=61,TYPE=C
FIELD    NAME=STDISPSW,BYTES=1,START=62,TYPE=C
*
* SETTLEMENT DETAIL - USAGE BASIS LINES, ONE PER RATE BAND.
*
SEGM     NAME=SETLDTL,BYTES=160,PARENT=SETLSEG,FREQ=3
FIELD    NAME=(SDSEQ,SEQ,U),BYTES=9,START=1,TYPE=C
*
* DISPOSITION HISTORY - ONE PER STATUS CHANGE (DISPUTE, PAID,
* WRITTEN OFF).
*
SEGM     NAME=SETLDISP,BYTES=140,PARENT=SETLSEG,FREQ=2
FIELD    NAME=(SPDISPID,SEQ,U),BYTES=8,START=1,TYPE=C
FIELD    NAME=SPSTATUS,BYTES=1,START=9,TYPE=C
*
DBDGEN
FINISH
END
