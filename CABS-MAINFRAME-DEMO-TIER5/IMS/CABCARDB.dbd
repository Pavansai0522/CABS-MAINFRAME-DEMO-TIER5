*****************************************************************
* CABCARDB - CARRIER (OCN) DATABASE                             *
* HDAM ROOT CARRSEG KEYED BY OCN, WITH BILLING, EFFECTIVE-DATED *
* FACTOR AND AGREEMENT DEPENDENTS.  QUALIFIED BY CABCT01P AND   *
* CABCT02P.  DATASET TELCABS.IMS.CARRDB ON THE DBDCARR OSAM     *
* GROUP.                                                        *
* REVISION HISTORY                                              *
*   V1.00  1989-04-11  R.OKAFOR    INITIAL GEN, ROOT ONLY       *
*   V1.01  1990-09-03  R.OKAFOR    ADDED CARRBILL                *
*   V1.02  1992-02-27  L.FENNIMORE ADDED CARRFACT                *
*   V1.03  1994-11-08  L.FENNIMORE ADDED CARRAGMT                *
*   V1.04  1997-05-19  T.OKONKWO   RMNAME ANCHOR POINTS TUNED    *
*                                  FOR EVEN ROOT DISTRIBUTION -  *
*                                  REVISIT AFTER NEXT OCN LOAD   *
*   V1.05  2001-03-30  T.OKONKWO   CARRPROM SEGMENT (PROMOTIONAL *
*                                  RATE OVERRIDE) PLANNED FOR    *
*                                  NEXT RELEASE UNDER CR-4471    *
*   V1.06  2004-08-14  D.WASILEWSKI RECOMPILE, OSAM BUFFER POOL  *
*                                  MOVED TO IMS.VS.CARRDBB       *
*   V2.00  2011-06-02  M.OYELARAN  ADD CRTYPE, CRACNA FIELDS     *
*   V2.01  2016-01-25  M.OYELARAN  RECOMPILE ONLY - NO FIELD     *
*                                  CHANGES                        *
*****************************************************************
         PRINT NOGEN
CABCARDB DBD   NAME=CABCARDB,ACCESS=(HDAM,OSAM),                     X
               RMNAME=(DFSHDC40,10,500,824)
*
* PRIMARY OSAM DATASET.  ROOT ADDRESSABLE AREA IS 500 BLOCKS OF
* 824 BYTES, RANDOMISED BY DFSHDC40 OVER 10 ROOT ANCHOR POINTS
* PER BLOCK.
*
DATASET  DD1=CARRDB1,DEVICE=3390,SIZE=824
*
* ROOT - ONE PER CARRIER (OCN).  CROCN IS THE ROOT KEY.
*
SEGM     NAME=CARRSEG,BYTES=180,PARENT=0,FREQ=8000
FIELD    NAME=(CROCN,SEQ,U),BYTES=4,START=1,TYPE=C
FIELD    NAME=CRACNA,BYTES=3,START=45,TYPE=C
FIELD    NAME=CRTYPE,BYTES=1,START=48,TYPE=C
*
* BILLING PARAMETERS - ONE PER BILL CYCLE ASSIGNMENT.
*
SEGM     NAME=CARRBILL,BYTES=60,PARENT=CARRSEG,FREQ=3
FIELD    NAME=(CRBCYCL,SEQ,U),BYTES=2,START=1,TYPE=C
*
* EFFECTIVE-DATED FACTOR SET - PIU/PLU AND STATE OVERRIDES.
*
SEGM     NAME=CARRFACT,BYTES=90,PARENT=CARRSEG,FREQ=12
FIELD    NAME=(CRFEFFDT,SEQ,U),BYTES=5,START=1,TYPE=C
FIELD    NAME=CRFSTATE,BYTES=2,START=6,TYPE=C
*
* NEGOTIATED SETTLEMENT AGREEMENT - ONE PER SIGNED AGREEMENT.
*
SEGM     NAME=CARRAGMT,BYTES=120,PARENT=CARRSEG,FREQ=4
FIELD    NAME=(CRAAGMT,SEQ,U),BYTES=8,START=1,TYPE=C
*
DBDGEN
FINISH
END
