*****************************************************************
* CABCIRDB - CIRCUIT DATABASE                                   *
* HIDAM ROOT CIRCSEG KEYED BY CIRCUIT ID, WITH MEET-POINT       *
* BILLING SPLIT AND TERM DATE DEPENDENTS.  INDEXED BY CABCIRIX. *
* QUALIFIED BY CABCT03P.  DATASET TELCABS.IMS.CIRCDB ON THE     *
* VSAM ESDS GROUP DBDCIR.                                       *
* REVISION HISTORY                                              *
*   V1.00  1990-07-16  R.OKAFOR    INITIAL GEN                  *
*   V1.01  1993-01-22  R.OKAFOR    ADDED CIRCMPB                 *
*   V1.02  1994-06-30  L.FENNIMORE ADDED CIRCTERM                *
*   V1.03  1996-10-11  L.FENNIMORE CIRCJUNC SEGMENT (JUNCTION    *
*                                  DETAIL FOR MULTI-HOP TRUNKS)  *
*                                  PLANNED FOR NEXT RELEASE      *
*                                  UNDER CR-3102                 *
*   V1.04  1999-02-08  T.OKONKWO   UNDERLYING OSAM CONVERTED TO  *
*                                  VSAM ESDS PER CABS-STD-014    *
*   V2.00  2005-09-19  D.WASILEWSKI ADDED CISVCTYP FIELD          *
*   V2.01  2014-04-02  M.OYELARAN  RECOMPILE ONLY                *
*****************************************************************
         PRINT NOGEN
CABCIRDB DBD   NAME=CABCIRDB,ACCESS=(HIDAM,VSAM)
*
* PRIMARY VSAM ESDS DATASET.  RANDOMISED ROOT PLACEMENT IS
* NOT USED - ROOT ORDER IS MAINTAINED BY THE CABCIRIX INDEX.
*
DATASET  DD1=CIRCDB1,DEVICE=3390
*
* ROOT - ONE PER CIRCUIT.  CICKTID IS THE ROOT KEY, INDEXED
* VIA THE LCHILD BELOW.
*
SEGM     NAME=CIRCSEG,BYTES=200,PARENT=0,FREQ=15000
LCHILD   NAME=(CIRCIDX,CABCIRIX),POINTER=INDX
FIELD    NAME=(CICKTID,SEQ,U),BYTES=20,START=1,TYPE=C
FIELD    NAME=CIOCN,BYTES=4,START=29,TYPE=C
FIELD    NAME=CISVCTYP,BYTES=2,START=46,TYPE=C
*
* MEET-POINT BILLING SPLIT - ONE PER PARTICIPATING OCN PAIR.
*
SEGM     NAME=CIRCMPB,BYTES=80,PARENT=CIRCSEG,FREQ=2
FIELD    NAME=(CIMOCN,SEQ,U),BYTES=4,START=1,TYPE=C
*
* TERM DATE HISTORY - ONE PER CIRCUIT ORDER ACTIVITY.
*
SEGM     NAME=CIRCTERM,BYTES=70,PARENT=CIRCSEG,FREQ=4
FIELD    NAME=(CITEFFDT,SEQ,U),BYTES=5,START=1,TYPE=C
*
DBDGEN
FINISH
END
