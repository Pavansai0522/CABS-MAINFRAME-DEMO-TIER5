       IDENTIFICATION DIVISION.
      *****************************************************************
      * CABING05 - USAGE TYPE SPLIT: VOICE / DATA / SPECIAL ACCESS    *
      * APPLICATION : CABS                                            *
      * INPUTS      : DTVIN   TELCABS.CABS.USAGE.DATEVAL(0) CABSCDR   *
      * OUTPUTS     : VOCOUT  TELCABS.CABS.USAGE.VOICE(+1)  CABSCDR   *
      *               DATOUT  TELCABS.CABS.USAGE.DATA(+1)   CABSCDR   *
      *               SPCOUT  TELCABS.CABS.USAGE.SPCL(+1)   CABSCDR   *
      *               CLNOUT  TELCABS.CABS.USAGE.CLEAN(+1)  CABSCDR   *
      *               SUSOUT  TELCABS.CABS.USAGE.SUSPENSE(+1) CABSERR *
      * CONTROL     : CTLOUT                               CABSCTL    *
      * BALANCE     : CT-READ = CT-WRITTEN + CT-REJECTED +            *
      *               CT-SUMMARISED + CT-CARRIED-FWD (CT-WRITTEN IS   *
      *               THE CLNOUT COUNT - VOC/DAT/SPC ARE A SECONDARY  *
      *               BREAKOUT AND ARE NOT SEPARATELY BALANCED)       *
      * RESTART     : FULL RERUN                                      *
      * REVISION HISTORY                                              *
      *   V1.00  1991-04-02  R.T.WHEELER  INITIAL - VOICE ONLY        *
      *   V1.10  1994-09-18  D.OKONKWO    DATA SERVICE STREAM ADDED   *
      *   V1.20  1997-12-05  J.M.CASTILLO SPECIAL ACCESS STREAM ADDED *
      *   V2.00  2002-05-21  P.NAIR       CONSOLIDATED CLNOUT STREAM  *
      *                                   INTRODUCED FOR RATING       *
      *   V2.10  2005-08-14  A.BUKOWSKI   FATAL RECORDS EXCLUDED FROM *
      *                                   CLNOUT PER AUDIT FINDING    *
      *                                   CAB-AUD-2005-118            *
      *   V2.11  2009-02-27  S.MARCHETTI  RECOMPILE - NO LOGIC CHANGE *
      *   V2.20  2013-10-09  K.ADEYEMI    VOLUME BAND CLASSIFICATION  *
      *                                   ADDED FOR TRUNK GROUP EDIT  *
      *   V2.21  2017-04-30  M.HOLLIS     RECOMPILE ONLY - LE V7      *
      *   V2.22  2019-11-11  T.VANCE      RECOMPILE ONLY - NO CHANGE  *
      *****************************************************************
       PROGRAM-ID.    CABING05.
       AUTHOR.        RADIANT-DIGITAL-CABS-TEAM.
       DATE-WRITTEN.  1991-04-02.
       DATE-COMPILED.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.   IBM-370.
       OBJECT-COMPUTER.   IBM-370.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DTVIN   ASSIGN TO DTVIN
               ORGANIZATION IS SEQUENTIAL
               FILE STATUS  IS WS-FS-INPUT.
           SELECT VOCOUT  ASSIGN TO VOCOUT
               ORGANIZATION IS SEQUENTIAL
               FILE STATUS  IS WS-FS-VOICE.
           SELECT DATOUT  ASSIGN TO DATOUT
               ORGANIZATION IS SEQUENTIAL
               FILE STATUS  IS WS-FS-DATA.
           SELECT SPCOUT  ASSIGN TO SPCOUT
               ORGANIZATION IS SEQUENTIAL
               FILE STATUS  IS WS-FS-SPCL.
           SELECT CLNOUT  ASSIGN TO CLNOUT
               ORGANIZATION IS SEQUENTIAL
               FILE STATUS  IS WS-FS-OUTPUT.
           SELECT SUSOUT  ASSIGN TO SUSOUT
               ORGANIZATION IS SEQUENTIAL
               FILE STATUS  IS WS-FS-SUSPENSE.
           SELECT CTLOUT  ASSIGN TO CTLOUT
               ORGANIZATION IS SEQUENTIAL
               FILE STATUS  IS WS-FS-CONTROL.

       DATA DIVISION.
       FILE SECTION.
       FD  DTVIN
           RECORDING MODE IS F
           LABEL RECORDS ARE STANDARD
           BLOCK CONTAINS 0 RECORDS
           RECORD CONTAINS 200 CHARACTERS.
           COPY CABSCDR.

       FD  VOCOUT
           RECORDING MODE IS F
           LABEL RECORDS ARE STANDARD
           BLOCK CONTAINS 0 RECORDS
           RECORD CONTAINS 200 CHARACTERS.
       01  VOC-OUT-RECORD                PIC X(200).

       FD  DATOUT
           RECORDING MODE IS F
           LABEL RECORDS ARE STANDARD
           BLOCK CONTAINS 0 RECORDS
           RECORD CONTAINS 200 CHARACTERS.
       01  DAT-OUT-RECORD                PIC X(200).

       FD  SPCOUT
           RECORDING MODE IS F
           LABEL RECORDS ARE STANDARD
           BLOCK CONTAINS 0 RECORDS
           RECORD CONTAINS 200 CHARACTERS.
       01  SPC-OUT-RECORD                PIC X(200).

       FD  CLNOUT
           RECORDING MODE IS F
           LABEL RECORDS ARE STANDARD
           BLOCK CONTAINS 0 RECORDS
           RECORD CONTAINS 200 CHARACTERS.
       01  CLN-OUT-RECORD                PIC X(200).

       FD  SUSOUT
           RECORDING MODE IS F
           LABEL RECORDS ARE STANDARD
           BLOCK CONTAINS 0 RECORDS
           RECORD CONTAINS 300 CHARACTERS.
       01  SUS-OUT-RECORD                PIC X(300).

       FD  CTLOUT
           RECORDING MODE IS F
           LABEL RECORDS ARE STANDARD
           BLOCK CONTAINS 0 RECORDS
           RECORD CONTAINS 180 CHARACTERS.
       01  CTL-OUT-RECORD                PIC X(180).

       WORKING-STORAGE SECTION.
       COPY CABSWRK.

      * OWN WORKING STORAGE - CABSWRK SUPPLIES THE STANDARD SWITCHES,
      * COUNTERS, ACCUMULATORS, FILE STATUS, ERROR CODES, SUSPENSE
      * LAYOUT, DATE WORK AREA AND CONTROL RECORD.  THIS PROGRAM ADDS
      * ITS OWN PER-STREAM FILE STATUS FIELDS BECAUSE CABSWRK ONLY
      * SUPPLIES ONE GENERIC OUTPUT STATUS AND THERE ARE FOUR
      * OUTPUT STREAMS HERE.
       01  WS-PGM-CONSTANTS.
           05  WS-PGM-NAME               PIC X(08) VALUE 'CABING05'.

       01  WS-STREAM-FILE-STATUS.
           05  WS-FS-VOICE               PIC X(02) VALUE '00'.
           05  WS-FS-DATA                PIC X(02) VALUE '00'.
           05  WS-FS-SPCL                PIC X(02) VALUE '00'.

       01  WS-PARM-CARD-AREA.
           05  WS-PARM-RUN-ID            PIC X(12).
           05  WS-PARM-CYCLE-YYDDD       PIC 9(05).
           05  WS-PARM-RERUN-NBR         PIC 9(02).
           05  FILLER                    PIC X(61).
       01  WS-PARM-CARD-ALT REDEFINES WS-PARM-CARD-AREA.
           05  WS-PARM-RAW-TEXT          PIC X(80).

      * 'V' VOICE, 'D' DATA, 'S' SPECIAL ACCESS, 'X' UNROUTABLE
      * (UNBUNDLED / RECIPROCAL COMPENSATION / UNKNOWN REC TYPE).
       01  WS-REC-STREAM-TYPE            PIC X(01).

       01  WS-LOCAL-FATAL-SW             PIC X(01).
           88  WS-LOCAL-FATAL            VALUE 'Y'.
       01  WS-FATAL-ERR-CD               PIC X(04).

      * CABS-STD-006 (SECOND INSTANCE) - VOLUME-BAND CLASS OF THE
      * CDR.  WS-SC-LOCAL-BAND AND WS-SC-REGIONAL-BAND OVERLAP ON
      * '3' - BAND '3' IS ALWAYS TREATED AS LOCAL BECAUSE THE
      * LOCAL TEST RUNS FIRST IN P4110.  THIS IS THE SAME PATTERN
      * AS THE CD-VOICE-MOU / CD-DATA-SVC OVERLAP ON TYPE '03'.
       01  WS-STREAM-CLASS               PIC X(01).
           88  WS-SC-LOCAL-BAND          VALUE '1' '2' '3'.
           88  WS-SC-REGIONAL-BAND       VALUE '3' '4' '5'.

       01  WS-EXTRA-EDIT-SW              PIC X(01).
           88  WS-EXTRA-EDIT-NEEDED      VALUE 'Y'.

       01  WS-STREAM-COUNTERS.
           05  WS-VOICE-CNT              PIC S9(09) COMP-3 VALUE 0.
           05  WS-DATA-CNT               PIC S9(09) COMP-3 VALUE 0.
           05  WS-SPCL-CNT                PIC S9(09) COMP-3 VALUE 0.
           05  WS-UNROUTABLE-CNT          PIC S9(09) COMP-3 VALUE 0.

      * INFORMATIONAL BREAKDOWN OF WS-REJECT-CNT BY DETECTION
      * STAGE - HELPS OPERATIONS TELL WHETHER A BAD RUN IS A
      * JURISDICTION PROBLEM, A DETAIL-EDIT PROBLEM OR AN
      * UPSTREAM MEDIATION PROBLEM WITHOUT OPENING SUSOUT.
       01  WS-STREAM-FAIL-STATS.
           05  WS-JURIS-FAIL-CNT         PIC S9(07) COMP-3 VALUE 0.
           05  WS-VOICE-FAIL-CNT         PIC S9(07) COMP-3 VALUE 0.
           05  WS-DATA-FAIL-CNT          PIC S9(07) COMP-3 VALUE 0.
           05  WS-SPCL-FAIL-CNT          PIC S9(07) COMP-3 VALUE 0.
           05  WS-ROUTE-FAIL-CNT         PIC S9(07) COMP-3 VALUE 0.

       01  WS-CALL-PARM-AREA.
           05  WS-HASH-SEQ-IN             PIC S9(09) COMP-3.
           05  WS-HASH-OCN-IN             PIC X(04).

       01  WS-ABEND-CD                    PIC X(04).
       01  WS-ABEND-RSN                   PIC X(40).
       01  WS-DETECT-PARA-LIT             PIC X(30).

      * MPB PERCENT IS A SIGNED 5-DECIMAL FIELD IN THE COPYBOOK -
      * THIS ALTERNATE WHOLE-PERCENT VIEW IS USED FOR THE RANGE
      * EDIT SO THE COMPARISON LITERALS STAY SMALL INTEGERS.
       01  WS-MPB-PCT-WORK               PIC S9(03)V9(05) COMP-3.
       01  WS-MPB-PCT-WHOLE REDEFINES WS-MPB-PCT-WORK.
           05  FILLER                    PIC S9(03).
           05  FILLER                    PIC 9(05).

      * VOICE DETAIL VALIDATION WORK.
       01  WS-VOICE-EDIT-SW              PIC X(01).
           88  WS-VOICE-EDIT-OK          VALUE 'Y'.
       01  WS-CIC-CHECK-WORK             PIC 9(04).

      * DATA DETAIL VALIDATION WORK - CLASS-OF-SERVICE TABLE
      * LOADED BY REDEFINES, NOT INITIALIZE, SAME TECHNIQUE AS
      * THE STATE-CODE TABLE IN CABING02.
       01  WS-COS-CONSTANTS.
           05  FILLER  PIC X(24) VALUE 'EF  AF11AF21BE  DEFLBEEF'.
       01  WS-COS-TABLE REDEFINES WS-COS-CONSTANTS.
           05  WS-COS-VALUE OCCURS 6 TIMES
                                       PIC X(04).
       01  WS-COS-SUB                    PIC S9(04) COMP.
       01  WS-COS-FOUND-SW               PIC X(01).
           88  WS-COS-FOUND              VALUE 'Y'.

      * SPECIAL ACCESS DETAIL VALIDATION WORK.
       01  WS-TERM-MONTHS-MIN            PIC 9(03) VALUE 1.
       01  WS-TERM-MONTHS-MAX            PIC 9(03) VALUE 240.

       PROCEDURE DIVISION.

       S000-MAINLINE SECTION.
       P0000-MAINLINE.
           PERFORM P1000-INIT THRU P1000-EXIT.
           PERFORM P2000-PROCESS THRU P2000-EXIT
               UNTIL WS-EOF.
           PERFORM P8000-CONTROL THRU P8000-EXIT.
           PERFORM P9000-TERM THRU P9000-EXIT.
           STOP RUN.

       S100-INIT SECTION.
       P1000-INIT.
           PERFORM P1100-OPEN-FILES THRU P1100-EXIT.
           PERFORM P1200-READ-PARM-CARD THRU P1200-EXIT.
           PERFORM P2100-READ-DTVIN THRU P2100-EXIT.
       P1000-EXIT.
           EXIT.

       P1100-OPEN-FILES.
           OPEN INPUT  DTVIN.
           OPEN OUTPUT VOCOUT.
           OPEN OUTPUT DATOUT.
           OPEN OUTPUT SPCOUT.
           OPEN OUTPUT CLNOUT.
           OPEN OUTPUT SUSOUT.
           OPEN OUTPUT CTLOUT.
           IF WS-FS-INPUT NOT = '00'
               MOVE 'I001' TO WS-ABEND-CD
               MOVE 'CABING05 - DTVIN OPEN FAILED' TO WS-ABEND-RSN
               CALL 'CABABEND' USING WS-ABEND-CD WS-ABEND-RSN.
       P1100-EXIT.
           EXIT.

       P1200-READ-PARM-CARD.
           CALL 'CABPARMR' USING WS-PARM-CARD-AREA.
           MOVE WS-PARM-RUN-ID           TO CT-RUN-ID.
           MOVE WS-PGM-NAME              TO CT-PROCESS-ID.
           MOVE WS-PARM-CYCLE-YYDDD      TO CT-CYCLE-YYDDD.
           MOVE WS-PARM-RERUN-NBR        TO CT-RERUN-NBR.
           MOVE 5                        TO CT-STEP-SEQ.
       P1200-EXIT.
           EXIT.

       S200-PROCESS SECTION.
       P2000-PROCESS.
           MOVE 'N' TO WS-LOCAL-FATAL-SW.
           MOVE SPACES TO WS-FATAL-ERR-CD.
           PERFORM P3000-ROUTE-BY-TYPE THRU P3000-EXIT.
           IF CD-FATAL OR WS-LOCAL-FATAL
               PERFORM P4300-SPLIT-FATAL THRU P4400-EXIT
           ELSE
               PERFORM P4500-WRITE-STREAM-OUT THRU P4500-EXIT
               PERFORM P4400-SPLIT-CLEAN THRU P4400-EXIT.
           PERFORM P2100-READ-DTVIN THRU P2100-EXIT.
       P2000-EXIT.
           EXIT.

       P2100-READ-DTVIN.
           READ DTVIN
               AT END
                   MOVE 'Y' TO WS-EOF-SW
               NOT AT END
                   ADD 1 TO WS-READ-CNT.
       P2100-EXIT.
           EXIT.

       S300-ROUTE SECTION.
      * CABS-STD-006 - CD-VOICE-MOU AND CD-DATA-SVC BOTH INCLUDE
      * TYPE '03'.  CD-VOICE-MOU IS TESTED FIRST SO '03' ALWAYS
      * ROUTES AS VOICE.  THE '05' OVERLAP BETWEEN CD-DATA-SVC AND
      * CD-SPECIAL-ACC FURTHER DOWN THE LADDER BEHAVES THE SAME WAY.
      * THE ORDER OF THE TESTS BELOW IS THEREFORE SIGNIFICANT AND
      * REFLECTS THE 1991 SPECIAL ACCESS CUTOVER SEQUENCE.
       P3000-ROUTE-BY-TYPE.
           PERFORM P3050-CHECK-JURISDICTION THRU P3050-EXIT.
           PERFORM P3060-CHECK-RATE-ELEM THRU P3060-EXIT.
           IF CD-VOICE-MOU
               MOVE 'V' TO WS-REC-STREAM-TYPE
               PERFORM P4100-VALIDATE-VOICE THRU P4100-EXIT
           ELSE
               IF CD-DATA-SVC
                   MOVE 'D' TO WS-REC-STREAM-TYPE
                   PERFORM P4200-VALIDATE-DATA THRU P4200-EXIT
               ELSE
                   IF CD-SPECIAL-ACC
                       MOVE 'S' TO WS-REC-STREAM-TYPE
                       PERFORM P4250-VALIDATE-SPCL THRU P4250-EXIT
                   ELSE
                       PERFORM P3900-HANDLE-UNROUTABLE THRU P3900-EXIT.
       P3000-EXIT.
           EXIT.

      * CD-JURIS-CD MUST BE ONE OF THE FOUR RECOGNISED VALUES -
      * INTERSTATE, INTRASTATE, LOCAL OR INDETERMINATE.  ANYTHING
      * ELSE MEANS THE MEDIATION FEED SENT A CODE THIS ESTATE
      * HAS NEVER SEEN.  THIS EDIT APPLIES TO ALL THREE STREAMS
      * SO IT RUNS ONCE HERE RATHER THAN IN EACH DETAIL VALIDATOR.
       P3050-CHECK-JURISDICTION.
           IF NOT CD-INTERSTATE AND NOT CD-INTRASTATE
               AND NOT CD-LOCAL AND NOT CD-INDETERMINATE
               MOVE EC-JURIS-INDET TO WS-FATAL-ERR-CD
               MOVE 'Y' TO WS-LOCAL-FATAL-SW
               ADD 1 TO WS-JURIS-FAIL-CNT.
       P3050-EXIT.
           EXIT.

      * CD-RATE-ELEM IS THE KEY THE RATING FAMILY USES TO LOOK UP
      * THE TARIFF ELEMENT ON RATEMST - A BLANK VALUE WOULD FAIL
      * THAT LOOKUP MANY STEPS DOWNSTREAM, SO IT IS CAUGHT HERE
      * WHILE THE ORIGINAL CDR IS STILL AVAILABLE FOR SUSPENSE.
       P3060-CHECK-RATE-ELEM.
           IF CD-RATE-ELEM = SPACES
               MOVE EC-RATE-NOT-FOUND TO WS-FATAL-ERR-CD
               MOVE 'Y' TO WS-LOCAL-FATAL-SW
               ADD 1 TO WS-ROUTE-FAIL-CNT.
       P3060-EXIT.
           EXIT.

      * UNBUNDLED NETWORK ELEMENT AND RECIPROCAL COMPENSATION
      * RECORDS (CD-UNBUNDLED, CD-RECIP-COMP) HAVE NO DETAIL
      * VARIANT DEFINED IN THIS COPYBOOK AND NO OUTPUT STREAM IN
      * THIS PROGRAM - THEY ARE SUSPENDED FOR MANUAL ROUTING, AS
      * IS ANY REC TYPE OUTSIDE CD-VALID-TYPE ALTOGETHER.
       P3900-HANDLE-UNROUTABLE.
           MOVE 'X' TO WS-REC-STREAM-TYPE.
           MOVE EC-CIRCUIT-UNKNOWN TO WS-FATAL-ERR-CD.
           MOVE 'Y' TO WS-LOCAL-FATAL-SW.
           ADD 1 TO WS-UNROUTABLE-CNT.
           ADD 1 TO WS-ROUTE-FAIL-CNT.
       P3900-EXIT.
           EXIT.

       S400-SPLIT SECTION.
      * VOICE DETAIL EDIT - CONVERSATION AND CHARGEABLE MINUTES
      * MAY NOT BE NEGATIVE.  A VOLUME BAND IS ALSO CLASSIFIED
      * HERE FOR THE TRUNK GROUP EDIT INTRODUCED IN V2.20.
       P4100-VALIDATE-VOICE.
           ADD 1 TO WS-VOICE-CNT.
           IF CD-VC-CONV-MIN < 0 OR CD-VC-CHG-MIN < 0
               MOVE EC-MIN-NEGATIVE TO WS-FATAL-ERR-CD
               MOVE 'Y' TO WS-LOCAL-FATAL-SW.
           PERFORM P4105-CHECK-NPANXX THRU P4105-EXIT.
           PERFORM P4106-CHECK-END-OFFICE THRU P4106-EXIT.
           PERFORM P4108-CHECK-LATA THRU P4108-EXIT.
           PERFORM P4109-CHECK-CIC THRU P4109-EXIT.
           PERFORM P4110-CLASSIFY-VOLUME-BAND THRU P4110-EXIT.
           IF WS-LOCAL-FATAL
               ADD 1 TO WS-VOICE-FAIL-CNT.
       P4100-EXIT.
           EXIT.

      * BOTH NPANXX FIELDS MUST BE SIX NUMERIC DIGITS - A CLASS
      * TEST IS ENOUGH, NO NEED TO WALK THE FIELD CHARACTER BY
      * CHARACTER FOR A SIMPLE ALL-NUMERIC CHECK LIKE THIS ONE.
       P4105-CHECK-NPANXX.
           MOVE 'Y' TO WS-VOICE-EDIT-SW.
           IF CD-VC-ORIG-NPANXX NOT NUMERIC
               MOVE 'N' TO WS-VOICE-EDIT-SW.
           IF CD-VC-TERM-NPANXX NOT NUMERIC
               MOVE 'N' TO WS-VOICE-EDIT-SW.
           IF NOT WS-VOICE-EDIT-OK
               MOVE EC-CIRCUIT-UNKNOWN TO WS-FATAL-ERR-CD
               MOVE 'Y' TO WS-LOCAL-FATAL-SW.
       P4105-EXIT.
           EXIT.

      * ORIGINATING AND TERMINATING LATA MUST BOTH BE PRESENT -
      * A ZERO LATA MEANS THE MEDIATION FEED DID NOT POPULATE IT.
      * A DIRECT-TRUNKED CALL (NOT TANDEM-SWITCHED) MUST IDENTIFY
      * ITS END OFFICE - TANDEM-SWITCHED CALLS ROUTE THROUGH THE
      * CIC INSTEAD AND ARE EXEMPT FROM THIS EDIT.
       P4106-CHECK-END-OFFICE.
           IF CD-VC-TANDEM-IND = 'N' AND CD-VC-END-OFFICE = SPACES
               MOVE EC-CIRCUIT-UNKNOWN TO WS-FATAL-ERR-CD
               MOVE 'Y' TO WS-LOCAL-FATAL-SW.
       P4106-EXIT.
           EXIT.

       P4108-CHECK-LATA.
           IF CD-VC-ORIG-LATA = ZERO OR CD-VC-TERM-LATA = ZERO
               MOVE EC-CIRCUIT-UNKNOWN TO WS-FATAL-ERR-CD
               MOVE 'Y' TO WS-LOCAL-FATAL-SW.
       P4108-EXIT.
           EXIT.

      * A TANDEM-SWITCHED CALL MUST CARRY A NON-ZERO CIC (CARRIER
      * IDENTIFICATION CODE) OR THE ORIGINATING CARRIER CANNOT BE
      * DETERMINED DOWNSTREAM IN RATING.
       P4109-CHECK-CIC.
           MOVE CD-VC-CIC TO WS-CIC-CHECK-WORK.
           IF CD-VC-TANDEM-IND = 'Y' AND WS-CIC-CHECK-WORK = ZERO
               MOVE EC-CIRCUIT-UNKNOWN TO WS-FATAL-ERR-CD
               MOVE 'Y' TO WS-LOCAL-FATAL-SW.
       P4109-EXIT.
           EXIT.

       P4110-CLASSIFY-VOLUME-BAND.
           IF CD-VC-CHG-MIN > 999
               MOVE '5' TO WS-STREAM-CLASS
           ELSE
               IF CD-VC-CHG-MIN > 599
                   MOVE '4' TO WS-STREAM-CLASS
               ELSE
                   IF CD-VC-CHG-MIN > 299
                       MOVE '3' TO WS-STREAM-CLASS
                   ELSE
                       IF CD-VC-CHG-MIN > 59
                           MOVE '2' TO WS-STREAM-CLASS
                       ELSE
                           MOVE '1' TO WS-STREAM-CLASS.
           MOVE 'N' TO WS-EXTRA-EDIT-SW.
           IF WS-SC-LOCAL-BAND
               MOVE 'N' TO WS-EXTRA-EDIT-SW
           ELSE
               IF WS-SC-REGIONAL-BAND
                   MOVE 'Y' TO WS-EXTRA-EDIT-SW.
           IF WS-EXTRA-EDIT-NEEDED AND CD-VC-TRUNK-GRP = SPACES
               MOVE EC-CIRCUIT-UNKNOWN TO WS-FATAL-ERR-CD
               MOVE 'Y' TO WS-LOCAL-FATAL-SW.
       P4110-EXIT.
           EXIT.

      * DATA DETAIL EDIT - OCTETS MAY NOT BE NEGATIVE, BANDWIDTH
      * MUST BE PRESENT (IT DRIVES THE RATING FACTOR LOOKUP LATER
      * IN THE RATING FAMILY).
       P4200-VALIDATE-DATA.
           ADD 1 TO WS-DATA-CNT.
           IF CD-DT-OCTETS-IN < 0 OR CD-DT-OCTETS-OUT < 0
               MOVE EC-MIN-NEGATIVE TO WS-FATAL-ERR-CD
               MOVE 'Y' TO WS-LOCAL-FATAL-SW.
           IF CD-DT-BANDWIDTH = 0
               MOVE EC-FACTOR-MISSING TO WS-FATAL-ERR-CD
               MOVE 'Y' TO WS-LOCAL-FATAL-SW.
           PERFORM P4210-CHECK-COS THRU P4210-EXIT.
           PERFORM P4220-CHECK-LOCATIONS THRU P4220-EXIT.
           IF WS-LOCAL-FATAL
               ADD 1 TO WS-DATA-FAIL-CNT.
       P4200-EXIT.
           EXIT.

      * CLASS OF SERVICE MUST BE ONE OF THE SIX RECOGNISED CODES.
      * SUBSCRIPTED LINEAR SEARCH OF A SMALL CONSTANT TABLE.
       P4210-CHECK-COS.
           MOVE 'N' TO WS-COS-FOUND-SW.
           PERFORM P4215-SEARCH-COS THRU P4215-EXIT
               VARYING WS-COS-SUB FROM 1 BY 1
               UNTIL WS-COS-SUB > 6
               OR WS-COS-FOUND.
           IF NOT WS-COS-FOUND
               MOVE EC-CIRCUIT-UNKNOWN TO WS-FATAL-ERR-CD
               MOVE 'Y' TO WS-LOCAL-FATAL-SW.
       P4210-EXIT.
           EXIT.

       P4215-SEARCH-COS.
           IF WS-COS-VALUE (WS-COS-SUB) = CD-DT-CoS
               MOVE 'Y' TO WS-COS-FOUND-SW.
       P4215-EXIT.
           EXIT.

      * A-LOC/Z-LOC IDENTIFY THE TWO ENDS OF THE CIRCUIT - NEITHER
      * MAY BE BLANK ON A DATA SERVICE RECORD.
       P4220-CHECK-LOCATIONS.
           IF CD-DT-A-LOC = SPACES OR CD-DT-Z-LOC = SPACES
               MOVE EC-CIRCUIT-UNKNOWN TO WS-FATAL-ERR-CD
               MOVE 'Y' TO WS-LOCAL-FATAL-SW.
       P4220-EXIT.
           EXIT.

      * SPECIAL ACCESS DETAIL EDIT - QUANTITY MAY NOT BE NEGATIVE.
      * WHEN THE MEET-POINT-BILLING INDICATOR IS SET, THE PERCENT
      * MUST FALL BETWEEN 0 AND 100.
       P4250-VALIDATE-SPCL.
           ADD 1 TO WS-SPCL-CNT.
           IF CD-SP-QTY < 0
               MOVE EC-MIN-NEGATIVE TO WS-FATAL-ERR-CD
               MOVE 'Y' TO WS-LOCAL-FATAL-SW.
           MOVE CD-SP-MPB-PCT TO WS-MPB-PCT-WORK.
           IF CD-SP-MPB-IND = 'Y'
               IF WS-MPB-PCT-WORK < 0 OR WS-MPB-PCT-WORK > 100
                   MOVE EC-MPB-PCT-INVALID TO WS-FATAL-ERR-CD
                   MOVE 'Y' TO WS-LOCAL-FATAL-SW.
           PERFORM P4260-CHECK-USOC THRU P4260-EXIT.
           PERFORM P4270-CHECK-TERM-MONTHS THRU P4270-EXIT.
           PERFORM P4280-CHECK-OTHER-LEC THRU P4280-EXIT.
           IF WS-LOCAL-FATAL
               ADD 1 TO WS-SPCL-FAIL-CNT.
       P4250-EXIT.
           EXIT.

      * USOC (UNIFORM SERVICE ORDER CODE) IDENTIFIES THE TARIFFED
      * ELEMENT BEING BILLED - IT MAY NOT BE BLANK.
       P4260-CHECK-USOC.
           IF CD-SP-USOC = SPACES
               MOVE EC-CIRCUIT-UNKNOWN TO WS-FATAL-ERR-CD
               MOVE 'Y' TO WS-LOCAL-FATAL-SW.
       P4260-EXIT.
           EXIT.

      * CONTRACT TERM MUST FALL WITHIN A REALISTIC RANGE - ZERO
      * MEANS MONTH-TO-MONTH, WHICH THIS FEED DOES NOT SUPPORT,
      * AND ANYTHING OVER 20 YEARS IS TREATED AS A DATA ERROR.
       P4270-CHECK-TERM-MONTHS.
           IF CD-SP-TERM-MONTHS < WS-TERM-MONTHS-MIN
               OR CD-SP-TERM-MONTHS > WS-TERM-MONTHS-MAX
               MOVE EC-CIRCUIT-UNKNOWN TO WS-FATAL-ERR-CD
               MOVE 'Y' TO WS-LOCAL-FATAL-SW.
       P4270-EXIT.
           EXIT.

      * WHEN THE CIRCUIT IS UNDER A MEET-POINT-BILLING ARRANGEMENT
      * THE PARTNER LEC MUST BE IDENTIFIED SO THE SPLIT CAN BE
      * SETTLED IN THE SETL APPLICATION LATER IN THE PIPELINE.
       P4280-CHECK-OTHER-LEC.
           IF CD-SP-MPB-IND = 'Y' AND CD-SP-OTHER-LEC = SPACES
               MOVE EC-CIRCUIT-UNKNOWN TO WS-FATAL-ERR-CD
               MOVE 'Y' TO WS-LOCAL-FATAL-SW.
       P4280-EXIT.
           EXIT.

      * FATAL RECORDS - ERROR CODE, SUSPENSE WRITE, REJECT COUNT.
       P4300-SPLIT-FATAL.
           MOVE WS-FATAL-ERR-CD    TO SU-ERR-CODE.
           MOVE 'F'                TO SU-ERR-SEVERITY.
           MOVE WS-PGM-NAME        TO SU-DETECT-PGM.
           MOVE 'P4300-SPLIT-FATAL' TO WS-DETECT-PARA-LIT.
           MOVE WS-DETECT-PARA-LIT TO SU-DETECT-PARA.
           MOVE CT-RUN-ID          TO SU-RUN-ID.
           MOVE CABS-CDR-RECORD    TO SU-ORIG-RECORD.
           MOVE SPACES             TO SU-FILLER.
           CALL 'CABERRWR' USING CABS-SUSPENSE-RECORD.
           WRITE SUS-OUT-RECORD FROM CABS-SUSPENSE-RECORD.
           ADD 1 TO WS-REJECT-CNT.

       P4400-SPLIT-CLEAN.
           WRITE CLN-OUT-RECORD FROM CABS-CDR-RECORD.
           ADD 1 TO WS-WRITE-CNT.
           MOVE CD-SEQ-NBR TO WS-HASH-SEQ-IN.
           MOVE CD-OCN     TO WS-HASH-OCN-IN.
           CALL 'CABHASH' USING WS-ACC-SEQ-HASH WS-HASH-SEQ-IN
                                 WS-ACC-OCN-HASH WS-HASH-OCN-IN.
       P4400-EXIT.
           EXIT.

       P4500-WRITE-STREAM-OUT.
           IF WS-REC-STREAM-TYPE = 'V'
               WRITE VOC-OUT-RECORD FROM CABS-CDR-RECORD
           ELSE
               IF WS-REC-STREAM-TYPE = 'D'
                   WRITE DAT-OUT-RECORD FROM CABS-CDR-RECORD
               ELSE
                   IF WS-REC-STREAM-TYPE = 'S'
                       WRITE SPC-OUT-RECORD FROM CABS-CDR-RECORD
                   ELSE
                       ADD 1 TO WS-UNROUTABLE-CNT.
       P4500-EXIT.
           EXIT.

       S800-CONTROL SECTION.
      * THIS STEP NEVER SUMMARISES OR CARRIES RECORDS FORWARD, SO
      * BOTH COUNTS ARE ALWAYS ZERO HERE.
       P8000-CONTROL.
           MOVE WS-PGM-NAME     TO CT-JOBNAME.
           MOVE WS-PGM-NAME     TO CT-STEPNAME.
           MOVE ZERO            TO CT-BILL-PERIOD.
           MOVE WS-READ-CNT     TO CT-READ.
           MOVE WS-WRITE-CNT    TO CT-WRITTEN.
           MOVE WS-REJECT-CNT   TO CT-REJECTED.
           MOVE ZERO            TO CT-SUMMARISED.
           MOVE ZERO            TO CT-CARRIED-FWD.
           MOVE WS-ACC-MINUTES  TO CT-HASH-MINUTES.
           MOVE WS-ACC-AMOUNT   TO CT-HASH-AMOUNT.
           MOVE WS-ACC-SEQ-HASH TO CT-HASH-SEQ.
           MOVE WS-ACC-OCN-HASH TO CT-HASH-OCN.
           IF CT-READ = CT-WRITTEN + CT-REJECTED
                        + CT-SUMMARISED + CT-CARRIED-FWD
               MOVE 'B' TO CT-BAL-IND
           ELSE
               MOVE 'O' TO CT-BAL-IND.
           MOVE ZERO   TO CT-RC.
           MOVE SPACES TO CT-ABEND-CD.
           MOVE SPACES TO CT-RESTART-KEY.
           MOVE SPACES TO CT-FILLER.
           WRITE CTL-OUT-RECORD FROM CABS-CONTROL-RECORD.
       P8000-EXIT.
           EXIT.

       S900-TERM SECTION.
       P9000-TERM.
           CLOSE DTVIN.
           CLOSE VOCOUT.
           CLOSE DATOUT.
           CLOSE SPCOUT.
           CLOSE CLNOUT.
           CLOSE SUSOUT.
           CLOSE CTLOUT.
       P9000-EXIT.
           EXIT.
