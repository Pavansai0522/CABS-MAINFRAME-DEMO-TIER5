      *****************************************************************
      * CABING07 - SUSPENSE CONSOLIDATION AND AUDIT LOGGING           *
      * APPLICATION : CABS                                            *
      * INPUTS      : DDNAME  DSN                          COPYBOOK   *
      *               SUSIN   TELCABS.CABS.USAGE.SUSPENSE(0) CABSERR  *
      * OUTPUTS     : DDNAME  DSN                          COPYBOOK   *
      *               SUSOUT  TELCABS.CABS.USAGE.SUSPENSE(+1) CABSERR *
      *               RPTOUT  SYSOUT FBA 133                CABSPRNT  *
      *               AUDLOG  TELCABS.CABS.AUDIT.LOG (EXTEND) (LOCAL) *
      * CONTROL     : CTLOUT                               CABSCTL    *
      * BALANCE     : CT-READ = CT-SUMMARISED + CT-REJECTED (ALL      *
      *               SUSIN FOLDS INTO THE TABLE, NONE 1-FOR-1)       *
      * RESTART     : FULL RERUN                                     *
      * NOTE        : AUDLOG EXTEND - ORDER OF THE 3 RECS/RUN IS THE  *
      *               AUDIT TRAIL, READ BACK POSITIONALLY DOWNSTREAM. *
      * REVISION HISTORY                                              *
      *   V1.00  1989-06-02  R.T.WHEELER  INITIAL CONSOLIDATION ONLY  *
      *   V1.03  1993-02-11  D.OKONKWO    SEVERITY BREAKOUT ADDED     *
      *   V1.06  1998-09-25  J.M.CASTILLO PRINTED EXCEPTION RPT ADDED *
      *   V2.00  2000-01-04  P.NAIR       Y2K REVIEW - NO IMPACT      *
      *   V2.02  2005-11-19  A.BUKOWSKI   AUDLOG APPEND TRAIL ADDED   *
      *   V2.05  2013-04-08  K.ADEYEMI    SUMMARY TABLE SIZE 50       *
      *   V2.07  2019-09-30  M.HOLLIS     RECOMPILE ONLY - LE V7      *
      *****************************************************************
       IDENTIFICATION DIVISION.
       PROGRAM-ID.    CABING07.
       AUTHOR.        RADIANT-CABS-TEAM.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER. IBM-Z15.
       OBJECT-COMPUTER. IBM-Z15.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT SUSIN  ASSIGN TO SUSIN
               ORGANIZATION SEQUENTIAL FILE STATUS WS-FS-INPUT.
           SELECT SUSOUT ASSIGN TO SUSOUT
               ORGANIZATION SEQUENTIAL FILE STATUS WS-FS-OUTPUT.
           SELECT RPTOUT ASSIGN TO RPTOUT
               ORGANIZATION SEQUENTIAL FILE STATUS WS-FS-TABLE.
           SELECT AUDLOG ASSIGN TO AUDLOG
               ORGANIZATION SEQUENTIAL FILE STATUS WS-FS-SUSPENSE.
           SELECT CTLOUT ASSIGN TO CTLOUT
               ORGANIZATION SEQUENTIAL FILE STATUS WS-FS-CONTROL.
       DATA DIVISION.
       FILE SECTION.
       FD  SUSIN
           RECORDING MODE IS F RECORD CONTAINS 300 CHARACTERS.
       01  SUSIN-RECORD                    PIC X(300).
       FD  SUSOUT
           RECORDING MODE IS F RECORD CONTAINS 300 CHARACTERS.
       01  SUSOUT-RECORD                   PIC X(300).
       FD  RPTOUT
           RECORDING MODE IS F RECORD CONTAINS 133 CHARACTERS.
           COPY CABSPRNT.
       FD  AUDLOG
           RECORDING MODE IS F RECORD CONTAINS 300 CHARACTERS.
       01  AUDLOG-RECORD                   PIC X(300).
       FD  CTLOUT
           RECORDING MODE IS F RECORD CONTAINS 180 CHARACTERS.
       01  CTLOUT-RECORD                   PIC X(180).
       WORKING-STORAGE SECTION.
      * STANDARD ESTATE WORKING STORAGE (COUNTERS/SWITCHES/DATE/CTL)
           COPY CABSWRK.
      * CONSOLIDATION TABLE - GROUPS SUSIN BY ERR-CODE+PGM, BY SEVERITY.
       01  WS-SUMMARY-TABLE.
           05  WS-SUM-ENTRY OCCURS 50 TIMES.
               10  SM-ERR-CODE             PIC X(04).
               10  SM-DETECT-PGM           PIC X(08).
               10  SM-WARN-CNT             PIC S9(05) COMP-3 VALUE 0.
               10  SM-ERROR-CNT            PIC S9(05) COMP-3 VALUE 0.
               10  SM-FATAL-CNT            PIC S9(05) COMP-3 VALUE 0.
               10  SM-TOTAL-CNT            PIC S9(05) COMP-3 VALUE 0.
               10  SM-LAST-PARA-NBR        PIC X(04).
               10  SM-LAST-VERB            PIC X(12).
               10  SM-LAST-SEV             PIC X(01).
       01  WS-SUMMARY-CTL.
           05  WS-SUM-COUNT                PIC S9(04) COMP-3 VALUE 0.
           05  WS-SUM-MAX                  PIC S9(04) COMP-3
                                                          VALUE 50.
           05  WS-SUM-SUB                  PIC S9(04) COMP-3 VALUE 0.
           05  WS-SUM-FOUND-SW             PIC X(01) VALUE 'N'.
               88  WS-SUM-FOUND            VALUE 'Y'.
      * CABS-STD-020 - UNSTRING SU-DETECT-PARA INTO PARA NBR + VERB
       01  WS-DETECT-PARA-SPLIT.
           05  WS-DPS-RAW                  PIC X(30).
       01  WS-DETECT-PARA-ALT REDEFINES WS-DETECT-PARA-SPLIT.
           05  WS-DPS-FIRST-4              PIC X(04).
           05  WS-DPS-REST                 PIC X(26).
       01  WS-UNSTRING-AREA.
           05  WS-UNS-PARA-NBR             PIC X(04).
           05  WS-UNS-VERB                 PIC X(12).
           05  WS-UNS-PTR                  PIC S9(03) COMP-3.
      * CABS-STD-020 - STRING ASSEMBLY FOR REPORT LINE AND AUDIT TEXT
       01  WS-STRING-AREA.
           05  WS-STR-PTR                  PIC S9(03) COMP-3.
           05  WS-STR-SEVERITY-WORD        PIC X(07).
           05  WS-STR-COUNT-DISPLAY        PIC ZZZZ9.
           05  WS-STR-GROUPS-DISP          PIC ZZZ9.
           05  WS-STR-READ-DISP            PIC ZZZZZ9.
           05  WS-STR-REPORT-LINE          PIC X(120).
           05  WS-STR-AUDIT-TEXT           PIC X(120).
      * VALID SEVERITY CODE LIST - CHECKED VIA SUBSCRIPTED SEARCH
       01  WS-SEVERITY-CODES.
           05  WS-SEV-CODE-LIST            PIC X(03) VALUE 'WEF'.
       01  WS-SEVERITY-CODE-TBL REDEFINES WS-SEVERITY-CODES.
           05  WS-SEV-CODE-CHAR OCCURS 3 TIMES PIC X(01).
      * RUN IDENTIFICATION
       01  WS-RUN-ID-AREA.
           05  WS-RUN-ID-RAW               PIC X(12).
       01  WS-RUN-ID-SPLIT REDEFINES WS-RUN-ID-AREA.
           05  WS-RUN-ID-PREFIX            PIC X(08).
           05  WS-RUN-ID-SUFFIX            PIC X(04).
       01  WS-PROGRAM-CONSTANTS.
           05  WS-PGM-NAME                 PIC X(08) VALUE 'CABING07'.
           05  WS-PROCESS-ID               PIC X(08) VALUE 'ING07   '.
       01  WS-RUN-STATISTICS.
           05  WS-RPT-LINE-CNT             PIC S9(05) COMP-3 VALUE 0.
           05  WS-AUD-WRITE-CNT            PIC S9(03) COMP-3 VALUE 0.
           05  WS-CONSOL-WRITE-CNT         PIC S9(05) COMP-3 VALUE 0.
           05  WS-CT-BAL-CHECK             PIC S9(11) COMP-3 VALUE 0.
       01  WS-CALL-PARM-AREA.
           05  WS-CP-DATE-OUT              PIC 9(08).
           05  WS-CP-RC                    PIC S9(04) COMP-3.
       01  WS-ABEND-WORK-AREA.
           05  WS-ABEND-REASON             PIC X(40).
       01  WS-EDIT-SWITCHES.
           05  WS-INPUT-OK-SW              PIC X(01) VALUE 'Y'.
               88  WS-INPUT-OK             VALUE 'Y'.
       PROCEDURE DIVISION.
       S100-MAINLINE SECTION.
       P0000-MAINLINE.
           PERFORM P1000-INIT THRU P1000-EXIT.
           PERFORM P2000-PROCESS THRU P2000-EXIT
               UNTIL WS-EOF.
           PERFORM P4000-PRINT-REPORT THRU P4000-EXIT.
           PERFORM P5000-AUDIT-LOG THRU P5000-EXIT.
           PERFORM P8000-CONTROL THRU P8000-EXIT.
           PERFORM P9000-TERM THRU P9000-EXIT.
           STOP RUN.
       S200-INITIALIZATION SECTION.
       P1000-INIT.
           PERFORM P1100-OPEN-FILES THRU P1100-EXIT.
           CALL 'CABPARMR' USING WS-RUN-ID-RAW.
           CALL 'CABDTCNV' USING DW-CURRENT-YYDDD WS-CP-DATE-OUT
               WS-CP-RC.
           MOVE 'N' TO WS-EOF-SW.
           MOVE ZERO TO WS-SUM-COUNT.
           PERFORM P3100-READ-SUSIN THRU P3100-EXIT.
       P1000-EXIT.
           EXIT.
       P1100-OPEN-FILES.
           OPEN INPUT  SUSIN.
           OPEN OUTPUT SUSOUT.
           OPEN OUTPUT RPTOUT.
           OPEN EXTEND AUDLOG.
           OPEN OUTPUT CTLOUT.
       P1100-EXIT.
           EXIT.
       S300-RECORD-PROCESSING SECTION.
       P2000-PROCESS.
           ADD 1 TO WS-READ-CNT.
           MOVE SUSIN-RECORD TO CABS-SUSPENSE-RECORD.
           IF SU-ERR-CODE = SPACES
               ADD 1 TO WS-REJECT-CNT
               GO TO P2000-READ-NEXT.
           ADD 1 TO WS-SUMM-CNT.
           PERFORM P2300-UNSTRING-DETECT-PARA THRU P2300-EXIT.
           PERFORM P2100-FIND-OR-INSERT THRU P2100-EXIT.
           PERFORM P2200-UPDATE-SEVERITY THRU P2200-EXIT.
       P2000-READ-NEXT.
           PERFORM P3100-READ-SUSIN THRU P3100-EXIT.
       P2000-EXIT.
           EXIT.
      * P2100 SEARCHES FOR A MATCHING ERR-CODE/PGM, INSERTS ON MISS.
       P2100-FIND-OR-INSERT.
           MOVE 'N' TO WS-SUM-FOUND-SW.
           MOVE 1 TO WS-SUM-SUB.
           PERFORM P2110-SCAN-ENTRY THRU P2110-EXIT
               UNTIL WS-SUM-SUB > WS-SUM-COUNT
               OR WS-SUM-FOUND.
           IF WS-SUM-FOUND
               GO TO P2100-EXIT.
           IF WS-SUM-COUNT NOT < WS-SUM-MAX
               GO TO P2100-EXIT.
           ADD 1 TO WS-SUM-COUNT.
           MOVE WS-SUM-COUNT TO WS-SUM-SUB.
           MOVE SU-ERR-CODE TO SM-ERR-CODE (WS-SUM-SUB).
           MOVE SU-DETECT-PGM TO SM-DETECT-PGM (WS-SUM-SUB).
       P2100-EXIT.
           EXIT.
       P2110-SCAN-ENTRY.
           IF SM-ERR-CODE (WS-SUM-SUB) = SU-ERR-CODE
               AND SM-DETECT-PGM (WS-SUM-SUB) = SU-DETECT-PGM
               MOVE 'Y' TO WS-SUM-FOUND-SW
               GO TO P2110-EXIT.
           ADD 1 TO WS-SUM-SUB.
       P2110-EXIT.
           EXIT.
       P2200-UPDATE-SEVERITY.
           MOVE WS-UNS-PARA-NBR TO SM-LAST-PARA-NBR (WS-SUM-SUB).
           MOVE WS-UNS-VERB TO SM-LAST-VERB (WS-SUM-SUB).
           MOVE SU-ERR-SEVERITY TO SM-LAST-SEV (WS-SUM-SUB).
           ADD 1 TO SM-TOTAL-CNT (WS-SUM-SUB).
           IF SU-WARN
               ADD 1 TO SM-WARN-CNT (WS-SUM-SUB)
               GO TO P2200-EXIT.
           IF SU-ERROR
               ADD 1 TO SM-ERROR-CNT (WS-SUM-SUB)
               GO TO P2200-EXIT.
           IF SU-FATAL
               ADD 1 TO SM-FATAL-CNT (WS-SUM-SUB).
       P2200-EXIT.
           EXIT.
      * CABS-STD-020 - UNSTRING TAG INTO PARA NUMBER AND VERB.
       P2300-UNSTRING-DETECT-PARA.
           MOVE SU-DETECT-PARA TO WS-DPS-RAW.
           MOVE SPACES TO WS-UNS-PARA-NBR.
           MOVE SPACES TO WS-UNS-VERB.
           MOVE 1 TO WS-UNS-PTR.
           UNSTRING WS-DPS-RAW DELIMITED BY '-'
               INTO WS-UNS-PARA-NBR WS-UNS-VERB
               WITH POINTER WS-UNS-PTR.
       P2300-EXIT.
           EXIT.
       P3100-READ-SUSIN.
           READ SUSIN
               AT END
                   MOVE 'Y' TO WS-EOF-SW.
           IF WS-FS-INPUT NOT = '00'
               AND WS-FS-INPUT NOT = '10'
               GO TO P9950-SUSPENSE-FAILURE.
       P3100-EXIT.
           EXIT.
      * CABS-STD-018 - SUSOUT CARRIES GROUPS OUT AT TERM TIME (P9100).
       S400-REPORT-AND-AUDIT SECTION.
      * P4000/P4100 PRINT ONE LINE/GROUP, STRING FROM 6 FRAGMENTS - C20.
       P4000-PRINT-REPORT.
           MOVE SPACES TO CABS-PRINT-LINE.
           MOVE '1' TO PC-CC.
           MOVE 'CABS SUSPENSE CONSOLIDATION EXCEPTION REPORT'
               TO PC-TEXT.
           PERFORM P4200-WRITE-RPTOUT THRU P4200-EXIT.
           MOVE 1 TO WS-SUM-SUB.
           PERFORM P4100-BUILD-REPORT-LINE THRU P4100-EXIT
               VARYING WS-SUM-SUB FROM 1 BY 1
               UNTIL WS-SUM-SUB > WS-SUM-COUNT.
       P4000-EXIT.
           EXIT.
       P4100-BUILD-REPORT-LINE.
           IF SM-LAST-SEV (WS-SUM-SUB) = 'W'
               MOVE 'WARNING' TO WS-STR-SEVERITY-WORD.
           IF SM-LAST-SEV (WS-SUM-SUB) = 'E'
               MOVE 'ERROR  ' TO WS-STR-SEVERITY-WORD.
           IF SM-LAST-SEV (WS-SUM-SUB) = 'F'
               MOVE 'FATAL  ' TO WS-STR-SEVERITY-WORD.
           MOVE SM-TOTAL-CNT (WS-SUM-SUB) TO WS-STR-COUNT-DISPLAY.
           MOVE SPACES TO WS-STR-REPORT-LINE.
           MOVE 1 TO WS-STR-PTR.
           STRING WS-RUN-ID-RAW ' ' SM-DETECT-PGM (WS-SUM-SUB) ' '
               SM-LAST-PARA-NBR (WS-SUM-SUB) ' '
               SM-ERR-CODE (WS-SUM-SUB) ' ' WS-STR-SEVERITY-WORD
               ' ' WS-STR-COUNT-DISPLAY DELIMITED BY SIZE
               INTO WS-STR-REPORT-LINE WITH POINTER WS-STR-PTR.
           MOVE SPACES TO CABS-PRINT-LINE.
           MOVE ' ' TO PC-CC.
           MOVE WS-STR-REPORT-LINE TO PC-TEXT.
           PERFORM P4200-WRITE-RPTOUT THRU P4200-EXIT.
       P4100-EXIT.
           EXIT.
       P4200-WRITE-RPTOUT.
           WRITE CABS-PRINT-LINE.
           IF WS-FS-TABLE NOT = '00'
               GO TO P9950-SUSPENSE-FAILURE.
           ADD 1 TO WS-RPT-LINE-CNT.
       P4200-EXIT.
           EXIT.
      * P5000 WRITES THE AUDIT TRAIL - START, SUMMARY, END.  ORDER
      * MATTERS: SEE HEADER NOTE.  2-4 RECORDS PER RUN.
       P5000-AUDIT-LOG.
           MOVE SPACES TO WS-STR-AUDIT-TEXT.
           STRING WS-RUN-ID-RAW ' ' WS-PGM-NAME ' RUN START'
               DELIMITED BY SIZE INTO WS-STR-AUDIT-TEXT.
           PERFORM P5100-WRITE-AUDLOG THRU P5100-EXIT.
           MOVE WS-SUM-COUNT TO WS-STR-GROUPS-DISP.
           MOVE WS-READ-CNT TO WS-STR-READ-DISP.
           MOVE SPACES TO WS-STR-AUDIT-TEXT.
           STRING WS-RUN-ID-RAW ' GROUPS=' WS-STR-GROUPS-DISP
               ' READ=' WS-STR-READ-DISP
               DELIMITED BY SIZE INTO WS-STR-AUDIT-TEXT.
           PERFORM P5100-WRITE-AUDLOG THRU P5100-EXIT.
           MOVE SPACES TO WS-STR-AUDIT-TEXT.
           STRING WS-RUN-ID-RAW ' ' WS-PGM-NAME ' RUN END'
               DELIMITED BY SIZE INTO WS-STR-AUDIT-TEXT.
           PERFORM P5100-WRITE-AUDLOG THRU P5100-EXIT.
       P5000-EXIT.
           EXIT.
       P5100-WRITE-AUDLOG.
           MOVE SPACES TO AUDLOG-RECORD.
           MOVE WS-STR-AUDIT-TEXT TO AUDLOG-RECORD.
           WRITE AUDLOG-RECORD.
           IF WS-FS-SUSPENSE NOT = '00'
               GO TO P9950-SUSPENSE-FAILURE.
           ADD 1 TO WS-AUD-WRITE-CNT.
       P5100-EXIT.
           EXIT.
       S500-CONTROL-AND-TERM SECTION.
      * P8000 BUILDS CABS-CONTROL-RECORD.  NO 1-FOR-1 WRITES OCCUR
      * IN THIS PROGRAM SO CT-WRITTEN STAYS ZERO BY DESIGN.
       P8000-CONTROL.
           MOVE SPACES TO CABS-CONTROL-RECORD.
           MOVE WS-RUN-ID-RAW TO CT-RUN-ID.
           MOVE WS-PROCESS-ID TO CT-PROCESS-ID.
           MOVE 1 TO CT-STEP-SEQ.
           MOVE WS-READ-CNT TO CT-READ.
           MOVE ZERO TO CT-WRITTEN.
           MOVE WS-REJECT-CNT TO CT-REJECTED.
           MOVE WS-SUMM-CNT TO CT-SUMMARISED.
           MOVE ZERO TO CT-CARRIED-FWD.
           MOVE ZERO TO CT-HASH-MINUTES.
           MOVE ZERO TO CT-HASH-AMOUNT.
           MOVE WS-ACC-SEQ-HASH TO CT-HASH-SEQ.
           MOVE ZERO TO CT-HASH-OCN.
           COMPUTE WS-CT-BAL-CHECK = CT-WRITTEN + CT-REJECTED +
               CT-SUMMARISED + CT-CARRIED-FWD.
           IF CT-READ = WS-CT-BAL-CHECK
               SET CT-IN-BALANCE TO TRUE
           ELSE
               SET CT-OUT-OF-BAL TO TRUE.
           MOVE CABS-CONTROL-RECORD TO CTLOUT-RECORD.
           WRITE CTLOUT-RECORD.
       P8000-EXIT.
           EXIT.
       P9000-TERM.
           PERFORM P9100-WRITE-CONSOLIDATED THRU P9100-EXIT
               VARYING WS-SUM-SUB FROM 1 BY 1
               UNTIL WS-SUM-SUB > WS-SUM-COUNT.
           PERFORM P9200-CLOSE-FILES THRU P9200-EXIT.
       P9000-EXIT.
           EXIT.
       P9100-WRITE-CONSOLIDATED.
           MOVE SPACES TO CABS-SUSPENSE-RECORD.
           MOVE SM-ERR-CODE (WS-SUM-SUB) TO SU-ERR-CODE.
           MOVE SM-LAST-SEV (WS-SUM-SUB) TO SU-ERR-SEVERITY.
           MOVE SM-DETECT-PGM (WS-SUM-SUB) TO SU-DETECT-PGM.
           MOVE WS-RUN-ID-RAW TO SU-RUN-ID.
           MOVE CABS-SUSPENSE-RECORD TO SUSOUT-RECORD.
           WRITE SUSOUT-RECORD.
           CALL 'CABHASH' USING SM-TOTAL-CNT (WS-SUM-SUB)
               WS-ACC-SEQ-HASH.
           ADD 1 TO WS-CONSOL-WRITE-CNT.
       P9100-EXIT.
           EXIT.
       P9200-CLOSE-FILES.
           CLOSE SUSIN.
           CLOSE SUSOUT.
           CLOSE RPTOUT.
           CLOSE AUDLOG.
           CLOSE CTLOUT.
       P9200-EXIT.
           EXIT.
      * CABS-STD-003 - PHYSICAL BOTTOM.  REACHED ONLY VIA GO TO FROM
      * P3100, P4200 AND P5100 - WIDELY SEPARATED FROM HERE.
       P9950-SUSPENSE-FAILURE.
           DISPLAY 'CABING07 - FATAL I/O ERROR - RUN TERMINATED'.
           CLOSE SUSIN.
           CLOSE SUSOUT.
           CLOSE RPTOUT.
           CLOSE AUDLOG.
           CLOSE CTLOUT.
           MOVE 'CABING07 SUSPENSE FAILURE' TO WS-ABEND-REASON.
           CALL 'CABABEND' USING CT-ABEND-CD.
           STOP RUN.
