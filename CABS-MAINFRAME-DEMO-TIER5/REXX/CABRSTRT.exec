/* REXX */
/*********************************************************************/
/* CABRSTRT - RESTART A CABS/SETL JOB FROM ITS LAST CONTROL RECORD   */
/* APPLICATION : CABS | SETL                                        */
/* INPUTS      : ARG1 = RUN ID, ARG2 = JCL MEMBER TO RESUBMIT        */
/*             : TELCABS.CABS.CONTROL(0) / TELCABS.SETL.RUNCTL(0)    */
/* OUTPUTS     : RESUBMITTED JOB WITH A RESTART= PARAMETER APPENDED  */
/* CONTROL     : NONE - READS CONTROL RECORDS, DOES NOT WRITE ONE    */
/* RESTART     : THIS EXEC IS ITSELF THE RESTART MECHANISM           */
/*                                                                    */
/* READS THE LAST CABSCTL RECORD WRITTEN FOR A RUN ID, TAKES         */
/* CT-RESTART-KEY FROM IT, AND MAPS THE STEPNAME EMBEDDED IN THAT    */
/* KEY TO A STEP SEQUENCE NUMBER USING THE TABLE BELOW SO THE        */
/* GENERATED RESTART= PARAMETER NAMES THE RIGHT STEP IN JES SYNTAX.  */
/* THE STEPNAME-TO-SEQUENCE TABLE IS MAINTAINED BY HAND - IT IS NOT  */
/* DERIVED FROM THE JCL LIBRARY.  A NEW STEP ADDED TO ANY OF THE     */
/* JOBS LISTED BELOW MUST BE ADDED HERE TOO OR CABRSTRT WILL BUILD   */
/* A RESTART PARAMETER FOR THE WRONG STEP.  SEE CABS-STD-080.        */
/*                                                                    */
/* REVISION HISTORY                                                  */
/*   V1.00  1998-09-11  P.NAIR        INITIAL - CABS3100 ONLY        */
/*   V1.02  2001-02-14  P.NAIR        SETL JOBS ADDED TO THE TABLE   */
/*   V1.04  2006-07-05  R.OKONKWO     CABRAT03 SPLIT ADDED THREE NEW */
/*                                    STEPS - TABLE UPDATED           */
/*   V1.06  2015-10-19  A.BUKOWSKI    CABING09 CONSOLIDATION STEP    */
/*                                    RENUMBERED IN THE TABLE AFTER  */
/*                                    THE JCL WAS RESEQUENCED         */
/*********************************************************************/

PARSE ARG RUNID JCLMEM .

IF RUNID = '' | JCLMEM = '' THEN DO
  SAY 'CABRSTRT - USAGE: EX CABRSTRT RUNID JCLMEMBER'
  EXIT 16
END

/*-------------------------------------------------------------------*/
/* STEPNAME TO SEQUENCE TABLE - MAINTAINED BY HAND, NOT DERIVED FROM */
/* THE JCL LIBRARY.  KEYED ON JOBNAME.STEPNAME.                      */
/*-------------------------------------------------------------------*/
SEQ.'CABS3100.STEP010' = 10
SEQ.'CABING01.STEP010' = 10
SEQ.'CABING01.STEP020' = 20
SEQ.'CABING02.STEP010' = 10
SEQ.'CABRAT02.STEP010' = 10
SEQ.'CABRAT02.STEP020' = 20
SEQ.'CABRAT03.STEP010' = 10
SEQ.'CABRAT03.STEP015' = 15
SEQ.'CABRAT03.STEP020' = 20
SEQ.'CABRAT03.STEP030' = 30
SEQ.'CABING09.STEP010' = 10
SEQ.'CABING09.STEP015' = 15
SEQ.'CABING09.STEP020' = 20
SEQ.'CABSET12.DB2STEP'  = 10
SEQ.'CABSET13.DB2STEP'  = 10
SEQ.'CABJUR10.DB2STEP'  = 10

/*-------------------------------------------------------------------*/
/* FIND THE CONTROL DATASET - CABS RUN IDS START 'CB', SETL RUN IDS  */
/* START 'ST', BY ESTATE CONVENTION.                                 */
/*-------------------------------------------------------------------*/
IF SUBSTR(RUNID,1,2) = 'ST' THEN
  CTLDS = "'TELCABS.SETL.RUNCTL(0)'"
ELSE
  CTLDS = "'TELCABS.CABS.CONTROL(0)'"

ADDRESS TSO
"ALLOC F(CTLIN) DA("CTLDS") SHR REUSE"
IF RC <> 0 THEN DO
  SAY 'CABRSTRT - ALLOC FAILED ON' CTLDS 'RC='RC
  EXIT RC
END
"EXECIO * DISKR CTLIN (STEM CTL. FINIS)"
"FREE F(CTLIN)"

/*-------------------------------------------------------------------*/
/* FIND THE LAST RECORD FOR THIS RUN ID.  RUN ID IS BYTES 1-12.      */
/*-------------------------------------------------------------------*/
FOUND = 'N'
DO I = CTL.0 TO 1 BY -1
  IF STRIP(SUBSTR(CTL.I,1,12)) = RUNID THEN DO
    LASTREC = CTL.I
    FOUND = 'Y'
    LEAVE
  END
END

IF FOUND = 'N' THEN DO
  SAY 'CABRSTRT - NO CONTROL RECORD FOUND FOR RUN ID' RUNID
  EXIT 8
END

JOBNM  = STRIP(SUBSTR(LASTREC,37,8))
BALIND = SUBSTR(LASTREC,119,1)
RCFLD  = STRIP(SUBSTR(LASTREC,120,4))
ABNDCD = STRIP(SUBSTR(LASTREC,124,4))
RSTKEY = STRIP(SUBSTR(LASTREC,128,26))

SAY 'CABRSTRT - LAST CONTROL RECORD FOR' RUNID
SAY '  JOBNAME       :' JOBNM
SAY '  BALANCE IND   :' BALIND
SAY '  RETURN CODE   :' RCFLD
SAY '  ABEND CODE    :' ABNDCD
SAY '  RESTART KEY   :' RSTKEY

IF ABNDCD = '' | ABNDCD = '0000' THEN DO
  SAY 'CABRSTRT - LAST RECORD SHOWS NO ABEND - CONFIRM A RESTART IS',
      'ACTUALLY NEEDED BEFORE PROCEEDING'
END

/*-------------------------------------------------------------------*/
/* CT-RESTART-KEY IS FREE FORM TEXT WRITTEN BY THE FAILING PROGRAM.  */
/* CONVENTION IS "stepname/paragraph", E.G. "STEP020/P4000-CLOSE-".  */
/* PULL THE STEPNAME PORTION UP TO THE SLASH.                        */
/*-------------------------------------------------------------------*/
SLASHPOS = POS('/',RSTKEY)
IF SLASHPOS = 0 THEN
  RSTSTEP = RSTKEY
ELSE
  RSTSTEP = LEFT(RSTKEY,SLASHPOS - 1)

LOOKUP = JOBNM'.'RSTSTEP
IF SYMBOL('SEQ.LOOKUP') \= 'VAR' THEN DO
  SAY 'CABRSTRT - STEP' RSTSTEP 'FOR JOB' JOBNM 'IS NOT IN THE',
      'STEPNAME/SEQUENCE TABLE - ADD IT TO CABRSTRT BEFORE RESTARTING'
  EXIT 12
END

STEPSEQ = SEQ.LOOKUP
RESTPARM = 'RESTART=('RSTSTEP')'

SAY 'CABRSTRT - RESTARTING AT STEP' RSTSTEP '(SEQUENCE' STEPSEQ')'

/*-------------------------------------------------------------------*/
/* READ THE JCL MEMBER, INSERT THE RESTART PARAMETER ON THE JOB      */
/* CARD, AND SUBMIT.  THE JOB CARD IS ASSUMED TO BE THE FIRST LINE   */
/* THAT DOES NOT CONTINUE ONTO THE NEXT ONE.                         */
/*-------------------------------------------------------------------*/
JCLDS = "'TELCABS.CABS.JCLLIB("JCLMEM")'"
"ALLOC F(JCLIN) DA("JCLDS") SHR REUSE"
IF RC <> 0 THEN DO
  SAY 'CABRSTRT - ALLOC FAILED ON' JCLDS 'RC='RC
  EXIT RC
END
"EXECIO * DISKR JCLIN (STEM SRC. FINIS)"
"FREE F(JCLIN)"

JCARDLEN = LENGTH(STRIP(SRC.1,'T'))
SRC.1 = SRC.1','
SRC.1 = SRC.1 || RESTPARM

TEMPDS = "'TELCABS.OPS."USERID()".RESTART.TEMP'"
"ALLOC F(RSTOUT) DA("TEMPDS") NEW REUSE SPACE(1,1) TRACKS",
     "LRECL(80) RECFM(F,B) DSORG(PS)"
"EXECIO" SRC.0 "DISKW RSTOUT (STEM SRC. FINIS)"
"FREE F(RSTOUT)"

X = OUTTRAP('SUBOUT.')
"SUBMIT" TEMPDS
X = OUTTRAP('OFF')
DO I = 1 TO SUBOUT.0
  SAY SUBOUT.I
END
"DELETE" TEMPDS

SAY 'CABRSTRT - RESUBMITTED' JCLMEM 'FOR RUN' RUNID 'WITH' RESTPARM
EXIT 0
